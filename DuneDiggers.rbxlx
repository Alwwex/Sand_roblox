	<Item class="ServerScriptService" referent="RBX00000017">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Folder" referent="RBX00000016">
			<Properties>
				<string name="Name">Server</string>
			</Properties>
			<Item class="Script" referent="RBX00000008">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DUNE DIGGERS – hlavní serverový skript
	Spouští všechny služby ve správném pořadí.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
require(ReplicatedStorage.Shared.Remotes) -- vytvoří RemoteEventy

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local WorldService = require(Services.WorldService)
local TreasureService = require(Services.TreasureService)
local ShopService = require(Services.ShopService)
local DigService = require(Services.DigService)
local MonetizationService = require(Services.MonetizationService)
local SandstormService = require(Services.SandstormService)
local RewardService = require(Services.RewardService)
local LeaderboardService = require(Services.LeaderboardService)

-- Postavy spawnujeme až když je svět hotový
Players.CharacterAutoLoads = false

DataService.init()
MonetizationService.init()

print("[Dune Diggers] Generuji poušť...")
local started = os.clock()
WorldService.init()
TreasureService.init()
TreasureService.populate()
ShopService.init()
DigService.init()
RewardService.init()
LeaderboardService.init()
WorldService.setReady(true)
SandstormService.start()
print(("[Dune Diggers] Svět hotový za %.1f s"):format(os.clock() - started))

---------------------------------------------------------------------
-- Hráči
---------------------------------------------------------------------

local function spawnCharacter(player: Player)
	if player.Parent and DataService.get(player) then
		player:LoadCharacter()
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	-- CharacterAdded přijde dřív, než je postava ve Workspace – počkáme
	if not character:IsDescendantOf(workspace) then
		character.AncestryChanged:Wait()
	end
	player:WaitForChild("Backpack", 10)
	task.wait()
	if player.Character ~= character then
		return
	end
	ShopService.giveTool(player)

	-- VIP: zlaté jméno nad hlavou
	if player:GetAttribute("VIP") then
		humanoid.DisplayName = "👑 " .. player.DisplayName
	end

	humanoid.Died:Connect(function()
		task.delay(Config.RespawnTime, function()
			if player.Character == character then
				spawnCharacter(player)
			end
		end)
	end)
end

local function onPlayerAdded(player: Player)
	-- kamera nesmí zajet do písku ani daleko pryč
	player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Zoom
	player.CameraMaxZoomDistance = Config.Camera.MaxZoom
	player.CameraMinZoomDistance = Config.Camera.MinZoom

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	local session = DataService.loadPlayer(player)
	if not session then
		return
	end
	MonetizationService.loadPasses(player)
	DataService.syncNow(player)

	while not WorldService.isReady() and player.Parent do
		task.wait(0.5)
	end
	spawnCharacter(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX00000015">
				<Properties>
					<string name="Name">Services</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000009">
					<Properties>
						<string name="Name">Build</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Build – pomocné funkce pro stavění mapy z Partů (používá WorldService a LobbyBuilder).
]]

local Build = {}

local DARK = Color3.fromRGB(60, 35, 15)

function Build.part(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

-- Svislý válec (Roblox válce mají osu X, proto otočení)
function Build.cylinder(props): Part
	local height = props.Height
	local diameter = props.Diameter
	local position = props.Position
	props.Height = nil
	props.Diameter = nil
	props.Position = nil
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	return Build.part(props)
end

-- Koule / elipsoid (SpecialMesh Sphere se natáhne podle velikosti partu)
function Build.ellipsoid(props): Part
	local part = Build.part(props)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

function Build.wedge(props): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Anchored = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			(wedge :: any)[key] = value
		end
	end
	wedge.Parent = props.Parent
	return wedge
end

function Build.model(name: string, parent: Instance?): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Build.stroke(parent: Instance, thickness: number, color: Color3?)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = thickness
	stroke.Color = color or DARK
	stroke.Parent = parent
	return stroke
end

-- Nápis nad objektem (velikost ve studs)
function Build.billboard(
	part: BasePart,
	text: string,
	color: Color3,
	studsSize: Vector2,
	offset: number,
	font: Enum.Font?
)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Size = UDim2.fromScale(studsSize.X, studsSize.Y)
	billboard.StudsOffset = Vector3.new(0, offset, 0)
	billboard.MaxDistance = 220
	billboard.LightInfluence = 0
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = font or Enum.Font.LuckiestGuy
	label.TextColor3 = color
	label.Parent = billboard
	Build.stroke(label, 3)
	return billboard, label
end

-- Cedule s nápisem na obou stranách (SurfaceGui)
function Build.sign(part: BasePart, text: string, color: Color3, faces: { Enum.NormalId }?, canvas: Vector2?)
	for _, face in faces or { Enum.NormalId.Front, Enum.NormalId.Back } do
		local surface = Instance.new("SurfaceGui")
		surface.Face = face
		surface.CanvasSize = canvas or Vector2.new(600, 180)
		surface.LightInfluence = 0
		surface.Parent = part
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextScaled = true
		label.Font = Enum.Font.LuckiestGuy
		label.TextColor3 = color
		label.Parent = surface
		Build.stroke(label, 4)
	end
end

function Build.light(parent: Instance, color: Color3, range: number, brightness: number?)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness or 1
	light.Parent = parent
	return light
end

function Build.sparkles(parent: Instance, color: Color3, rate: number?)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.Rate = rate or 6
	emitter.Lifetime = NumberRange.new(1, 1.6)
	emitter.Speed = NumberRange.new(1.5, 3.5)
	emitter.Size = NumberSequence.new(0.5)
	emitter.LightEmission = 1
	emitter.Parent = parent
	return emitter
end

-- Palma
function Build.palm(parent: Instance, base: Vector3, lean: number, height: number?)
	local palm = Build.model("Palm", parent)
	local trunkColor = Color3.fromRGB(140, 98, 60)
	local position = base
	local direction = Vector3.new(lean, 1, lean * 0.4).Unit
	local segments = height or 6
	for i = 1, segments do
		local segment = 2.6
		local center = position + direction * segment / 2
		Build.part({
			Name = "Trunk",
			Size = Vector3.new(1.4 - i * 0.07, segment + 0.3, 1.4 - i * 0.07),
			CFrame = CFrame.lookAt(center, center + direction) * CFrame.Angles(math.rad(90), 0, 0),
			Material = Enum.Material.Wood,
			Color = trunkColor:Lerp(Color3.fromRGB(105, 70, 40), (i % 2) * 0.5),
			CanCollide = i <= 2,
			Parent = palm,
		})
		position += direction * segment
		direction = (direction + Vector3.new(lean * 0.12, 0, 0)).Unit
	end
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		local leafDir = Vector3.new(math.cos(angle), -0.3, math.sin(angle)).Unit
		local center = position + leafDir * 3.2
		Build.part({
			Name = "Leaf",
			Size = Vector3.new(1.8, 0.2, 7),
			CFrame = CFrame.lookAt(center, center + leafDir),
			Material = Enum.Material.Grass,
			Color = Color3.fromRGB(62, 150, 58):Lerp(Color3.fromRGB(120, 185, 70), (i % 3) / 3),
			CanCollide = false,
			Parent = palm,
		})
	end
	for i = 1, 3 do
		Build.ellipsoid({
			Name = "Coconut",
			Size = Vector3.new(0.9, 0.9, 0.9),
			Position = position + Vector3.new(math.cos(i * 2.1) * 0.7, -0.6, math.sin(i * 2.1) * 0.7),
			Color = Color3.fromRGB(110, 75, 40),
			CanCollide = false,
			Parent = palm,
		})
	end
	return palm
end

-- Kostičková postavička (NPC obchodník / socha)
function Build.npc(parent: Instance, cframe: CFrame, colors, name: string?): Model
	local npc = Build.model(name or "NPC", parent)
	local c = colors or {}
	local skin = c.Skin or Color3.fromRGB(247, 197, 142)
	local shirt = c.Shirt or Color3.fromRGB(230, 210, 170)
	local pants = c.Pants or Color3.fromRGB(110, 74, 44)
	local hat = c.Hat or Color3.fromRGB(255, 122, 26)
	local material = c.Material or Enum.Material.SmoothPlastic

	local function piece(pieceName, size, offset, color, shape)
		local props = {
			Name = pieceName,
			Size = size,
			CFrame = cframe * offset,
			Color = color,
			Material = material,
			CanCollide = false,
			Parent = npc,
		}
		if shape == "ball" then
			return Build.ellipsoid(props)
		end
		return Build.part(props)
	end

	piece("LeftLeg", Vector3.new(1, 2, 1), CFrame.new(-0.5, 1, 0), pants)
	piece("RightLeg", Vector3.new(1, 2, 1), CFrame.new(0.5, 1, 0), pants)
	local torso = piece("Torso", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), shirt)
	torso.CanCollide = true
	piece("Belt", Vector3.new(2.05, 0.3, 1.05), CFrame.new(0, 2.15, 0), Color3.fromRGB(80, 50, 22))
	piece("LeftArm", Vector3.new(1, 2, 1), CFrame.new(-1.5, 3, 0), shirt)
	piece("RightArm", Vector3.new(1, 2, 1), CFrame.new(1.5, 3, -0.3) * CFrame.Angles(math.rad(25), 0, 0), shirt)
	piece("LeftHand", Vector3.new(0.9, 0.5, 0.9), CFrame.new(-1.5, 1.85, 0), skin)
	local head = piece("Head", Vector3.new(1.3, 1.25, 1.25), CFrame.new(0, 4.65, 0), skin)
	-- obličej
	for _, x in { -0.28, 0.28 } do
		piece("Eye", Vector3.new(0.2, 0.3, 0.05), CFrame.new(x, 4.75, -0.64), Color3.fromRGB(30, 20, 15))
	end
	piece("Smile", Vector3.new(0.5, 0.08, 0.05), CFrame.new(0, 4.4, -0.64), Color3.fromRGB(60, 25, 15))
	-- klobouk
	Build.cylinder({
		Name = "HatBrim",
		Height = 0.15,
		Diameter = 2.2,
		Position = (cframe * CFrame.new(0, 5.3, 0)).Position,
		Color = hat,
		Material = material,
		CanCollide = false,
		Parent = npc,
	})
	piece("HatTop", Vector3.new(1.4, 0.7, 1.4), CFrame.new(0, 5.65, 0), hat, "ball")
	if c.Beard then
		piece("Beard", Vector3.new(1.1, 0.6, 0.3), CFrame.new(0, 4.15, -0.62), c.Beard)
	end
	npc.PrimaryPart = torso
	if name then
		Build.billboard(head, name, Color3.fromRGB(255, 236, 170), Vector2.new(8, 1.6), 2.2, Enum.Font.FredokaOne)
	end
	return npc
end

-- Bedna / sud / dekorace
function Build.crate(parent: Instance, position: Vector3, size: number?, rotation: number?)
	local s = size or 3
	local crate = Build.part({
		Name = "Crate",
		Size = Vector3.new(s, s, s),
		CFrame = CFrame.new(position + Vector3.new(0, s / 2, 0)) * CFrame.Angles(0, rotation or 0, 0),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(176, 124, 70),
		Parent = parent,
	})
	return crate
end

function Build.barrel(parent: Instance, position: Vector3)
	local barrel = Build.cylinder({
		Name = "Barrel",
		Height = 3.2,
		Diameter = 2.4,
		Position = position + Vector3.new(0, 1.6, 0),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(130, 85, 45),
		Parent = parent,
	})
	for _, y in { 0.7, 2.5 } do
		Build.cylinder({
			Name = "Hoop",
			Height = 0.25,
			Diameter = 2.5,
			Position = position + Vector3.new(0, y, 0),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(70, 70, 75),
			CanCollide = false,
			Parent = parent,
		})
	end
	return barrel
end

function Build.pot(parent: Instance, position: Vector3, color: Color3?)
	Build.ellipsoid({
		Name = "Pot",
		Size = Vector3.new(2.2, 2.6, 2.2),
		Position = position + Vector3.new(0, 1.3, 0),
		Material = Enum.Material.Slate,
		Color = color or Color3.fromRGB(196, 108, 62),
		Parent = parent,
	})
	Build.cylinder({
		Name = "PotNeck",
		Height = 0.6,
		Diameter = 1.2,
		Position = position + Vector3.new(0, 2.75, 0),
		Material = Enum.Material.Slate,
		Color = (color or Color3.fromRGB(196, 108, 62)):Lerp(Color3.new(0, 0, 0), 0.15),
		Parent = parent,
	})
end

function Build.lantern(parent: Instance, position: Vector3, color: Color3?)
	Build.cylinder({
		Name = "LanternPost",
		Height = 7,
		Diameter = 0.5,
		Position = position + Vector3.new(0, 3.5, 0),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(60, 45, 35),
		Parent = parent,
	})
	local lamp = Build.part({
		Name = "Lamp",
		Size = Vector3.new(1.1, 1.4, 1.1),
		Position = position + Vector3.new(0, 7.4, 0),
		Material = Enum.Material.Neon,
		Color = color or Color3.fromRGB(255, 176, 80),
		CanCollide = false,
		Parent = parent,
	})
	Build.part({
		Name = "LampCap",
		Size = Vector3.new(1.5, 0.3, 1.5),
		Position = position + Vector3.new(0, 8.25, 0),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(60, 45, 35),
		CanCollide = false,
		Parent = parent,
	})
	Build.light(lamp, color or Color3.fromRGB(255, 176, 80), 16, 1.3)
	return lamp
end

function Build.banner(parent: Instance, position: Vector3, color: Color3, facing: Vector3)
	Build.cylinder({
		Name = "BannerPole",
		Height = 12,
		Diameter = 0.45,
		Position = position + Vector3.new(0, 6, 0),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(110, 72, 40),
		Parent = parent,
	})
	local center = position + Vector3.new(0, 9, 0) + facing.Unit * 0.3
	Build.part({
		Name = "Banner",
		Size = Vector3.new(2.6, 5, 0.15),
		CFrame = CFrame.lookAt(center, center + facing),
		Material = Enum.Material.Fabric,
		Color = color,
		CanCollide = false,
		Parent = parent,
	})
	Build.part({
		Name = "BannerStripe",
		Size = Vector3.new(2.7, 0.5, 0.2),
		CFrame = CFrame.lookAt(center + Vector3.new(0, -1.6, 0), center + Vector3.new(0, -1.6, 0) + facing),
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(255, 205, 60),
		CanCollide = false,
		Parent = parent,
	})
end

-- Koberec se vzorem
function Build.carpet(parent: Instance, center: Vector3, size: Vector2, color: Color3, rotation: number?)
	local base = CFrame.new(center + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, rotation or 0, 0)
	Build.part({
		Name = "Carpet",
		Size = Vector3.new(size.X, 0.15, size.Y),
		CFrame = base,
		Material = Enum.Material.Fabric,
		Color = color,
		CanCollide = false,
		Parent = parent,
	})
	Build.part({
		Name = "CarpetBorder",
		Size = Vector3.new(size.X - 1.2, 0.17, size.Y - 1.2),
		CFrame = base,
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(255, 205, 90),
		CanCollide = false,
		Parent = parent,
	})
	Build.part({
		Name = "CarpetInner",
		Size = Vector3.new(size.X - 2, 0.19, size.Y - 2),
		CFrame = base,
		Material = Enum.Material.Fabric,
		Color = color:Lerp(Color3.new(0, 0, 0), 0.15),
		CanCollide = false,
		Parent = parent,
	})
end

return Build
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000A">
					<Properties>
						<string name="Name">DataService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DataService – ukládání hráčských dat (DataStore) + posílání dat klientovi.

	- Načítá data s jednoduchým "zámkem" (aby se data nepřepsala, když hráč
	  rychle přejde na jiný server).
	- Automaticky ukládá každou minutu, při odchodu hráče a při vypnutí serveru.
	- Ve Studiu bez zapnutého "Studio Access to API Services" hra funguje,
	  jen se nic neukládá (v Output uvidíš varování).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Stats = require(script.Parent.Stats)

local STORE_NAME = "DuneDiggers_PlayerData_v1"
local AUTOSAVE_INTERVAL = 60
local LOCK_TIMEOUT = 150 -- po kolika sekundách se "zámek" z jiného serveru považuje za mrtvý
local SYNC_INTERVAL = 0.1

local DataService = {}

local sessions = {} -- [Player] = session
local saveHooks = {} -- funkce volané po uložení (např. žebříčky)
local store = nil

local IS_STUDIO = RunService:IsStudio()

local function defaultData()
	return {
		Coins = Config.Economy.StartingCoins,
		Sand = 0,
		TotalSand = 0,
		Rebirths = 0,
		OwnedTools = { Hands = true },
		EquippedTool = "Hands",
		OwnedBackpacks = { Pocket = true },
		EquippedBackpack = "Pocket",
		Artifacts = {},
		Codes = {},
		Receipts = {},
		ChestsOpened = 0,
		TotalCoins = 0, -- mince vydělané za celou dobu (žebříček)
		LastDaily = 0,
		LastVipChest = 0,
		Settings = { Music = 0.5, Sfx = 0.8, LowGfx = false, Popups = true },
		FirstJoin = os.time(),
	}
end

-- Doplní chybějící klíče (když přidáš do hry nové věci, staré uložené hry je dostanou)
local function reconcile(data, template)
	for key, value in template do
		if data[key] == nil then
			if type(value) == "table" then
				data[key] = table.clone(value)
			else
				data[key] = value
			end
		end
	end
	return data
end

local function dataKey(player: Player): string
	return "Player_" .. player.UserId
end

local function getStore()
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	return store
end

local function createLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats

	leaderstats.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local coins = leaderstats:FindFirstChild("Coins")
	local rebirths = leaderstats:FindFirstChild("Rebirths")
	if coins then
		coins.Value = math.min(data.Coins, 2 ^ 53)
	end
	if rebirths then
		rebirths.Value = data.Rebirths
	end
end

-- Načte data s retry a zámkem. Vrací (ok, data, canSave)
local function loadFromStore(player: Player)
	local dataStore = getStore()
	if not dataStore then
		return false, nil
	end

	local key = dataKey(player)
	for attempt = 1, 8 do
		local lockedByOther = false
		local loaded = nil
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(old)
				if old and old.Lock and old.Lock.JobId ~= game.JobId and os.time() - old.Lock.Time < LOCK_TIMEOUT then
					lockedByOther = true
					return nil -- zrušit zápis
				end
				local data = old or defaultData()
				data.Lock = { JobId = game.JobId, Time = os.time() }
				loaded = data
				return data
			end)
		end)

		if ok and loaded then
			return true, loaded
		elseif ok and lockedByOther then
			warn(("[DataService] Data hráče %s jsou otevřená na jiném serveru, čekám..."):format(player.Name))
			if attempt >= 6 then
				-- Starý server se asi zasekl – převezmeme data
				local forced = nil
				local forceOk = pcall(function()
					dataStore:UpdateAsync(key, function(old)
						local data = old or defaultData()
						data.Lock = { JobId = game.JobId, Time = os.time() }
						forced = data
						return data
					end)
				end)
				if forceOk and forced then
					return true, forced
				end
			end
			task.wait(5)
		else
			warn("[DataService] Načtení dat selhalo:", err)
			if IS_STUDIO then
				-- Ve Studiu nečekáme – nejspíš není zapnutý přístup k API
				return false, nil
			end
			task.wait(2 * attempt)
		end

		if not player.Parent then
			return false, nil
		end
	end
	return false, nil
end

local function saveToStore(player: Player, session, releaseLock: boolean): boolean
	if not session.CanSave then
		return true
	end
	local dataStore = getStore()
	if not dataStore then
		return false
	end

	local data = session.Data
	if releaseLock then
		data.Lock = nil
	else
		data.Lock = { JobId = game.JobId, Time = os.time() }
	end

	local key = dataKey(player)
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(old)
				-- Pokud mezitím data převzal jiný server, nepřepisujeme je
				if old and old.Lock and old.Lock.JobId ~= game.JobId and os.time() - old.Lock.Time < LOCK_TIMEOUT then
					return nil
				end
				return data
			end)
		end)
		if ok then
			for _, hook in saveHooks do
				task.spawn(hook, player, data)
			end
			return true
		end
		warn("[DataService] Uložení selhalo:", err)
		task.wait(attempt)
	end
	return false
end

---------------------------------------------------------------------
-- Veřejné API
---------------------------------------------------------------------

function DataService.get(player: Player)
	return sessions[player]
end

-- Všechny načtené session (např. pro žebříček ve Studiu)
function DataService.getAll()
	return sessions
end

-- Počká, dokud se hráči nenačtou data (max timeout sekund)
function DataService.waitFor(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 30)
	while not sessions[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return sessions[player]
end

function DataService.markDirty(player: Player)
	local session = sessions[player]
	if session then
		session.Dirty = true
	end
end

function DataService.buildPayload(session)
	local data = session.Data
	return {
		Coins = data.Coins,
		Sand = data.Sand,
		TotalSand = data.TotalSand,
		Capacity = Stats.capacity(session),
		Rebirths = data.Rebirths,
		RebirthCost = Stats.rebirthCost(data),
		CoinMultiplier = Stats.coinMultiplier(session),
		DigSpeed = Stats.digSpeed(session),
		OwnedTools = data.OwnedTools,
		EquippedTool = data.EquippedTool,
		OwnedBackpacks = data.OwnedBackpacks,
		EquippedBackpack = data.EquippedBackpack,
		Artifacts = data.Artifacts,
		ArtifactBonus = Stats.artifactBonus(data),
		Passes = session.Passes,
		InGroup = session.InGroup,
		ChestsOpened = data.ChestsOpened,
		TotalCoins = data.TotalCoins,
		Settings = data.Settings,
		LastDaily = data.LastDaily,
		LastVipChest = data.LastVipChest,
		DailyCooldown = Config.Daily.CooldownHours * 3600,
		ServerTime = os.time(),
	}
end

-- Přidá mince a započítá je do celkového výdělku (žebříček)
function DataService.addCoins(player: Player, amount: number)
	local session = sessions[player]
	if not session or amount <= 0 then
		return
	end
	amount = math.floor(amount)
	session.Data.Coins += amount
	session.Data.TotalCoins += amount
	session.Dirty = true
end

-- Registrace funkce, která se zavolá po každém uložení dat hráče
function DataService.onSaved(callback)
	table.insert(saveHooks, callback)
end

function DataService.syncNow(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	session.Dirty = false
	updateLeaderstats(player, session.Data)
	Remotes.DataSync:FireClient(player, DataService.buildPayload(session))
end

-- Okamžité uložení (používá se po nákupu za Robux)
function DataService.saveNow(player: Player): boolean
	local session = sessions[player]
	if not session then
		return false
	end
	return saveToStore(player, session, false)
end

function DataService.notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function DataService.notifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

-- Načte hráče. Vrací session nebo nil (když se data nepodařilo načíst)
function DataService.loadPlayer(player: Player)
	local ok, data = loadFromStore(player)
	local canSave = ok

	if not ok then
		if IS_STUDIO then
			warn(
				"[DataService] Data se ve Studiu NEUKLÁDAJÍ. Zapni: Game Settings > Security > "
					.. "Enable Studio Access to API Services (hra musí být publikovaná)."
			)
			data = defaultData()
		else
			if player.Parent then
				player:Kick("Could not load your data. Please rejoin in a moment!")
			end
			return nil
		end
	end

	if not player.Parent then
		-- hráč mezitím odešel – uvolníme zámek
		if canSave then
			saveToStore(player, { Data = data, CanSave = true }, true)
		end
		return nil
	end

	reconcile(data, defaultData())
	reconcile(data.Settings, defaultData().Settings)

	if IS_STUDIO and Config.Testing.StudioStartCoins > 0 and data.Coins < Config.Testing.StudioStartCoins then
		data.Coins = Config.Testing.StudioStartCoins
	end

	local session = {
		Data = data,
		Passes = {},
		InGroup = false,
		CanSave = canSave,
		Dirty = true,
		LastDig = 0,
		LastSellTouch = 0,
		LastCampTeleport = 0,
		LastFullNotice = 0,
	}

	if Config.Group.Id and Config.Group.Id > 0 then
		local groupOk, inGroup = pcall(function()
			return player:IsInGroup(Config.Group.Id)
		end)
		session.InGroup = groupOk and inGroup == true
	end

	createLeaderstats(player)
	sessions[player] = session
	return session
end

function DataService.releasePlayer(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	saveToStore(player, session, true)
	sessions[player] = nil
end

function DataService.init()
	getStore()

	-- Synchronizace dat ke klientům (max 10x za sekundu)
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < SYNC_INTERVAL then
			return
		end
		accumulator = 0
		for player, session in sessions do
			if session.Dirty then
				DataService.syncNow(player)
			end
		end
	end)

	-- Autosave
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player, session in sessions do
				task.spawn(saveToStore, player, session, false)
			end
		end
	end)

	Remotes.SaveSettings.OnServerEvent:Connect(function(player, settings)
		local session = sessions[player]
		if not session or type(settings) ~= "table" then
			return
		end
		local current = session.Data.Settings
		for key, value in settings do
			if current[key] ~= nil and type(value) == type(current[key]) then
				if type(value) == "number" then
					value = math.clamp(value, 0, 1)
				end
				current[key] = value
			end
		end
	end)

	Remotes.GetData.OnServerInvoke = function(player)
		local session = sessions[player]
		if not session then
			return nil
		end
		return DataService.buildPayload(session)
	end

	-- Uložení všech při vypnutí serveru
	game:BindToClose(function()
		local pending = 0
		for player, session in sessions do
			pending += 1
			task.spawn(function()
				saveToStore(player, session, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		DataService.releasePlayer(player)
	end)
end

return DataService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000B">
					<Properties>
						<string name="Name">DigService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DigService – kopání. Klient pošle "kde chci kopat", server vše ověří
	(vzdálenost, cooldown, nástroj v ruce, místo v batohu) a teprve pak kope.
	Díky tomu se kopání nedá jednoduše hacknout.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local Stats = require(script.Parent.Stats)
local TreasureService = require(script.Parent.TreasureService)
local WorldService = require(script.Parent.WorldService)

local DigService = {}

local function isFiniteVector(v: Vector3): boolean
	for _, n in { v.X, v.Y, v.Z } do
		if n ~= n or n == math.huge or n == -math.huge then
			return false
		end
	end
	return true
end

local function handleDig(player: Player, target)
	if typeof(target) ~= "Vector3" or not isFiniteVector(target) then
		return
	end
	if not WorldService.isReady() then
		return
	end
	local session = DataService.get(player)
	if not session then
		return
	end
	local data = session.Data

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	-- Hráč musí držet svůj nástroj
	local held = character:FindFirstChildOfClass("Tool")
	if not held or held:GetAttribute("DigToolId") ~= data.EquippedTool then
		return
	end
	local tool = Config.ToolsById[data.EquippedTool]
	if not tool then
		return
	end

	-- Cooldown (s malou tolerancí na lag)
	local now = os.clock()
	local cooldown = tool.Cooldown / Stats.digSpeed(session)
	if now - session.LastDig < cooldown * 0.8 then
		return
	end

	-- Dosah
	if
		(target - root.Position).Magnitude > tool.Reach + 8
		or not WorldService.inBounds(target)
		or WorldService.isInLobby(target) -- v lobby se nekope (voda, dlažba)
	then
		return
	end

	-- Plný batoh
	local capacity = Stats.capacity(session)
	if data.Sand >= capacity then
		if session.Passes.AutoSell then
			ShopService.sell(player, true)
		else
			if now - session.LastFullNotice > 4 then
				session.LastFullNotice = now
				DataService.notify(player, "Your bag is full! Sell your sand at the camp 💰", "full")
			end
			return
		end
	end

	session.LastDig = now
	local removed = WorldService.digSphere(target, tool.Radius)
	if removed <= 0 then
		return
	end

	local amount = math.max(1, math.floor(removed + 0.5))
	local gained = math.min(amount, capacity - data.Sand)
	data.Sand += gained
	data.TotalSand += gained
	DataService.markDirty(player)
	Remotes.DigResult:FireClient(player, gained, target, data.Sand >= capacity)

	TreasureService.onDig(player, target, tool.Radius)

	if session.Passes.AutoSell and data.Sand >= capacity then
		ShopService.sell(player, true)
	end
end

function DigService.init()
	Remotes.Dig.OnServerEvent:Connect(handleDig)
end

return DigService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000C">
					<Properties>
						<string name="Name">LeaderboardService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	LeaderboardService – globální žebříčky (přes všechny servery).

	- Ukládá do OrderedDataStore: celkové mince, vykopaný písek, rebirthy.
	- Každých Config.Leaderboard.RefreshSeconds obnoví tabule v lobby
	  a pošle data do UI (ReplicatedStorage > LeaderboardData, JSON).
	- Nejbohatší hráč dostane sochu na zlatém podstavci v lobby.
	- Ve Studiu bez přístupu k API ukazuje aspoň hráče na serveru.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Build = require(script.Parent.Build)
local DataService = require(script.Parent.DataService)
local WorldService = require(script.Parent.WorldService)

local LB = Config.Leaderboard

local BOARDS = {
	{
		Key = "Coins",
		Title = "RICHEST DIGGERS",
		Icon = "💰",
		Field = "TotalCoins",
		Color = Color3.fromRGB(255, 200, 50),
	},
	{
		Key = "Sand",
		Title = "MOST SAND DUG",
		Icon = "🏜️",
		Field = "TotalSand",
		Color = Color3.fromRGB(240, 170, 80),
	},
	{
		Key = "Rebirths",
		Title = "MOST REBIRTHS",
		Icon = "♻️",
		Field = "Rebirths",
		Color = Color3.fromRGB(80, 220, 255),
	},
}
local MEDALS = { "🥇", "🥈", "🥉" }

local LeaderboardService = {}

local stores = {}
local nameCache = {}
local boardRows = {} -- [key] = { {Rank, Name, Value} ... }
local dataValue: StringValue? = nil
local statueUserId: number? = -999 -- -999 = ještě nic nepostaveno
local statueModel: Model? = nil

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else "Player"
	nameCache[userId] = result
	return result
end

local function submit(player: Player, data)
	if player.UserId <= 0 then
		return
	end
	for _, board in BOARDS do
		local store = stores[board.Key]
		local value = math.floor(data[board.Field] or 0)
		if store and value > 0 then
			pcall(function()
				store:SetAsync(tostring(player.UserId), value)
			end)
		end
	end
end

-- Načte top N ze serveru Robloxu; když to nejde, vezme hráče na serveru
local function fetch(board)
	local store = stores[board.Key]
	if store then
		local ok, entries = pcall(function()
			local pages = store:GetSortedAsync(false, LB.Size)
			return pages:GetCurrentPage()
		end)
		if ok and entries then
			local list = {}
			for _, entry in entries do
				local userId = tonumber(entry.key) or 0
				table.insert(list, { UserId = userId, Name = getName(userId), Value = entry.value })
			end
			if #list > 0 then
				return list
			end
		end
	end
	-- záloha: hráči na tomto serveru
	local list = {}
	for player, session in DataService.getAll() do
		table.insert(
			list,
			{ UserId = player.UserId, Name = player.DisplayName, Value = math.floor(session.Data[board.Field] or 0) }
		)
	end
	table.sort(list, function(a, b)
		return a.Value > b.Value
	end)
	while #list > LB.Size do
		table.remove(list)
	end
	return list
end

---------------------------------------------------------------------
-- Tabule v lobby (SurfaceGui)
---------------------------------------------------------------------

local function buildBoardGui(part: BasePart, board)
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(700, 900)
	surface.LightInfluence = 0
	surface.Parent = part

	local header = Instance.new("Frame")
	header.Size = UDim2.new(1, 0, 0, 130)
	header.BackgroundColor3 = board.Color
	header.Parent = surface
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190))
	gradient.Rotation = 90
	gradient.Parent = header
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -30, 1, -20)
	title.Position = UDim2.fromOffset(15, 10)
	title.BackgroundTransparency = 1
	title.Text = board.Icon .. " " .. board.Title
	title.Font = Enum.Font.LuckiestGuy
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Parent = header
	Build.stroke(title, 5)

	local rows = {}
	for i = 1, LB.Size do
		local row = Instance.new("Frame")
		row.Position = UDim2.fromOffset(15, 140 + (i - 1) * 70)
		row.Size = UDim2.new(1, -30, 0, 62)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(70, 45, 25) else Color3.fromRGB(85, 55, 30)
		row.Parent = surface
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 12)
		corner.Parent = row
		local rank = Instance.new("TextLabel")
		rank.Size = UDim2.new(0, 80, 1, 0)
		rank.BackgroundTransparency = 1
		rank.Text = MEDALS[i] or ("#" .. i)
		rank.Font = Enum.Font.LuckiestGuy
		rank.TextScaled = true
		rank.TextColor3 = Color3.fromRGB(255, 230, 170)
		rank.Parent = row
		local name = Instance.new("TextLabel")
		name.Position = UDim2.fromOffset(90, 0)
		name.Size = UDim2.new(1, -300, 1, -10)
		name.BackgroundTransparency = 1
		name.Text = "---"
		name.Font = Enum.Font.FredokaOne
		name.TextScaled = true
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = Color3.new(1, 1, 1)
		name.Parent = row
		local value = Instance.new("TextLabel")
		value.AnchorPoint = Vector2.new(1, 0)
		value.Position = UDim2.new(1, -15, 0, 0)
		value.Size = UDim2.new(0, 200, 1, -10)
		value.BackgroundTransparency = 1
		value.Text = ""
		value.Font = Enum.Font.LuckiestGuy
		value.TextScaled = true
		value.TextXAlignment = Enum.TextXAlignment.Right
		value.TextColor3 = board.Color
		value.Parent = row
		Build.stroke(value, 2)
		rows[i] = { Name = name, Value = value }
	end
	return rows
end

local function updateStatue(userId: number?)
	local lobby = WorldService.Lobby
	if not lobby or not lobby.StatueCFrame or userId == statueUserId then
		return
	end
	statueUserId = userId
	if statueModel then
		statueModel:Destroy()
		statueModel = nil
	end
	local model: Model? = nil
	if userId and userId > 0 then
		local ok, result = pcall(function()
			return Players:CreateHumanoidModelFromUserId(userId)
		end)
		if ok and result then
			model = result
		end
	end
	if model then
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
			end
		end
		local lift = 3
		if humanoid and root then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			lift = humanoid.HipHeight + root.Size.Y / 2
		end
		model:PivotTo(lobby.StatueCFrame * CFrame.new(0, lift, 0))
		model.Name = "TopPlayerStatue"
		model.Parent = lobby.StatueParent
		if root then
			Build.billboard(
				root,
				"👑 " .. getName(userId :: number),
				Color3.fromRGB(255, 220, 90),
				Vector2.new(10, 2),
				4.5,
				Enum.Font.FredokaOne
			)
		end
	else
		-- zástupná zlatá postavička
		model = Build.npc(lobby.StatueParent, lobby.StatueCFrame, {
			Skin = Color3.fromRGB(255, 200, 60),
			Shirt = Color3.fromRGB(255, 200, 60),
			Pants = Color3.fromRGB(255, 200, 60),
			Hat = Color3.fromRGB(255, 200, 60),
			Material = Enum.Material.Metal,
		}, "👑 " .. (if userId then getName(userId) else "Be the #1!"))
	end
	statueModel = model
end

local function refresh()
	local payload = {}
	for _, board in BOARDS do
		local list = fetch(board)
		payload[board.Key] = list
		local rows = boardRows[board.Key]
		if rows then
			for i, row in rows do
				local entry = list[i]
				row.Name.Text = if entry then entry.Name else "---"
				row.Value.Text = if entry then Util.formatNumber(entry.Value) else ""
			end
		end
	end
	payload.Updated = os.time()
	if dataValue then
		dataValue.Value = HttpService:JSONEncode(payload)
	end
	local top = payload.Coins and payload.Coins[1]
	updateStatue(top and top.UserId or nil)
end

function LeaderboardService.init()
	for _, board in BOARDS do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore("LB_" .. board.Key .. "_" .. LB.Version)
		end)
		if ok then
			stores[board.Key] = store
		end
	end

	local value = Instance.new("StringValue")
	value.Name = "LeaderboardData"
	value.Value = "{}"
	value.Parent = ReplicatedStorage
	dataValue = value

	local lobby = WorldService.Lobby
	if lobby and lobby.Boards then
		for _, board in BOARDS do
			local part = lobby.Boards[board.Key]
			if part then
				boardRows[board.Key] = buildBoardGui(part, board)
			end
		end
	end

	DataService.onSaved(submit)

	task.spawn(function()
		task.wait(5)
		while true do
			pcall(refresh)
			task.wait(LB.RefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000D">
					<Properties>
						<string name="Name">LobbyBuilder</string>
						<ProtectedString name="Source"><![CDATA[--[[
	LobbyBuilder – postaví lobby „Oasis Town" uprostřed pouště.

	Rozložení (sever = +Z, východ = +X):
	  střed ....... oáza s vodou a zlatou sochou kopáče, spawny kolem
	  západ ....... trh: TOOL SHOP, SELL STATION (pavilon), BACKPACKS
	  východ ...... REBIRTH chrám, žebříčky (3 tabule), socha hráče č. 1
	  jih ......... GAMEPASS stánky, VIP LOUNGE (jen pro VIP)
	  sever ....... DAILY REWARD truhla, HOW TO PLAY tabule
	  okraje ...... hradby se 4 branami a rampami dolů do pouště

	Vrací tabulku "kotev" (pozice a party), které používají ostatní služby.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local ToolFactory = require(ReplicatedStorage.Shared.ToolFactory)
local Build = require(script.Parent.Build)

local W = Config.World
local HALF = W.CampHalf
local TOP = W.CampTop
local FLOOR = TOP + 0.4
local POOL = 12 -- polovina šířky jezírka

local SAND_LIGHT = Color3.fromRGB(236, 204, 150)
local SAND_DARK = Color3.fromRGB(214, 170, 112)
local STONE = Color3.fromRGB(205, 150, 98)
local WOOD = Color3.fromRGB(150, 100, 58)
local GOLD = Color3.fromRGB(255, 200, 60)
local CYAN = Color3.fromRGB(80, 220, 255)

local LobbyBuilder = {}

local P = Build.part

---------------------------------------------------------------------
-- Základna, dlažba, hradby, brány
---------------------------------------------------------------------

local function buildBase(lobby: Model)
	-- Plošina je z 4 bloků + dno, aby uprostřed zůstala jáma na vodu
	local blocks = {
		{ Vector3.new(0, TOP / 2, (HALF + POOL) / 2), Vector3.new(HALF * 2, TOP, HALF - POOL) },
		{ Vector3.new(0, TOP / 2, -(HALF + POOL) / 2), Vector3.new(HALF * 2, TOP, HALF - POOL) },
		{ Vector3.new((HALF + POOL) / 2, TOP / 2, 0), Vector3.new(HALF - POOL, TOP, POOL * 2) },
		{ Vector3.new(-(HALF + POOL) / 2, TOP / 2, 0), Vector3.new(HALF - POOL, TOP, POOL * 2) },
		{ Vector3.new(0, 12, 0), Vector3.new(POOL * 2, 24, POOL * 2) },
	}
	for i, b in blocks do
		P({
			Name = "Plateau" .. i,
			Position = b[1],
			Size = b[2],
			Material = Enum.Material.Sandstone,
			Color = STONE,
			Parent = lobby,
		})
	end

	-- Dlažba 8x8 ve dvou odstínech
	local floor = Build.model("Floor", lobby)
	for ix = -7, 6 do
		for iz = -7, 6 do
			local x = ix * 8 + 4
			local z = iz * 8 + 4
			if math.abs(x) > POOL + 2 or math.abs(z) > POOL + 2 then
				local light = (ix + iz) % 2 == 0
				P({
					Name = "Tile",
					Size = Vector3.new(7.9, 0.4, 7.9),
					Position = Vector3.new(x, TOP + 0.2, z),
					Material = if light then Enum.Material.Limestone else Enum.Material.Sandstone,
					Color = if light then SAND_LIGHT else SAND_DARK,
					Parent = floor,
				})
			end
		end
	end
	-- okraj dlažby kolem jezírka
	for _, d in { { 0, 1 }, { 0, -1 }, { 1, 0 }, { -1, 0 } } do
		local alongX = d[1] == 0
		P({
			Name = "PoolEdge",
			Size = if alongX then Vector3.new(POOL * 2 + 8, 0.4, 2) else Vector3.new(2, 0.4, POOL * 2 + 4),
			Position = Vector3.new(d[1] * (POOL + 1), TOP + 0.2, d[2] * (POOL + 1)),
			Material = Enum.Material.Limestone,
			Color = SAND_LIGHT,
			Parent = floor,
		})
	end
end

local function buildWalls(lobby: Model)
	local walls = Build.model("Walls", lobby)
	local gate = 8
	local wallH = 4
	for _, side in { "N", "S", "E", "W" } do
		for _, sign in { -1, 1 } do
			local length = HALF - gate
			local mid = sign * (gate + length / 2)
			local position, size
			if side == "N" or side == "S" then
				position = Vector3.new(mid, FLOOR + wallH / 2, if side == "N" then HALF - 1 else -HALF + 1)
				size = Vector3.new(length, wallH, 2)
			else
				position = Vector3.new(if side == "E" then HALF - 1 else -HALF + 1, FLOOR + wallH / 2, mid)
				size = Vector3.new(2, wallH, length)
			end
			P({
				Name = "Wall",
				Position = position,
				Size = size,
				Material = Enum.Material.Sandstone,
				Color = STONE,
				Parent = walls,
			})
			-- cimbuří
			for t = 1, math.floor(length / 4) do
				local offset = -length / 2 + (t - 0.5) * 4
				local merlon = position
					+ (if side == "N" or side == "S" then Vector3.new(offset, 0, 0) else Vector3.new(0, 0, offset))
				P({
					Name = "Merlon",
					Size = Vector3.new(2, 1.6, 2),
					Position = merlon + Vector3.new(0, wallH / 2 + 0.8, 0),
					Material = Enum.Material.Sandstone,
					Color = STONE:Lerp(Color3.new(1, 1, 1), 0.08),
					Parent = walls,
				})
			end
		end
	end
end

local function buildGates(lobby: Model)
	local gates = Build.model("Gates", lobby)
	local dirs = {
		{ Vector3.new(0, 0, 1), "N" },
		{ Vector3.new(0, 0, -1), "S" },
		{ Vector3.new(1, 0, 0), "E" },
		{ Vector3.new(-1, 0, 0), "W" },
	}
	for _, info in dirs do
		local dir = info[1]
		local side = Vector3.new(dir.Z, 0, -dir.X)
		local edge = dir * (HALF - 1)
		for _, s in { -1, 1 } do
			local base = edge + side * (s * 9.5)
			P({
				Name = "GatePillar",
				Size = Vector3.new(3.2, 15, 3.2),
				Position = Vector3.new(base.X, FLOOR + 7.5, base.Z),
				Material = Enum.Material.Sandstone,
				Color = STONE:Lerp(Color3.new(0, 0, 0), 0.06),
				Parent = gates,
			})
			P({
				Name = "GateCap",
				Size = Vector3.new(4, 1.2, 4),
				Position = Vector3.new(base.X, FLOOR + 15.6, base.Z),
				Material = Enum.Material.Sandstone,
				Color = GOLD,
				Parent = gates,
			})
		end
		local lintelPos = Vector3.new(edge.X, FLOOR + 14, edge.Z)
		local lintel = P({
			Name = "GateLintel",
			Size = Vector3.new(22, 3, 3.4),
			CFrame = CFrame.lookAt(lintelPos, lintelPos + dir),
			Material = Enum.Material.Sandstone,
			Color = STONE,
			Parent = gates,
		})
		-- Cedule: zvenku OASIS TOWN, zevnitř TO THE DESERT
		local signPart = P({
			Name = "GateSign",
			Size = Vector3.new(16, 2.6, 3.6),
			CFrame = lintel.CFrame,
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(120, 78, 42),
			Parent = gates,
		})
		Build.sign(signPart, "OASIS TOWN", Color3.fromRGB(255, 214, 110), { Enum.NormalId.Front })
		Build.sign(signPart, "TO THE DESERT", Color3.fromRGB(120, 235, 255), { Enum.NormalId.Back })
		for _, s in { -1, 1 } do
			local bannerBase = edge - dir * 2.5 + side * (s * 9.5)
			Build.banner(
				gates,
				Vector3.new(bannerBase.X, FLOOR, bannerBase.Z),
				if s < 0 then Color3.fromRGB(220, 70, 50) else Color3.fromRGB(40, 110, 200),
				-dir
			)
		end

		-- Rampa dolů do pouště (odkryje se, až hráči vykopou písek u hradeb)
		local run = TOP * 1.7
		local topPoint = dir * HALF + Vector3.new(0, TOP, 0)
		local bottomPoint = dir * (HALF + run)
		local mid = (topPoint + bottomPoint) / 2
		local ramp = P({
			Name = "Ramp",
			Size = Vector3.new(14, 1.5, (topPoint - bottomPoint).Magnitude + 2),
			CFrame = CFrame.lookAt(mid, topPoint),
			Material = Enum.Material.WoodPlanks,
			Color = WOOD,
			Parent = gates,
		})
		for _, s in { -1, 1 } do
			P({
				Name = "RampRail",
				Size = Vector3.new(0.6, 1.2, ramp.Size.Z),
				CFrame = ramp.CFrame * CFrame.new(s * 6.8, 1.3, 0),
				Material = Enum.Material.Wood,
				Color = WOOD:Lerp(Color3.new(0, 0, 0), 0.2),
				Parent = gates,
			})
		end
	end
end

---------------------------------------------------------------------
-- Oáza uprostřed
---------------------------------------------------------------------

local function buildOasis(lobby: Model)
	local oasis = Build.model("Oasis", lobby)
	-- obruba
	for _, d in { { 0, 1 }, { 0, -1 }, { 1, 0 }, { -1, 0 } } do
		local alongX = d[1] == 0
		P({
			Name = "Rim",
			Size = if alongX then Vector3.new(POOL * 2 + 4, 1.4, 2) else Vector3.new(2, 1.4, POOL * 2),
			Position = Vector3.new(d[1] * (POOL + 1), FLOOR + 0.5, d[2] * (POOL + 1)),
			Material = Enum.Material.Limestone,
			Color = Color3.fromRGB(240, 220, 180),
			Parent = oasis,
		})
	end
	-- ostrůvek se zlatou sochou kopáče
	Build.cylinder({
		Name = "StatueIsland",
		Height = 9.5,
		Diameter = 8,
		Position = Vector3.new(0, 24 + 4.75, 0),
		Material = Enum.Material.Limestone,
		Color = Color3.fromRGB(235, 212, 170),
		Parent = oasis,
	})
	Build.cylinder({
		Name = "StatueBase",
		Height = 1.2,
		Diameter = 6,
		Position = Vector3.new(0, 34.1, 0),
		Material = Enum.Material.Metal,
		Color = GOLD,
		Parent = oasis,
	})
	local statue = Build.npc(oasis, CFrame.new(0, 34.7, 0) * CFrame.Angles(0, math.rad(180), 0), {
		Skin = GOLD,
		Shirt = GOLD,
		Pants = GOLD,
		Hat = GOLD,
		Material = Enum.Material.Metal,
	}, nil)
	statue.Name = "GoldenDigger"
	local shovel = ToolFactory.createModel("GoldenShovel")
	shovel:PivotTo(CFrame.new(2.2, 38, -0.6) * CFrame.Angles(math.rad(-160), 0, math.rad(10)))
	shovel.Parent = statue
	Build.sparkles(statue.PrimaryPart :: BasePart, GOLD, 4)
	-- lekníny
	for i = 1, 6 do
		local angle = i * 1.05
		local r = 7 + (i % 2) * 2.5
		Build.cylinder({
			Name = "LilyPad",
			Height = 0.15,
			Diameter = 1.8,
			Position = Vector3.new(math.cos(angle) * r, TOP + 0.05, math.sin(angle) * r),
			Material = Enum.Material.Grass,
			Color = Color3.fromRGB(70, 160, 70),
			CanCollide = false,
			Parent = oasis,
		})
	end
	-- palmy v rozích jezírka
	for _, c in { { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } } do
		Build.palm(oasis, Vector3.new(c[1] * (POOL + 3), FLOOR, c[2] * (POOL + 3)), c[1] * 0.12, 7)
	end
end

---------------------------------------------------------------------
-- Stánky na trhu
---------------------------------------------------------------------

local function displayTool(parent: Instance, toolId: string, cframe: CFrame)
	local model = ToolFactory.createModel(toolId)
	model:PivotTo(cframe)
	model.Parent = parent
	return model
end

local function buildStall(
	parent: Instance,
	center: Vector3,
	facing: Vector3,
	roofA: Color3,
	roofB: Color3,
	title: string,
	npcName: string,
	npcColors
)
	local stall = Build.model(title, parent)
	local frame = CFrame.lookAt(center, center + facing)
	local w, h = 16, 9
	-- podlaha a sloupy
	P({
		Name = "StallFloor",
		Size = Vector3.new(w + 2, 0.5, 10),
		CFrame = frame * CFrame.new(0, 0.25, 0.5),
		Material = Enum.Material.WoodPlanks,
		Color = WOOD,
		Parent = stall,
	})
	for _, x in { -w / 2, w / 2 } do
		for _, z in { -3.5, 4.5 } do
			local postH = if z < 0 then h - 1.5 else h + 1
			P({
				Name = "Post",
				Size = Vector3.new(0.8, postH, 0.8),
				CFrame = frame * CFrame.new(x, postH / 2, z),
				Material = Enum.Material.Wood,
				Color = WOOD:Lerp(Color3.new(0, 0, 0), 0.25),
				Parent = stall,
			})
		end
	end
	-- zadní stěna s regály
	P({
		Name = "BackWall",
		Size = Vector3.new(w, h, 0.6),
		CFrame = frame * CFrame.new(0, h / 2, 4.6),
		Material = Enum.Material.WoodPlanks,
		Color = WOOD:Lerp(Color3.new(1, 1, 1), 0.1),
		Parent = stall,
	})
	for _, y in { 3.2, 6 } do
		P({
			Name = "Shelf",
			Size = Vector3.new(w - 1, 0.3, 1.6),
			CFrame = frame * CFrame.new(0, y, 3.6),
			Material = Enum.Material.Wood,
			Color = WOOD,
			Parent = stall,
		})
	end
	-- pruhovaná markýza
	local strips = 8
	for i = 1, strips do
		local x = -w / 2 + (i - 0.5) * (w / strips)
		P({
			Name = "Awning",
			Size = Vector3.new(w / strips + 0.02, 0.25, 10.5),
			CFrame = frame * CFrame.new(x, h - 0.2, 0.3) * CFrame.Angles(math.rad(-14), 0, 0),
			Material = Enum.Material.Fabric,
			Color = if i % 2 == 0 then roofA else roofB,
			CanCollide = false,
			Parent = stall,
		})
	end
	-- pult
	local counter = P({
		Name = "Counter",
		Size = Vector3.new(w - 2, 3.4, 2.4),
		CFrame = frame * CFrame.new(0, 1.7, -2.6),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(176, 120, 66),
		Parent = stall,
	})
	P({
		Name = "CounterTop",
		Size = Vector3.new(w - 1.4, 0.3, 2.8),
		CFrame = frame * CFrame.new(0, 3.55, -2.6),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(120, 78, 42),
		Parent = stall,
	})
	Build.npc(stall, frame * CFrame.new(0, 0.5, 0.8), npcColors, npcName)
	Build.billboard(counter, title, Color3.fromRGB(255, 236, 170), Vector2.new(14, 3), h + 1.5)
	return stall, counter, frame
end

local function buildMarket(lobby: Model, anchors)
	local market = Build.model("Market", lobby)

	-- TOOL SHOP
	local tools, toolCounter, toolFrame = buildStall(
		market,
		Vector3.new(-45, FLOOR, -26),
		Vector3.new(1, 0, 0),
		Color3.fromRGB(225, 60, 50),
		Color3.fromRGB(255, 245, 230),
		"TOOL SHOP",
		"Tool Trader",
		{ Shirt = Color3.fromRGB(200, 70, 50), Hat = Color3.fromRGB(90, 60, 35), Beard = Color3.fromRGB(80, 50, 30) }
	)
	displayTool(tools, "Spoon", toolFrame * CFrame.new(-5, 4.1, -2.6) * CFrame.Angles(math.rad(-90), 0, math.rad(20)))
	displayTool(
		tools,
		"Shovel",
		toolFrame * CFrame.new(5.5, 4.2, -2.6) * CFrame.Angles(math.rad(-90), 0, math.rad(-70))
	)
	displayTool(tools, "Vacuum", toolFrame * CFrame.new(-4, 7, 3.4) * CFrame.Angles(0, math.rad(180), 0))
	displayTool(tools, "Trowel", toolFrame * CFrame.new(4, 6.8, 3.4) * CFrame.Angles(0, math.rad(180), 0))
	anchors.ToolCounter = toolCounter

	-- BACKPACKS
	local bags, bagCounter, bagFrame = buildStall(
		market,
		Vector3.new(-45, FLOOR, 28),
		Vector3.new(1, 0, 0),
		Color3.fromRGB(40, 110, 210),
		Color3.fromRGB(255, 245, 230),
		"BACKPACKS",
		"Bag Seller",
		{ Shirt = Color3.fromRGB(50, 110, 200), Hat = Color3.fromRGB(240, 240, 240) }
	)
	for i, x in { -5, -1.5, 2, 5.5 } do
		Build.ellipsoid({
			Name = "Sack",
			Size = Vector3.new(2.2, 2.6 + i * 0.2, 2),
			CFrame = bagFrame * CFrame.new(x, 4.1 + 1.3, -2.6),
			Material = Enum.Material.Fabric,
			Color = Color3.fromRGB(214, 186, 130):Lerp(Color3.fromRGB(170, 130, 80), i / 4),
			Parent = bags,
		})
	end
	Build.crate(bags, (bagFrame * CFrame.new(-7, 0.5, -5.5)).Position, 2.5, 0.3)
	Build.crate(bags, (bagFrame * CFrame.new(-6.4, 3, -5.4)).Position, 2, 0.8)
	anchors.BackpackCounter = bagCounter

	-- SELL STATION (pavilon se zlatou plochou)
	local sell = Build.model("SellStation", market)
	local c = Vector3.new(-38, FLOOR, 0)
	P({
		Name = "SellFloor",
		Size = Vector3.new(24, 0.6, 24),
		Position = c + Vector3.new(0, 0.3, 0),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(245, 228, 190),
		Parent = sell,
	})
	for _, x in { -10, 10 } do
		for _, z in { -10, 10 } do
			Build.cylinder({
				Name = "Column",
				Height = 13,
				Diameter = 2.2,
				Position = c + Vector3.new(x, 7.1, z),
				Material = Enum.Material.Marble,
				Color = Color3.fromRGB(250, 238, 210),
				Parent = sell,
			})
			P({
				Name = "ColumnCap",
				Size = Vector3.new(3, 0.8, 3),
				Position = c + Vector3.new(x, 13.9, z),
				Material = Enum.Material.Metal,
				Color = GOLD,
				Parent = sell,
			})
		end
	end
	P({
		Name = "Roof1",
		Size = Vector3.new(26, 1, 26),
		Position = c + Vector3.new(0, 14.8, 0),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(250, 238, 210),
		Parent = sell,
	})
	P({
		Name = "Roof2",
		Size = Vector3.new(20, 1, 20),
		Position = c + Vector3.new(0, 15.8, 0),
		Material = Enum.Material.Sandstone,
		Color = Color3.fromRGB(230, 120, 60),
		Parent = sell,
	})
	P({
		Name = "Roof3",
		Size = Vector3.new(13, 1, 13),
		Position = c + Vector3.new(0, 16.8, 0),
		Material = Enum.Material.Sandstone,
		Color = Color3.fromRGB(230, 120, 60),
		Parent = sell,
	})
	local finial = Build.ellipsoid({
		Name = "Finial",
		Size = Vector3.new(3, 3, 3),
		Position = c + Vector3.new(0, 18.6, 0),
		Material = Enum.Material.Metal,
		Color = GOLD,
		Parent = sell,
	})
	Build.light(finial, GOLD, 18, 1)
	local pad = P({
		Name = "SellPad",
		Size = Vector3.new(14, 0.5, 14),
		Position = c + Vector3.new(0, 0.85, 0),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 196, 60),
		Parent = sell,
	})
	Build.sparkles(pad, Color3.fromRGB(255, 220, 90), 10)
	Build.billboard(pad, "SELL SAND", Color3.fromRGB(255, 225, 90), Vector2.new(16, 4), 22)
	Build.npc(sell, CFrame.new(c + Vector3.new(-9.5, 0.6, 0)) * CFrame.Angles(0, math.rad(-90), 0), {
		Shirt = Color3.fromRGB(240, 190, 60),
		Hat = Color3.fromRGB(150, 40, 40),
		Beard = Color3.fromRGB(230, 230, 230),
	}, "Sand Buyer")
	for i = 1, 5 do
		Build.ellipsoid({
			Name = "CoinPile",
			Size = Vector3.new(2.4 - i * 0.2, 1.2, 2.4 - i * 0.2),
			Position = c + Vector3.new(-9 + (i % 2) * 2, 0.9 + i * 0.25, -8 + i * 0.6),
			Material = Enum.Material.Metal,
			Color = GOLD,
			CanCollide = false,
			Parent = sell,
		})
	end
	anchors.SellPad = pad

	-- dekorace mezi stánky
	Build.carpet(market, Vector3.new(-33, FLOOR, -26), Vector2.new(8, 12), Color3.fromRGB(170, 40, 50))
	Build.carpet(market, Vector3.new(-33, FLOOR, 28), Vector2.new(8, 12), Color3.fromRGB(40, 70, 160))
	Build.barrel(market, Vector3.new(-52, FLOOR, -15))
	Build.barrel(market, Vector3.new(-54.5, FLOOR, -13))
	Build.crate(market, Vector3.new(-53, FLOOR, 15), 3, 0.2)
	Build.crate(market, Vector3.new(-53, FLOOR + 3, 15.4), 2.2, 0.9)
	Build.pot(market, Vector3.new(-34, FLOOR, -15))
	Build.pot(market, Vector3.new(-34, FLOOR, 15), Color3.fromRGB(80, 140, 170))
end

---------------------------------------------------------------------
-- Rebirth chrám, žebříčky, socha
---------------------------------------------------------------------

local function buildTemple(lobby: Model, anchors)
	local temple = Build.model("RebirthTemple", lobby)
	local c = Vector3.new(42, FLOOR, 34)
	for i, s in { 24, 20, 16 } do
		P({
			Name = "Step",
			Size = Vector3.new(s, 1, s),
			Position = c + Vector3.new(0, i - 0.5, 0),
			Material = Enum.Material.Marble,
			Color = Color3.fromRGB(240, 232, 215),
			Parent = temple,
		})
	end
	for _, x in { -6, 6 } do
		for _, z in { -6, 6 } do
			Build.cylinder({
				Name = "Column",
				Height = 12,
				Diameter = 2.2,
				Position = c + Vector3.new(x, 9, z),
				Material = Enum.Material.Marble,
				Color = Color3.fromRGB(245, 240, 230),
				Parent = temple,
			})
		end
	end
	P({
		Name = "Roof",
		Size = Vector3.new(18, 1.2, 18),
		Position = c + Vector3.new(0, 15.6, 0),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(240, 232, 215),
		Parent = temple,
	})
	P({
		Name = "RoofTrim",
		Size = Vector3.new(18.4, 0.5, 18.4),
		Position = c + Vector3.new(0, 15, 0),
		Material = Enum.Material.Neon,
		Color = CYAN,
		Parent = temple,
	})
	P({
		Name = "Roof2",
		Size = Vector3.new(12, 1.2, 12),
		Position = c + Vector3.new(0, 16.8, 0),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(240, 232, 215),
		Parent = temple,
	})
	local crystal = P({
		Name = "Crystal",
		Size = Vector3.new(2.5, 2.5, 2.5),
		CFrame = CFrame.new(c + Vector3.new(0, 19.6, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Material = Enum.Material.Neon,
		Color = CYAN,
		Parent = temple,
	})
	Build.light(crystal, CYAN, 22, 1.5)
	local obelisk = P({
		Name = "Obelisk",
		Size = Vector3.new(3, 9, 3),
		Position = c + Vector3.new(0, 7.5, 0),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(255, 215, 120),
		Parent = temple,
	})
	P({
		Name = "ObeliskTip",
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(c + Vector3.new(0, 12.6, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Material = Enum.Material.Neon,
		Color = CYAN,
		Parent = temple,
	})
	Build.sparkles(obelisk, CYAN, 8)
	Build.billboard(obelisk, "REBIRTH", Color3.fromRGB(150, 235, 255), Vector2.new(12, 3), 14)
	anchors.RebirthAltar = obelisk
end

local function buildLeaderboards(lobby: Model, anchors)
	local boards = Build.model("Leaderboards", lobby)
	anchors.Boards = {}
	local list = {
		{ "Coins", Vector3.new(54, FLOOR, -24), Color3.fromRGB(255, 196, 40) },
		{ "Sand", Vector3.new(54, FLOOR, -6), Color3.fromRGB(240, 170, 80) },
		{ "Rebirths", Vector3.new(54, FLOOR, 12), Color3.fromRGB(80, 220, 255) },
	}
	for _, info in list do
		local base = info[2]
		local center = base + Vector3.new(0, 11, 0)
		local frame = CFrame.lookAt(center, center + Vector3.new(-1, 0, 0))
		local board = P({
			Name = "Board" .. info[1],
			Size = Vector3.new(14, 18, 1),
			CFrame = frame,
			Material = Enum.Material.SmoothPlastic,
			Color = Color3.fromRGB(45, 28, 15),
			Parent = boards,
		})
		P({
			Name = "BoardFrame",
			Size = Vector3.new(15, 19, 0.8),
			CFrame = frame * CFrame.new(0, 0, 0.3),
			Material = Enum.Material.Wood,
			Color = WOOD,
			Parent = boards,
		})
		P({
			Name = "BoardTop",
			Size = Vector3.new(16, 1.2, 2),
			CFrame = frame * CFrame.new(0, 10, 0),
			Material = Enum.Material.Metal,
			Color = info[3],
			Parent = boards,
		})
		for _, s in { -1, 1 } do
			P({
				Name = "BoardLeg",
				Size = Vector3.new(1, 3, 1),
				CFrame = frame * CFrame.new(s * 6, -10, 0.3),
				Material = Enum.Material.Wood,
				Color = WOOD,
				Parent = boards,
			})
		end
		Build.light(board, info[3], 14, 0.6)
		anchors.Boards[info[1]] = board
	end

	-- Podstavec pro sochu hráče č. 1
	local pedestalPos = Vector3.new(42, FLOOR, -44)
	Build.cylinder({
		Name = "Pedestal",
		Height = 3,
		Diameter = 8,
		Position = pedestalPos + Vector3.new(0, 1.5, 0),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(245, 235, 215),
		Parent = boards,
	})
	local ring = Build.cylinder({
		Name = "PedestalRing",
		Height = 0.4,
		Diameter = 8.4,
		Position = pedestalPos + Vector3.new(0, 3, 0),
		Material = Enum.Material.Neon,
		Color = GOLD,
		Parent = boards,
	})
	Build.sparkles(ring, GOLD, 6)
	local plaque = P({
		Name = "Plaque",
		Size = Vector3.new(8, 2, 0.4),
		CFrame = CFrame.lookAt(pedestalPos + Vector3.new(-3, 1.6, 3), pedestalPos + Vector3.new(-30, 1.6, 30)),
		Material = Enum.Material.Metal,
		Color = GOLD,
		Parent = boards,
	})
	Build.sign(plaque, "#1 RICHEST", Color3.fromRGB(70, 40, 10), { Enum.NormalId.Front })
	anchors.StatueCFrame = CFrame.lookAt(pedestalPos + Vector3.new(0, 3.2, 0), Vector3.new(0, FLOOR + 3.2, 0))
	anchors.StatueParent = boards
end

---------------------------------------------------------------------
-- Gamepass stánky a VIP salonek
---------------------------------------------------------------------

local function buildPassPlaza(lobby: Model, anchors)
	local plaza = Build.model("GamepassPlaza", lobby)
	anchors.PassStands = {}
	local colors = {
		VIP = GOLD,
		DoubleCoins = Color3.fromRGB(255, 170, 40),
		AutoSell = Color3.fromRGB(255, 230, 60),
		TreasureRadar = Color3.fromRGB(80, 230, 140),
		BigBackpack = Color3.fromRGB(80, 160, 255),
		FastDig = Color3.fromRGB(255, 90, 90),
	}
	local count = #Config.GamePassOrder
	for i, key in Config.GamePassOrder do
		local pass = Config.GamePasses[key]
		local x = -26 + (i - 1) * (52 / (count - 1))
		local base = Vector3.new(x, FLOOR, -44 + math.abs(i - (count + 1) / 2) * 1.5)
		local color = colors[key] or GOLD
		Build.cylinder({
			Name = "Stand",
			Height = 3,
			Diameter = 5,
			Position = base + Vector3.new(0, 1.5, 0),
			Material = Enum.Material.Marble,
			Color = Color3.fromRGB(245, 235, 215),
			Parent = plaza,
		})
		Build.cylinder({
			Name = "StandRing",
			Height = 0.3,
			Diameter = 5.3,
			Position = base + Vector3.new(0, 3, 0),
			Material = Enum.Material.Neon,
			Color = color,
			Parent = plaza,
		})
		local orb = Build.ellipsoid({
			Name = "Orb_" .. key,
			Size = Vector3.new(2.6, 2.6, 2.6),
			Position = base + Vector3.new(0, 5.5, 0),
			Material = Enum.Material.Neon,
			Color = color,
			Transparency = 0.35,
			CanCollide = false,
			Parent = plaza,
		})
		Build.light(orb, color, 10, 0.8)
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromScale(6, 5)
		billboard.StudsOffset = Vector3.new(0, 3.6, 0)
		billboard.MaxDistance = 90
		billboard.LightInfluence = 0
		billboard.Parent = orb
		local icon = Instance.new("TextLabel")
		icon.Size = UDim2.fromScale(1, 0.5)
		icon.BackgroundTransparency = 1
		icon.Text = pass.Icon
		icon.TextScaled = true
		icon.Parent = billboard
		local name = Instance.new("TextLabel")
		name.Position = UDim2.fromScale(0, 0.5)
		name.Size = UDim2.fromScale(1, 0.3)
		name.BackgroundTransparency = 1
		name.Text = pass.Name
		name.Font = Enum.Font.LuckiestGuy
		name.TextScaled = true
		name.TextColor3 = color
		name.Parent = billboard
		Build.stroke(name, 3)
		local price = Instance.new("TextLabel")
		price.Name = "Price"
		price.Position = UDim2.fromScale(0.15, 0.8)
		price.Size = UDim2.fromScale(0.7, 0.2)
		price.BackgroundTransparency = 1
		price.Text = "R$ " .. pass.Price
		price.Font = Enum.Font.FredokaOne
		price.TextScaled = true
		price.TextColor3 = Color3.new(1, 1, 1)
		price.Parent = billboard
		Build.stroke(price, 2.5)
		anchors.PassStands[key] = orb
	end
	local arch = P({
		Name = "PassSign",
		Size = Vector3.new(24, 3, 0.6),
		CFrame = CFrame.lookAt(Vector3.new(0, FLOOR + 13, -52), Vector3.new(0, FLOOR + 13, 0)),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(110, 60, 160),
		Parent = plaza,
	})
	Build.sign(arch, "GAMEPASSES", Color3.fromRGB(255, 225, 110), { Enum.NormalId.Front })
	for _, s in { -1, 1 } do
		P({
			Name = "PassSignPost",
			Size = Vector3.new(1, 13, 1),
			Position = Vector3.new(s * 11, FLOOR + 6.5, -52.3),
			Material = Enum.Material.Wood,
			Color = WOOD,
			Parent = plaza,
		})
	end
end

local function simpleChest(parent: Instance, cframe: CFrame, color: Color3, name: string)
	local chest = Build.model(name, parent)
	local base = P({
		Name = "Base",
		Size = Vector3.new(4, 2.4, 2.8),
		CFrame = cframe * CFrame.new(0, 1.2, 0),
		Material = Enum.Material.WoodPlanks,
		Color = color,
		Parent = chest,
	})
	P({
		Name = "Lid",
		Size = Vector3.new(4, 1, 2.8),
		CFrame = cframe * CFrame.new(0, 2.9, 0),
		Material = Enum.Material.WoodPlanks,
		Color = color:Lerp(Color3.new(1, 1, 1), 0.12),
		Parent = chest,
	})
	P({
		Name = "Band",
		Size = Vector3.new(4.1, 0.35, 2.9),
		CFrame = cframe * CFrame.new(0, 2.4, 0),
		Material = Enum.Material.Metal,
		Color = GOLD,
		Parent = chest,
	})
	P({
		Name = "Lock",
		Size = Vector3.new(0.7, 0.8, 0.3),
		CFrame = cframe * CFrame.new(0, 2.3, -1.5),
		Material = Enum.Material.Neon,
		Color = GOLD,
		Parent = chest,
	})
	chest.PrimaryPart = base
	return chest, base
end

local function buildVipLounge(lobby: Model, anchors)
	local vip = Build.model("VipLounge", lobby)
	local minX, maxX, minZ, maxZ = -HALF + 2, -34, -HALF + 2, -38
	local cx, cz = (minX + maxX) / 2, (minZ + maxZ) / 2
	local sx, sz = maxX - minX, maxZ - minZ
	P({
		Name = "VipFloor",
		Size = Vector3.new(sx, 0.3, sz),
		Position = Vector3.new(cx, FLOOR + 0.15, cz),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(255, 226, 140),
		Parent = vip,
	})
	Build.carpet(vip, Vector3.new(cx, FLOOR + 0.3, cz + 2), Vector2.new(6, sz - 4), Color3.fromRGB(190, 30, 50))
	-- zlatý plot s průchodem na severní straně
	local doorX = cx
	local fence = function(a: Vector3, b: Vector3)
		local mid = (a + b) / 2
		P({
			Name = "VipFence",
			Size = Vector3.new(0.6, 3.5, (a - b).Magnitude),
			CFrame = CFrame.lookAt(mid, b),
			Material = Enum.Material.Metal,
			Color = GOLD,
			Parent = vip,
		})
	end
	local y = FLOOR + 1.75
	fence(Vector3.new(maxX, y, minZ), Vector3.new(maxX, y, maxZ))
	fence(Vector3.new(minX + 0.5, y, maxZ), Vector3.new(doorX - 3.5, y, maxZ))
	fence(Vector3.new(doorX + 3.5, y, maxZ), Vector3.new(maxX, y, maxZ))
	for _, x in { doorX - 3.5, doorX + 3.5 } do
		P({
			Name = "VipGatePost",
			Size = Vector3.new(1.4, 8, 1.4),
			Position = Vector3.new(x, FLOOR + 4, maxZ),
			Material = Enum.Material.Metal,
			Color = GOLD,
			Parent = vip,
		})
	end
	local gateSign = P({
		Name = "VipSign",
		Size = Vector3.new(9, 2.2, 0.5),
		Position = Vector3.new(doorX, FLOOR + 8.5, maxZ),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(60, 20, 70),
		Parent = vip,
	})
	Build.sign(gateSign, "VIP LOUNGE", GOLD, { Enum.NormalId.Front, Enum.NormalId.Back })
	-- zlatá "brána" – průhledná záclona, kterou projdou jen VIP (hlídá RewardService)
	P({
		Name = "VipCurtain",
		Size = Vector3.new(6.4, 7, 0.2),
		Position = Vector3.new(doorX, FLOOR + 3.5, maxZ),
		Material = Enum.Material.ForceField,
		Color = GOLD,
		CanCollide = false,
		Transparency = 0.2,
		Parent = vip,
	})
	-- vybavení: pohovky, zlatá palma, VIP truhla
	for _, x in { minX + 4, maxX - 4 } do
		P({
			Name = "Sofa",
			Size = Vector3.new(3, 1.5, 8),
			Position = Vector3.new(x, FLOOR + 1, cz - 1),
			Material = Enum.Material.Fabric,
			Color = Color3.fromRGB(150, 30, 60),
			Parent = vip,
		})
		P({
			Name = "SofaBack",
			Size = Vector3.new(1, 2.5, 8),
			Position = Vector3.new(x + (if x < cx then -1.5 else 1.5), FLOOR + 2, cz - 1),
			Material = Enum.Material.Fabric,
			Color = Color3.fromRGB(130, 20, 50),
			Parent = vip,
		})
	end
	local palm = Build.palm(vip, Vector3.new(minX + 3, FLOOR, minZ + 3), 0.1, 6)
	for _, part in palm:GetDescendants() do
		if part:IsA("BasePart") and part.Name == "Leaf" then
			part.Color = GOLD
			part.Material = Enum.Material.Metal
		end
	end
	local chest, chestBase =
		simpleChest(vip, CFrame.new(cx, FLOOR + 0.3, minZ + 4), Color3.fromRGB(120, 40, 160), "VipChest")
	Build.sparkles(chestBase, GOLD, 10)
	Build.billboard(chestBase, "VIP REWARD", GOLD, Vector2.new(10, 2.4), 5)
	anchors.VipChest = chestBase
	anchors.VipZone = {
		Min = Vector3.new(minX - 1, FLOOR - 3, minZ - 1),
		Max = Vector3.new(maxX + 0.5, FLOOR + 25, maxZ - 0.3),
		Exit = CFrame.new(doorX, FLOOR + 3.5, maxZ + 6),
	}
	return chest
end

---------------------------------------------------------------------
-- Sever: denní odměna a návod
---------------------------------------------------------------------

local function buildNorth(lobby: Model, anchors)
	local north = Build.model("NorthPlaza", lobby)
	Build.cylinder({
		Name = "DailyPedestal",
		Height = 1.6,
		Diameter = 9,
		Position = Vector3.new(0, FLOOR + 0.8, 38),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(245, 235, 215),
		Parent = north,
	})
	Build.cylinder({
		Name = "DailyRing",
		Height = 0.3,
		Diameter = 9.3,
		Position = Vector3.new(0, FLOOR + 1.6, 38),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(120, 230, 120),
		Parent = north,
	})
	local _, base = simpleChest(
		north,
		CFrame.lookAt(Vector3.new(0, FLOOR + 1.6, 38), Vector3.new(0, FLOOR + 1.6, 0)),
		Color3.fromRGB(60, 160, 80),
		"DailyChest"
	)
	Build.sparkles(base, Color3.fromRGB(150, 255, 150), 8)
	Build.billboard(base, "DAILY REWARD", Color3.fromRGB(160, 255, 160), Vector2.new(11, 2.6), 5)
	anchors.DailyChest = base

	-- Tabule "HOW TO PLAY"
	local center = Vector3.new(-24, FLOOR + 6, 50)
	local board = P({
		Name = "HowToPlay",
		Size = Vector3.new(16, 10, 0.8),
		CFrame = CFrame.lookAt(center, center + Vector3.new(0, 0, -1)),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(110, 70, 38),
		Parent = north,
	})
	for _, s in { -1, 1 } do
		P({
			Name = "HowToPlayLeg",
			Size = Vector3.new(0.8, 6, 0.8),
			Position = Vector3.new(-24 + s * 7, FLOOR + 3, 50.4),
			Material = Enum.Material.Wood,
			Color = WOOD,
			Parent = north,
		})
	end
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(800, 500)
	surface.LightInfluence = 0
	surface.Parent = board
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 90)
	title.BackgroundTransparency = 1
	title.Text = "HOW TO PLAY"
	title.Font = Enum.Font.LuckiestGuy
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 214, 110)
	title.Parent = surface
	Build.stroke(title, 4)
	local steps = Instance.new("TextLabel")
	steps.Position = UDim2.fromOffset(30, 100)
	steps.Size = UDim2.new(1, -60, 1, -120)
	steps.BackgroundTransparency = 1
	steps.Text =
		"1. Walk out of a gate into the desert\n2. HOLD click / tap to dig sand\n3. Sell sand at the golden SELL pad\n4. Buy better tools & backpacks\n5. Dig deep to find treasure chests!"
	steps.Font = Enum.Font.FredokaOne
	steps.TextScaled = true
	steps.TextXAlignment = Enum.TextXAlignment.Left
	steps.TextColor3 = Color3.new(1, 1, 1)
	steps.Parent = surface
	Build.stroke(steps, 2)

	-- velbloud z kostiček
	local camel = Build.model("Camel", north)
	local cc = CFrame.new(28, FLOOR, 48) * CFrame.Angles(0, math.rad(200), 0)
	local tan = Color3.fromRGB(196, 150, 96)
	for _, leg in { { -1.2, -2.2 }, { 1.2, -2.2 }, { -1.2, 2.2 }, { 1.2, 2.2 } } do
		P({
			Name = "Leg",
			Size = Vector3.new(0.9, 4, 0.9),
			CFrame = cc * CFrame.new(leg[1], 2, leg[2]),
			Material = Enum.Material.Fabric,
			Color = tan,
			Parent = camel,
		})
	end
	P({
		Name = "Body",
		Size = Vector3.new(3.2, 2.6, 6.4),
		CFrame = cc * CFrame.new(0, 5, 0),
		Material = Enum.Material.Fabric,
		Color = tan,
		Parent = camel,
	})
	Build.ellipsoid({
		Name = "Hump",
		Size = Vector3.new(2.6, 2.4, 3),
		CFrame = cc * CFrame.new(0, 6.6, 0.4),
		Material = Enum.Material.Fabric,
		Color = tan,
		Parent = camel,
	})
	P({
		Name = "Neck",
		Size = Vector3.new(1.2, 3.4, 1.2),
		CFrame = cc * CFrame.new(0, 6.6, -3.6) * CFrame.Angles(math.rad(-25), 0, 0),
		Material = Enum.Material.Fabric,
		Color = tan,
		Parent = camel,
	})
	P({
		Name = "Head",
		Size = Vector3.new(1.4, 1.3, 2.4),
		CFrame = cc * CFrame.new(0, 8.4, -4.8),
		Material = Enum.Material.Fabric,
		Color = tan,
		Parent = camel,
	})
	Build.carpet(camel, (cc * CFrame.new(0, 6.32, 0.4)).Position, Vector2.new(3.4, 3.6), Color3.fromRGB(180, 40, 60))
	Build.crate(north, Vector3.new(34, FLOOR, 44), 2.6, 0.4)
	Build.barrel(north, Vector3.new(22, FLOOR, 52))
	Build.pot(north, Vector3.new(-14, FLOOR, 54), Color3.fromRGB(80, 140, 170))
end

local function buildDecor(lobby: Model)
	local decor = Build.model("Decor", lobby)
	-- lucerny kolem náměstí
	for i = 0, 7 do
		local angle = i * math.pi / 4 + math.pi / 8
		Build.lantern(decor, Vector3.new(math.cos(angle) * 22, FLOOR, math.sin(angle) * 22))
	end
	-- palmy v rozích
	for _, c in { { 1, 1 }, { -1, 1 }, { 1, -1 } } do
		Build.palm(decor, Vector3.new(c[1] * (HALF - 6), FLOOR, c[2] * (HALF - 6)), -c[1] * 0.1, 7)
	end
	Build.palm(decor, Vector3.new(-24, FLOOR, -18), 0.12, 6)
	Build.palm(decor, Vector3.new(-24, FLOOR, 20), -0.1, 6)
	Build.palm(decor, Vector3.new(26, FLOOR, 22), 0.1, 6)
	-- vlajky na hradbách
	for _, x in { -40, -20, 20, 40 } do
		Build.banner(
			decor,
			Vector3.new(x, FLOOR, HALF - 3),
			if x < 0 then Color3.fromRGB(220, 70, 50) else Color3.fromRGB(40, 110, 200),
			Vector3.new(0, 0, -1)
		)
		Build.banner(
			decor,
			Vector3.new(x, FLOOR, -HALF + 3),
			if x < 0 then Color3.fromRGB(40, 110, 200) else Color3.fromRGB(220, 70, 50),
			Vector3.new(0, 0, 1)
		)
	end
end

---------------------------------------------------------------------
-- Veřejné API
---------------------------------------------------------------------

-- Voda v oáze (Terrain). Volá se znovu po každém přegenerování pouště.
function LobbyBuilder.fillWater()
	workspace.Terrain:FillBlock(CFrame.new(0, 27, 0), Vector3.new(POOL * 2, 6, POOL * 2), Enum.Material.Water)
end

function LobbyBuilder.build(parent: Instance)
	local lobby = Build.model("OasisTown", parent)
	pcall(function()
		lobby.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	local anchors = { Model = lobby }

	buildBase(lobby)
	buildWalls(lobby)
	buildGates(lobby)
	buildOasis(lobby)
	buildMarket(lobby, anchors)
	buildTemple(lobby, anchors)
	buildLeaderboards(lobby, anchors)
	buildPassPlaza(lobby, anchors)
	buildVipLounge(lobby, anchors)
	buildNorth(lobby, anchors)
	buildDecor(lobby)

	-- Spawny kolem oázy
	anchors.Spawns = {}
	for _, d in { Vector3.new(0, 0, -20), Vector3.new(20, 0, 0), Vector3.new(-20, 0, 0), Vector3.new(0, 0, 20) } do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "Spawn"
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Size = Vector3.new(6, 0.2, 6)
		spawn.Position = Vector3.new(d.X, FLOOR + 0.1, d.Z)
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.Parent = lobby
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
		Build.cylinder({
			Name = "SpawnPad",
			Height = 0.25,
			Diameter = 7,
			Position = Vector3.new(d.X, FLOOR + 0.12, d.Z),
			Material = Enum.Material.Marble,
			Color = Color3.fromRGB(250, 240, 220),
			Parent = lobby,
		})
		Build.cylinder({
			Name = "SpawnRing",
			Height = 0.28,
			Diameter = 5.2,
			Position = Vector3.new(d.X, FLOOR + 0.13, d.Z),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 190, 70),
			Parent = lobby,
		})
		table.insert(
			anchors.Spawns,
			CFrame.lookAt(Vector3.new(d.X, FLOOR + 4, d.Z), Vector3.new(d.X * 3, FLOOR + 4, d.Z * 3))
		)
	end

	return anchors
end

return LobbyBuilder
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000E">
					<Properties>
						<string name="Name">MonetizationService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	MonetizationService – gamepassy a developer produkty (nákupy za Robux).

	- Gamepassy: koupí se jednou, platí navždy. Ověřují se při připojení
	  a hned po nákupu (bez nutnosti se znovu připojit).
	- Developer produkty: dají se kupovat opakovaně (mince, Server Luck).
	  Zpracování přes ProcessReceipt s ochranou proti dvojímu připsání.

	ID se vyplňují v ReplicatedStorage > Shared > Config (GamePasses / Products).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local MonetizationService = {}

local MAX_STORED_RECEIPTS = 100

local function passKeyFromId(passId: number): string?
	for key, pass in Config.GamePasses do
		if pass.Id ~= 0 and pass.Id == passId then
			return key
		end
	end
	return nil
end

local function productKeyFromId(productId: number): string?
	for key, product in Config.Products do
		if product.Id ~= 0 and product.Id == productId then
			return key
		end
	end
	return nil
end

-- Aktivuje gamepass pro hráče
local function grantPass(player: Player, key: string, announce: boolean)
	local session = DataService.get(player)
	if not session or session.Passes[key] then
		return
	end
	session.Passes[key] = true
	player:SetAttribute("Pass_" .. key, true)
	if key == "VIP" then
		player:SetAttribute("VIP", true)
		-- Po koupi VIP dostane hráč Zlatou lopatu do ruky (pokud nemá lepší nástroj)
		local current = Config.ToolsById[session.Data.EquippedTool]
		local golden = Config.ToolsById.GoldenShovel
		if announce and golden and (not current or current.Index < golden.Index) then
			session.Data.EquippedTool = "GoldenShovel"
			ShopService.giveTool(player)
		end
	end
	DataService.markDirty(player)
	if announce then
		local pass = Config.GamePasses[key]
		DataService.notify(player, ("%s %s activated! Thank you! ❤️"):format(pass.Icon, pass.Name), "epic")
	end
end

-- Zkontroluje všechny gamepassy hráče (volá se po načtení dat)
function MonetizationService.loadPasses(player: Player)
	local giveAll = RunService:IsStudio() and Config.Testing.GiveAllPassesInStudio
	for key, pass in Config.GamePasses do
		if giveAll then
			grantPass(player, key, false)
		elseif pass.Id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and owns then
				grantPass(player, key, false)
			end
		end
	end
end

---------------------------------------------------------------------
-- Developer produkty
---------------------------------------------------------------------

local PRODUCT_HANDLERS = {}

local function grantCoins(player: Player, session, baseCoins: number)
	local coins = baseCoins * (session.Data.Rebirths + 1)
	DataService.addCoins(player, coins)
	DataService.notify(player, ("💰 +%s coins! Thank you! ❤️"):format(Util.formatNumber(coins)), "epic")
end

PRODUCT_HANDLERS.CoinsSmall = function(player, session)
	grantCoins(player, session, Config.Products.CoinsSmall.Coins)
end
PRODUCT_HANDLERS.CoinsMedium = function(player, session)
	grantCoins(player, session, Config.Products.CoinsMedium.Coins)
end
PRODUCT_HANDLERS.CoinsLarge = function(player, session)
	grantCoins(player, session, Config.Products.CoinsLarge.Coins)
end
PRODUCT_HANDLERS.ServerLuck = function(player, _session)
	local now = os.time()
	local current = workspace:GetAttribute("ServerLuckUntil") or 0
	local base = math.max(now, current)
	workspace:SetAttribute("ServerLuckUntil", base + Config.Products.ServerLuck.LuckMinutes * 60)
	DataService.notifyAll(
		("🍀 %s activated SERVER LUCK! Rarer chests for everyone for %d minutes!"):format(
			player.DisplayName,
			Config.Products.ServerLuck.LuckMinutes
		),
		"epic"
	)
end

local function trimReceipts(receipts)
	local count = 0
	local oldestKey, oldestTime = nil, math.huge
	for key, time in receipts do
		count += 1
		if time < oldestTime then
			oldestKey, oldestTime = key, time
		end
	end
	if count > MAX_STORED_RECEIPTS and oldestKey then
		receipts[oldestKey] = nil
	end
end

local function processReceipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local session = DataService.get(player)
	if not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = session.Data
	local purchaseId = tostring(receiptInfo.PurchaseId)
	if data.Receipts[purchaseId] then
		-- už jsme to připsali dřív
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local key = productKeyFromId(receiptInfo.ProductId)
	local handler = key and PRODUCT_HANDLERS[key]
	if not handler then
		warn("[Monetization] Neznámý produkt ID:", receiptInfo.ProductId, "– doplň ho do Config.Products")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, err = pcall(handler, player, session)
	if not ok then
		warn("[Monetization] Chyba při připsání produktu:", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	data.Receipts[purchaseId] = os.time()
	trimReceipts(data.Receipts)
	DataService.markDirty(player)

	if not DataService.saveNow(player) then
		-- Data se nepodařilo uložit – Roblox zkusí nákup zpracovat znovu později.
		-- Účtenka je už zapsaná v paměti, takže se nákup v tomto serveru nepřipíše dvakrát.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.init()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		if not wasPurchased then
			return
		end
		local key = passKeyFromId(passId)
		if key then
			grantPass(player, key, true)
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt

	-- Upozornění pro vývojáře
	local missing = {}
	for key, pass in Config.GamePasses do
		if pass.Id == 0 then
			table.insert(missing, key)
		end
	end
	if #missing > 0 then
		warn(
			"[Monetization] Gamepassy bez ID (nejdou koupit): "
				.. table.concat(missing, ", ")
				.. ". Vytvoř je na create.roblox.com a vlož ID do Config.GamePasses."
		)
	end
end

return MonetizationService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000F">
					<Properties>
						<string name="Name">RewardService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	RewardService – denní odměna, VIP salonek a gamepass stánky v lobby.

	- DAILY REWARD truhla (lobby + tlačítko v UI) – jednou za Config.Daily.CooldownHours
	- VIP REWARD truhla ve VIP salonku – jen pro majitele VIP
	- Do VIP salonku smí jen VIP (ostatní to vrátí ke vchodu a nabídne VIP)
	- Gamepass stánky: přijdeš k zářící kouli a koupíš pass
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local WorldService = require(script.Parent.WorldService)

local RewardService = {}

local lastVipKick = {} -- [Player] = os.clock()

local function cooldownLeft(lastTime: number): number
	return math.max(0, lastTime + Config.Daily.CooldownHours * 3600 - os.time())
end

local function formatLong(seconds: number): string
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	return string.format("%dh %02dm", h, m)
end

function RewardService.claimDaily(player: Player)
	local session = DataService.get(player)
	if not session then
		return false, "Not ready yet"
	end
	local data = session.Data
	local left = cooldownLeft(data.LastDaily)
	if left > 0 then
		return false, "Next daily reward in " .. formatLong(left)
	end
	local coins = Config.Daily.Coins * (data.Rebirths + 1)
	data.LastDaily = os.time()
	DataService.addCoins(player, coins)
	Remotes.Reward:FireClient(player, "Daily", coins)
	return true, ("Daily reward: +%s coins!"):format(Util.formatNumber(coins))
end

function RewardService.claimVip(player: Player)
	local session = DataService.get(player)
	if not session then
		return false, "Not ready yet"
	end
	if not session.Passes.VIP then
		local pass = Config.GamePasses.VIP
		if pass.Id ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		end
		return false, "This chest is for VIPs only 👑"
	end
	local data = session.Data
	local left = cooldownLeft(data.LastVipChest)
	if left > 0 then
		return false, "Next VIP reward in " .. formatLong(left)
	end
	local coins = Config.Daily.VipCoins * (data.Rebirths + 1)
	data.LastVipChest = os.time()
	DataService.addCoins(player, coins)
	Remotes.Reward:FireClient(player, "Vip", coins)
	return true, ("VIP reward: +%s coins! 👑"):format(Util.formatNumber(coins))
end

local function addPrompt(part: BasePart?, actionText: string, objectText: string, hold: number, callback)
	if not part then
		return nil
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	prompt.Triggered:Connect(callback)
	return prompt
end

local function insideBox(position: Vector3, zone): boolean
	return position.X >= zone.Min.X
		and position.X <= zone.Max.X
		and position.Y >= zone.Min.Y
		and position.Y <= zone.Max.Y
		and position.Z >= zone.Min.Z
		and position.Z <= zone.Max.Z
end

function RewardService.init()
	local lobby = WorldService.Lobby or {}

	Remotes.ClaimDaily.OnServerInvoke = function(player)
		return RewardService.claimDaily(player)
	end

	addPrompt(lobby.DailyChest, "Claim", "Daily Reward", 0.5, function(player)
		local ok, message = RewardService.claimDaily(player)
		DataService.notify(player, message, if ok then "success" else "info")
	end)
	addPrompt(lobby.VipChest, "Claim", "VIP Reward", 0.5, function(player)
		local ok, message = RewardService.claimVip(player)
		DataService.notify(player, message, if ok then "epic" else "info")
	end)

	-- Gamepass stánky
	for key, orb in lobby.PassStands or {} do
		local pass = Config.GamePasses[key]
		addPrompt(orb, "Buy", pass.Name, 0, function(player)
			local session = DataService.get(player)
			if session and session.Passes[key] then
				DataService.notify(player, "You already own " .. pass.Name .. " ✅", "success")
			elseif pass.Id == 0 then
				DataService.notify(player, "This gamepass is not set up yet", "error")
			else
				MarketplaceService:PromptGamePassPurchase(player, pass.Id)
			end
		end)
		-- skutečná cena z Robloxu
		if pass.Id ~= 0 then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(pass.Id, Enum.InfoType.GamePass)
				end)
				local label = orb:FindFirstChild("Price", true)
				if ok and info and info.PriceInRobux and label and label:IsA("TextLabel") then
					label.Text = "R$ " .. info.PriceInRobux
				end
			end)
		end
	end

	-- VIP salonek – kdo nemá VIP, toho to vrátí ke vchodu
	local zone = lobby.VipZone
	if zone then
		task.spawn(function()
			while true do
				task.wait(0.4)
				for _, player in Players:GetPlayers() do
					local character = player.Character
					local root = character and character:FindFirstChild("HumanoidRootPart")
					local session = DataService.get(player)
					if root and session and not session.Passes.VIP and insideBox(root.Position, zone) then
						character:PivotTo(zone.Exit)
						local now = os.clock()
						if now - (lastVipKick[player] or 0) > 12 then
							lastVipKick[player] = now
							DataService.notify(
								player,
								"👑 VIP LOUNGE is for VIPs only! Get VIP in the STORE.",
								"epic"
							)
							local pass = Config.GamePasses.VIP
							if pass.Id ~= 0 then
								MarketplaceService:PromptGamePassPurchase(player, pass.Id)
							end
						end
					end
				end
			end
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastVipKick[player] = nil
	end)
end

return RewardService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000010">
					<Properties>
						<string name="Name">SandstormService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	SandstormService – písečná bouře.
	Když hráči vykopou velkou část pouště (nebo uplyne čas), přijde bouře,
	všechny odnese do tábora a poušť se znovu zasype – s novými poklady
	a ruinami na jiném místě. Díky tomu hra "nikdy nedojde".

	Stav se posílá klientům přes atributy na Workspace:
	  DesertCleared (0..1), StormPhase ("Calm"/"Warning"/"Active"), StormIn (sekundy)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local TreasureService = require(script.Parent.TreasureService)
local WorldService = require(script.Parent.WorldService)

local S = Config.Sandstorm

local SandstormService = {}

local phase = "Calm"
local nextStorm = 0
local warningEnds = 0

local function setPhase(newPhase: string)
	phase = newPhase
	workspace:SetAttribute("StormPhase", newPhase)
end

local function runStorm()
	setPhase("Active")
	local started = os.clock()
	WorldService.setReady(false)

	-- Všechny odneseme do tábora, aby je písek nezasypal
	for _, player in Players:GetPlayers() do
		task.spawn(WorldService.teleportToCamp, player)
	end
	task.wait(1)

	TreasureService.clearAll()
	WorldService.regenerate()
	TreasureService.populate()

	local elapsed = os.clock() - started
	if elapsed < S.MinStormTime then
		task.wait(S.MinStormTime - elapsed)
	end

	WorldService.setReady(true)
	nextStorm = os.time() + S.Interval
	setPhase("Calm")
	DataService.notifyAll("🏜️ The storm is over! The desert is full of NEW treasures. Start digging!", "epic")
end

function SandstormService.forceStorm()
	if phase == "Calm" then
		nextStorm = os.time()
	end
end

function SandstormService.start()
	nextStorm = os.time() + S.Interval
	setPhase("Calm")

	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			workspace:SetAttribute("DesertCleared", WorldService.getClearedFraction())

			if phase == "Calm" then
				workspace:SetAttribute("StormIn", math.max(0, nextStorm - now))
				if
					WorldService.isReady()
					and (WorldService.getClearedFraction() >= S.ClearedThreshold or now >= nextStorm)
				then
					warningEnds = now + S.WarningTime
					setPhase("Warning")
					DataService.notifyAll(
						("🌪️ A SANDSTORM is coming in %d seconds! The desert will be buried again!"):format(
							S.WarningTime
						),
						"storm"
					)
				end
			elseif phase == "Warning" then
				workspace:SetAttribute("StormIn", math.max(0, warningEnds - now))
				if now >= warningEnds then
					task.spawn(runStorm)
				end
			end
		end
	end)
end

return SandstormService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000011">
					<Properties>
						<string name="Name">ShopService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	ShopService – prodej písku, obchod s nástroji/batohy, rebirth, kódy,
	teleport do tábora a výdej nástroje do ruky.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local Stats = require(script.Parent.Stats)
local ToolFactory = require(ReplicatedStorage.Shared.ToolFactory)
local WorldService = require(script.Parent.WorldService)

local ShopService = {}

---------------------------------------------------------------------
-- Nástroj v ruce
---------------------------------------------------------------------

function ShopService.giveTool(player: Player)
	local session = DataService.get(player)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not session or not character or not backpack then
		return
	end

	-- Pojistka: když hráč přišel o gamepass nástroj, vrátíme ho k nejlepšímu vlastněnému
	if not Stats.ownsTool(session, session.Data.EquippedTool) then
		session.Data.EquippedTool = "Hands"
		for _, tool in Config.Tools do
			if Stats.ownsTool(session, tool.Id) then
				session.Data.EquippedTool = tool.Id
			end
		end
	end

	for _, container in { backpack, character } do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("DigToolId") then
				child:Destroy()
			end
		end
	end

	local tool = ToolFactory.create(session.Data.EquippedTool)
	tool.Parent = backpack
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(tool)
	end
end

---------------------------------------------------------------------
-- Prodej
---------------------------------------------------------------------

function ShopService.sell(player: Player, isAuto: boolean?): number
	local session = DataService.get(player)
	if not session then
		return 0
	end
	local data = session.Data
	if data.Sand <= 0 then
		return 0
	end
	local sand = data.Sand
	local coins = math.floor(sand * Config.Economy.CoinsPerSand * Stats.coinMultiplier(session))
	data.Sand = 0
	DataService.addCoins(player, coins)
	DataService.markDirty(player)
	Remotes.Sold:FireClient(player, coins, sand, isAuto == true)
	return coins
end

---------------------------------------------------------------------
-- Nákupy za mince
---------------------------------------------------------------------

local function buyItem(player: Player, category: string, id: string)
	local session = DataService.get(player)
	if not session or type(category) ~= "string" or type(id) ~= "string" then
		return false, "Not ready yet"
	end
	local data = session.Data

	if category == "Tool" then
		local tool = Config.ToolsById[id]
		if not tool then
			return false, "Unknown tool"
		end
		if tool.Pass then
			return false, "This tool comes with the " .. Config.GamePasses[tool.Pass].Name .. " gamepass"
		end
		if data.OwnedTools[id] then
			return false, "You already own this"
		end
		if data.Coins < tool.Price then
			return false, ("You need %s more coins"):format(Util.formatNumber(tool.Price - data.Coins))
		end
		data.Coins -= tool.Price
		data.OwnedTools[id] = true
		data.EquippedTool = id
		DataService.markDirty(player)
		ShopService.giveTool(player)
		return true, ("Bought %s!"):format(tool.Name)
	elseif category == "Backpack" then
		local backpack = Config.BackpacksById[id]
		if not backpack then
			return false, "Unknown backpack"
		end
		if data.OwnedBackpacks[id] then
			return false, "You already own this"
		end
		if data.Coins < backpack.Price then
			return false, ("You need %s more coins"):format(Util.formatNumber(backpack.Price - data.Coins))
		end
		data.Coins -= backpack.Price
		data.OwnedBackpacks[id] = true
		data.EquippedBackpack = id
		DataService.markDirty(player)
		return true, ("Bought %s!"):format(backpack.Name)
	end
	return false, "Unknown item"
end

local function equipItem(player: Player, category: string, id: string)
	local session = DataService.get(player)
	if not session or type(category) ~= "string" or type(id) ~= "string" then
		return false, "Not ready yet"
	end
	local data = session.Data

	if category == "Tool" then
		if not Stats.ownsTool(session, id) then
			return false, "You don't own this tool"
		end
		data.EquippedTool = id
		DataService.markDirty(player)
		ShopService.giveTool(player)
		return true, "Equipped " .. Config.ToolsById[id].Name
	elseif category == "Backpack" then
		if not data.OwnedBackpacks[id] or not Config.BackpacksById[id] then
			return false, "You don't own this backpack"
		end
		data.EquippedBackpack = id
		DataService.markDirty(player)
		return true, "Equipped " .. Config.BackpacksById[id].Name
	end
	return false, "Unknown item"
end

local function rebirth(player: Player)
	local session = DataService.get(player)
	if not session then
		return false, "Not ready yet"
	end
	local data = session.Data
	local cost = Stats.rebirthCost(data)
	if data.Coins < cost then
		return false, ("You need %s coins to rebirth"):format(Util.formatNumber(cost))
	end
	data.Rebirths += 1
	data.Coins = 0
	data.Sand = 0
	data.OwnedTools = { Hands = true }
	data.OwnedBackpacks = { Pocket = true }
	data.EquippedBackpack = "Pocket"
	-- Nasadíme nejlepší nástroj, který hráči zůstal (např. Golden Shovel z VIP)
	data.EquippedTool = "Hands"
	for _, tool in Config.Tools do
		if Stats.ownsTool(session, tool.Id) then
			data.EquippedTool = tool.Id
		end
	end
	DataService.markDirty(player)
	ShopService.giveTool(player)
	DataService.notifyAll(("♻️ %s reached Rebirth %d!"):format(player.DisplayName, data.Rebirths), "epic")
	return true,
		("Rebirth %d! Coins x%s forever"):format(
			data.Rebirths,
			string.format("%.1f", 1 + data.Rebirths * Config.Rebirth.MultiplierPerRebirth)
		)
end

local function redeemCode(player: Player, rawCode: string)
	local session = DataService.get(player)
	if not session or type(rawCode) ~= "string" or #rawCode > 40 then
		return false, "Invalid code"
	end
	local code = rawCode:upper():gsub("%s", "")
	local reward = Config.Codes[code]
	if not reward then
		return false, "Invalid code"
	end
	local data = session.Data
	if data.Codes[code] then
		return false, "Code already redeemed"
	end
	data.Codes[code] = true
	local coins = 0
	if reward.Coins then
		coins = reward.Coins * (data.Rebirths + 1)
		DataService.addCoins(player, coins)
	end
	DataService.markDirty(player)
	return true, ("Code redeemed! +%s coins"):format(Util.formatNumber(coins))
end

function ShopService.init()
	Remotes.BuyItem.OnServerInvoke = buyItem
	Remotes.EquipItem.OnServerInvoke = equipItem
	Remotes.Rebirth.OnServerInvoke = rebirth
	Remotes.RedeemCode.OnServerInvoke = redeemCode

	Remotes.TeleportCamp.OnServerEvent:Connect(function(player)
		local session = DataService.get(player)
		local character = player.Character
		if not session or not character then
			return
		end
		local now = os.clock()
		if now - session.LastCampTeleport < Config.CampTeleportCooldown then
			DataService.notify(
				player,
				("Wait %ds before teleporting again"):format(
					math.ceil(Config.CampTeleportCooldown - (now - session.LastCampTeleport))
				),
				"error"
			)
			return
		end
		session.LastCampTeleport = now
		WorldService.teleportToCamp(player)
	end)

	-- Výkupna písku (šlápnutí na zlatou plochu)
	local sellPad = WorldService.SellPad
	if sellPad then
		sellPad.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if not player then
				return
			end
			local session = DataService.get(player)
			if not session then
				return
			end
			local now = os.clock()
			if now - session.LastSellTouch < 0.75 then
				return
			end
			session.LastSellTouch = now
			ShopService.sell(player, false)
		end)
	end

	-- Prompty v táboře otevřou okna v UI
	local function addPrompt(part: BasePart?, actionText: string, window: string)
		if not part then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = actionText
		prompt.ObjectText = ""
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = part
		prompt.Triggered:Connect(function(player)
			Remotes.OpenWindow:FireClient(player, window)
		end)
	end
	local lobby = WorldService.Lobby or {}
	addPrompt(lobby.ToolCounter, "Tool Shop", "Shop")
	addPrompt(lobby.BackpackCounter, "Backpacks", "Shop:Backpack")
	addPrompt(lobby.RebirthAltar, "Rebirth", "Rebirth")
end

return ShopService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000012">
					<Properties>
						<string name="Name">Stats</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Stats – výpočty násobičů (mince, kapacita, rychlost, štěstí).
	Vše na jednom místě, ať se to snadno ladí.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Stats = {}

function Stats.artifactBonus(data): number
	local bonus = 0
	for artifactId, count in data.Artifacts do
		local artifact = Config.ArtifactsById[artifactId]
		if artifact and count > 0 then
			bonus += artifact.Bonus
		end
	end
	return bonus
end

function Stats.coinMultiplier(session): number
	local data = session.Data
	local multiplier = 1 + data.Rebirths * Config.Rebirth.MultiplierPerRebirth
	multiplier *= 1 + Stats.artifactBonus(data)
	if session.Passes.DoubleCoins then
		multiplier *= Config.PassEffects.DoubleCoins
	end
	if session.Passes.VIP then
		multiplier *= Config.VIP.CoinBonus
	end
	if session.InGroup then
		multiplier *= 1 + Config.Group.CoinBonus
	end
	return multiplier
end

function Stats.capacity(session): number
	local backpack = Config.BackpacksById[session.Data.EquippedBackpack] or Config.Backpacks[1]
	local capacity = backpack.Capacity
	if session.Passes.BigBackpack then
		capacity *= Config.PassEffects.BigBackpack
	end
	return math.floor(capacity)
end

function Stats.digSpeed(session): number
	if session.Passes.FastDig then
		return Config.PassEffects.FastDig
	end
	return 1
end

function Stats.serverLuck(): number
	local luckUntil = workspace:GetAttribute("ServerLuckUntil") or 0
	if os.time() < luckUntil then
		return 2
	end
	return 1
end

function Stats.rebirthCost(data): number
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ data.Rebirths)
end

function Stats.ownsTool(session, toolId: string): boolean
	local tool = Config.ToolsById[toolId]
	if not tool then
		return false
	end
	if tool.Pass then
		return session.Passes[tool.Pass] == true
	end
	return session.Data.OwnedTools[toolId] == true
end

return Stats
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000013">
					<Properties>
						<string name="Name">TreasureService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	TreasureService – zakopané truhly, artefakty a relikvie v ruinách.

	Truhly jsou zakopané v písku. Když hráč odkope písek nad truhlou,
	truhla se "odkryje" (rozzáří se) a jde otevřít (ProximityPrompt).
	Hlubší truhly mají větší šanci na vzácnost.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local Stats = require(script.Parent.Stats)
local WorldService = require(script.Parent.WorldService)

local T = Config.Treasure
local W = Config.World

local TreasureService = {}

local rng = Random.new()
local folder: Folder? = nil
local chests = {} -- [Model] = info

---------------------------------------------------------------------
-- Model truhly
---------------------------------------------------------------------

local function chestPart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function buildChest(rarityName: string, cframe: CFrame, isRelic: boolean)
	local rarity = Config.Rarities[rarityName]
	local model = Instance.new("Model")
	model.Name = rarityName .. "Chest"

	local scale = if isRelic then 1.6 else 1
	local bodyColor = rarity.Color
	local material = if rarity.Order >= 4
		then Enum.Material.Metal
		elseif rarity.Order == 1 then Enum.Material.WoodPlanks
		else Enum.Material.SmoothPlastic
	local gold = Color3.fromRGB(255, 205, 70)

	local base = chestPart(model, "Base", Vector3.new(3, 1.8, 2) * scale, cframe, bodyColor, material)
	local hinge = cframe * CFrame.new(0, 1.6 * scale, 1 * scale)
	local lidOffset = CFrame.new(0, -0.35 * scale, -1 * scale)
	local lid = chestPart(
		model,
		"Lid",
		Vector3.new(3, 0.7, 2) * scale,
		hinge * lidOffset,
		bodyColor:Lerp(Color3.new(1, 1, 1), 0.12),
		material
	)
	chestPart(
		model,
		"Trim",
		Vector3.new(3.1, 0.25, 2.1) * scale,
		cframe * CFrame.new(0, 0.9 * scale, 0),
		gold,
		Enum.Material.Metal
	)
	local lock = chestPart(
		model,
		"Lock",
		Vector3.new(0.5, 0.6, 0.2) * scale,
		cframe * CFrame.new(0, 0.9 * scale, -1.05 * scale),
		gold,
		Enum.Material.Neon
	)
	lock.CanCollide = false

	model.PrimaryPart = base

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = (if isRelic then "Ancient Relic" else rarityName .. " Chest")
	prompt.HoldDuration = if isRelic then 1.5 else 0.4
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = base

	model:SetAttribute("Rarity", rarityName)
	model:SetAttribute("Exposed", false)
	model:SetAttribute("IsRelic", isRelic)

	return model, prompt, lid, hinge, lidOffset
end

---------------------------------------------------------------------
-- Rarita
---------------------------------------------------------------------

local function rollRarity(depthFactor: number): string
	local luck = Stats.serverLuck()
	local weights = {}
	local total = 0
	for _, name in Config.RarityOrder do
		local rarity = Config.Rarities[name]
		local weight = rarity.Weight
		if weight > 0 and rarity.Order > 1 then
			weight *= luck * (1 + depthFactor * T.DepthLuck)
		end
		weights[name] = weight
		total += weight
	end
	local roll = rng:NextNumber() * total
	for _, name in Config.RarityOrder do
		roll -= weights[name]
		if roll <= 0 and weights[name] > 0 then
			return name
		end
	end
	return "Common"
end

local function rollArtifact(rarityName: string): string?
	-- Vybere artefakt dané rarity (nebo nižší, když žádný není)
	local order = Config.Rarities[rarityName].Order
	for o = order, 1, -1 do
		local pool = {}
		for _, artifact in Config.Artifacts do
			if Config.Rarities[artifact.Rarity].Order == o then
				table.insert(pool, artifact.Id)
			end
		end
		if #pool > 0 then
			return pool[rng:NextInteger(1, #pool)]
		end
	end
	return nil
end

---------------------------------------------------------------------
-- Odkrytí a otevření
---------------------------------------------------------------------

local function expose(model: Model, info, finder: Player?)
	if info.Exposed then
		return
	end
	info.Exposed = true
	model:SetAttribute("Exposed", true)
	info.Prompt.Enabled = true

	local rarity = Config.Rarities[info.Rarity]
	local base = model.PrimaryPart :: BasePart

	local light = Instance.new("PointLight")
	light.Color = rarity.Color
	light.Range = 12
	light.Brightness = 2
	light.Parent = base

	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(rarity.Color)
	sparkle.LightEmission = 1
	sparkle.Rate = 6 + rarity.Order * 4
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	sparkle.Speed = NumberRange.new(2, 5)
	sparkle.Size = NumberSequence.new(0.5)
	sparkle.Parent = base

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(7, 1.6)
	billboard.StudsOffset = Vector3.new(0, 3.2, 0)
	billboard.MaxDistance = 120
	billboard.LightInfluence = 0
	billboard.Parent = base
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = if info.IsRelic then "✨ ANCIENT RELIC ✨" else string.upper(info.Rarity)
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = rarity.Color
	label.Parent = billboard
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(40, 25, 10)
	stroke.Parent = label

	if info.IsRelic then
		DataService.notifyAll(
			("🏛️ %s uncovered the LOST RUINS! An Ancient Relic awaits..."):format(
				if finder then finder.DisplayName else "Someone"
			),
			"epic"
		)
	elseif finder and rarity.Order >= 2 then
		DataService.notify(
			finder,
			("You uncovered a %s chest!"):format(string.upper(info.Rarity)),
			"rarity:" .. info.Rarity
		)
	end
end

local function openChest(model: Model, info, player: Player)
	if info.Opened or not info.Exposed then
		return
	end
	local session = DataService.get(player)
	if not session then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - (model.PrimaryPart :: BasePart).Position).Magnitude > 16 then
		return
	end

	info.Opened = true
	info.Prompt.Enabled = false

	local data = session.Data
	local rarity = Config.Rarities[info.Rarity]
	local tool = Config.ToolsById[data.EquippedTool]
	local toolTier = if tool then tool.Index else 1
	local coins = rarity.Coins * (1 + (toolTier - 1) * T.ToolTierBonus) * Stats.coinMultiplier(session)
	if session.Passes.TreasureRadar then
		coins *= Config.PassEffects.TreasureRadarCoins
	end

	local artifactId = nil
	local isNew = false
	if rng:NextNumber() <= rarity.ArtifactChance then
		artifactId = rollArtifact(info.Rarity)
		if artifactId then
			local count = data.Artifacts[artifactId] or 0
			isNew = count == 0
			data.Artifacts[artifactId] = count + 1
			if not isNew then
				-- duplikát = bonusové mince
				coins += rarity.Coins * 2 * Stats.coinMultiplier(session)
			end
		end
	end

	coins = math.floor(coins)
	DataService.addCoins(player, coins)
	data.ChestsOpened += 1
	DataService.markDirty(player)

	local position = (model.PrimaryPart :: BasePart).Position
	Remotes.ChestOpened:FireClient(player, info.Rarity, coins, artifactId, isNew, position)

	if info.IsRelic or rarity.Order >= 4 then
		local artifact = artifactId and Config.ArtifactsById[artifactId]
		local suffix = if artifact then (" and found %s %s!"):format(artifact.Icon, artifact.Name) else "!"
		DataService.notifyAll(
			("%s opened a %s chest%s (+%s coins)"):format(
				player.DisplayName,
				string.upper(info.Rarity),
				suffix,
				Util.formatNumber(coins)
			),
			"rarity:" .. info.Rarity
		)
	end

	-- Animace otevření víka, pak zmizí
	local openCFrame = info.Hinge * CFrame.Angles(math.rad(75), 0, 0) * info.LidOffset
	TweenService
		:Create(info.Lid, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = openCFrame })
		:Play()
	task.delay(4, function()
		chests[model] = nil
		model:Destroy()
	end)
end

---------------------------------------------------------------------
-- Spawnování
---------------------------------------------------------------------

local function spawnChest(position: Vector3, rarityName: string, isRelic: boolean, surfaceY: number)
	local cframe = CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local model, prompt, lid, hinge, lidOffset = buildChest(rarityName, cframe, isRelic)
	local info = {
		Rarity = rarityName,
		IsRelic = isRelic,
		Exposed = false,
		Opened = false,
		Prompt = prompt,
		Lid = lid,
		Hinge = hinge,
		LidOffset = lidOffset,
		Top = position + Vector3.new(0, if isRelic then 1.8 else 1.2, 0),
		SurfaceY = surfaceY,
	}
	chests[model] = info
	prompt.Triggered:Connect(function(player)
		openChest(model, info, player)
	end)
	model.Parent = folder
	return model
end

local function randomDesertPoint(): (number, number)
	local half = W.Size / 2 - 10
	local campZone = W.CampHalf + 14
	for _ = 1, 30 do
		local x = rng:NextNumber(-half, half)
		local z = rng:NextNumber(-half, half)
		if math.max(math.abs(x), math.abs(z)) > campZone then
			return x, z
		end
	end
	return half * 0.8, half * 0.8
end

-- useHeightmap = true při generování světa (rychlejší, terén je čerstvý)
local function spawnRandomChest(useHeightmap: boolean): boolean
	for _ = 1, 10 do
		local x, z = randomDesertPoint()
		local surface = if useHeightmap then WorldService.heightAt(x, z) else WorldService.surfaceHeight(x, z)
		if surface >= 8 then
			local y = rng:NextNumber(2, surface - 4)
			local depthFactor = math.clamp(1 - y / 40, 0, 1)
			local rarity = rollRarity(depthFactor)
			spawnChest(Vector3.new(x, y, z), rarity, false, surface)
			return true
		end
	end
	return false
end

local function countChests(): number
	local count = 0
	for _, info in chests do
		if not info.Opened then
			count += 1
		end
	end
	return count
end

---------------------------------------------------------------------
-- Veřejné API
---------------------------------------------------------------------

-- Volá DigService po každém kopnutí
function TreasureService.onDig(player: Player, position: Vector3, radius: number)
	for model, info in chests do
		if not info.Exposed and not info.Opened then
			if (info.Top - position).Magnitude <= radius + 8 then
				if WorldService.coverAt(info.Top) <= T.ExposeThreshold then
					expose(model, info, player)
				end
			end
		end
	end
end

function TreasureService.clearAll()
	for model in chests do
		model:Destroy()
	end
	table.clear(chests)
end

function TreasureService.populate()
	TreasureService.clearAll()

	-- Relikvie v ruinách + pár vzácných truhel kolem
	local ruinsCenter, relicCFrame = WorldService.getRuins()
	if ruinsCenter and relicCFrame then
		spawnChest(relicCFrame.Position, "Mythic", true, W.RuinsBuryHeight)
		for _, degrees in { 30, 150, 270 } do
			local angle = math.rad(degrees) + rng:NextNumber(-0.2, 0.2)
			local offset = Vector3.new(math.cos(angle) * 9, 2, math.sin(angle) * 9)
			local rarity = if rng:NextNumber() < 0.35 then "Legendary" else "Epic"
			spawnChest(ruinsCenter + offset, rarity, false, W.RuinsBuryHeight)
		end
	end

	for _ = 1, T.StartChests do
		spawnRandomChest(true)
	end
end

function TreasureService.init()
	local treasureFolder = Instance.new("Folder")
	treasureFolder.Name = "Treasures"
	treasureFolder.Parent = workspace
	folder = treasureFolder

	-- Doplňování truhel
	task.spawn(function()
		while true do
			task.wait(T.RespawnInterval)
			if WorldService.isReady() and countChests() < T.MaxChests then
				spawnRandomChest(false)
			end
		end
	end)
end

return TreasureService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000014">
					<Properties>
						<string name="Name">WorldService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	WorldService – generuje poušť, tábor, ruiny a řeší kopání do terénu.

	Poušť je z Roblox Terrain (materiál Sand). Kopání = Terrain:FillBall(..., Air).
	Množství vykopaného písku se počítá přesně přes ReadVoxels (před/po).
	Pod pískem je skalní dno (Part) – to vykopat nejde.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Build = require(script.Parent.Build)
local LobbyBuilder = require(script.Parent.LobbyBuilder)

local W = Config.World
local Terrain = workspace.Terrain
local SAND = Enum.Material.Sand
local AIR = Enum.Material.Air
local VOXEL = 4
local CHUNK = 64
local THIN_SAND = 0.3 -- voxely s menším zaplněním po kopání mažeme (průsvitné slupky)

local WorldService = {}

local rng = Random.new()
local seed = 0
local ready = false
local totalSand = 0
local remainingSand = 0
local ruinsCenter: Vector3? = nil
local relicCFrame: CFrame? = nil
local ruinsModel: Model? = nil
local mapFolder: Folder? = nil
local spawnCFrames = { CFrame.new(0, W.CampTop + 4, 20) }
local maxY = math.ceil(W.MaxSand / VOXEL) * VOXEL

WorldService.Lobby = nil :: any -- kotvy z LobbyBuilderu (prodej, obchody, žebříčky...)
WorldService.SellPad = nil :: BasePart?

---------------------------------------------------------------------
-- Pomocné funkce
---------------------------------------------------------------------

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local makePart = Build.part
local cylinder = Build.cylinder

---------------------------------------------------------------------
-- Výšková mapa pouště
---------------------------------------------------------------------

local function rawHeight(x: number, z: number): number
	local s = W.DuneScale
	local n1 = math.noise(x / s, z / s, seed)
	local n2 = math.noise(x / (s * 0.45), z / (s * 0.45), seed + 17.31)
	local n3 = math.noise(x / (s * 0.16), z / (s * 0.16), seed + 41.77)
	local ridge = 1 - math.abs(n2) * 2.2
	return W.BaseSandHeight + n1 * W.DuneHeight * 1.4 + ridge * W.DuneHeight * 0.35 + n3 * 2.5
end

function WorldService.heightAt(x: number, z: number): number
	local h = rawHeight(x, z)

	-- Kopec nad ruinami (aby byly celé zasypané)
	if ruinsCenter then
		local d = Vector2.new(x - ruinsCenter.X, z - ruinsCenter.Z).Magnitude
		local blend = smoothstep((d - W.RuinsRadius) / 30)
		h = math.max(h, lerp(W.RuinsBuryHeight, h, blend))
	end

	-- Kolem tábora je písek zarovnaný s táborem
	local campDistance = math.max(math.abs(x), math.abs(z)) - W.CampHalf
	if campDistance < 48 then
		h = lerp(W.CampTop - 1, h, smoothstep(campDistance / 48))
	end

	return math.clamp(h, W.MinSand, W.MaxSand)
end

---------------------------------------------------------------------
-- Generování terénu
---------------------------------------------------------------------

local function generateTerrain()
	local half = W.Size / 2
	local nx, ny, nz = CHUNK / VOXEL, maxY / VOXEL, CHUNK / VOXEL
	local sum = 0

	for cx = -half, half - CHUNK, CHUNK do
		for cz = -half, half - CHUNK, CHUNK do
			local region = Region3.new(Vector3.new(cx, 0, cz), Vector3.new(cx + CHUNK, maxY, cz + CHUNK))
			local materials = table.create(nx)
			local occupancy = table.create(nx)

			for ix = 1, nx do
				local matX = table.create(ny)
				local occX = table.create(ny)
				for iy = 1, ny do
					matX[iy] = table.create(nz)
					occX[iy] = table.create(nz)
				end

				local wx = cx + (ix - 0.5) * VOXEL
				for iz = 1, nz do
					local wz = cz + (iz - 0.5) * VOXEL
					local h = WorldService.heightAt(wx, wz)
					-- Uvnitř skalního tábora žádný písek (byl by schovaný a nešel by "vidět")
					if math.max(math.abs(wx), math.abs(wz)) < W.CampHalf then
						h = 0
					end
					for iy = 1, ny do
						local bottom = (iy - 1) * VOXEL
						local occ = math.clamp((h - bottom) / VOXEL, 0, 1)
						if occ > 0.02 then
							matX[iy][iz] = SAND
							occX[iy][iz] = occ
							sum += occ
						else
							matX[iy][iz] = AIR
							occX[iy][iz] = 0
						end
					end
				end

				materials[ix] = matX
				occupancy[ix] = occX
			end

			Terrain:WriteVoxels(region, VOXEL, materials, occupancy)
			task.wait()
		end
	end

	totalSand = sum * Config.SandPerVoxel
	remainingSand = totalSand
end

---------------------------------------------------------------------
-- Statické části mapy: dno, okraje, tábor
---------------------------------------------------------------------

local function buildBoundaries(parent: Instance)
	local size = W.Size
	local half = size / 2
	local rockColor = Color3.fromRGB(196, 128, 82)

	makePart({
		Name = "Bedrock",
		Size = Vector3.new(size + 120, 4, size + 120),
		Position = Vector3.new(0, -2, 0),
		Material = Enum.Material.Sandstone,
		Color = Color3.fromRGB(205, 150, 98),
		Parent = parent,
	})

	-- Útesy kolem pouště
	local wallHeight = 110
	local walls = {
		{ Vector3.new(0, wallHeight / 2 - 4, -half - 20), Vector3.new(size + 120, wallHeight, 40) },
		{ Vector3.new(0, wallHeight / 2 - 4, half + 20), Vector3.new(size + 120, wallHeight, 40) },
		{ Vector3.new(-half - 20, wallHeight / 2 - 4, 0), Vector3.new(40, wallHeight, size + 120) },
		{ Vector3.new(half + 20, wallHeight / 2 - 4, 0), Vector3.new(40, wallHeight, size + 120) },
	}
	for i, wall in walls do
		makePart({
			Name = "Cliff" .. i,
			Size = wall[2],
			Position = wall[1],
			Material = Enum.Material.Sandstone,
			Color = rockColor,
			Parent = parent,
		})
	end

	-- Náhodné balvany na útesech (vypadá to přirozeněji)
	local boulderRng = Random.new(1234)
	for _ = 1, 70 do
		local side = boulderRng:NextInteger(1, 4)
		local along = boulderRng:NextNumber(-half, half)
		local out = half + boulderRng:NextNumber(-2, 10)
		local position
		if side == 1 then
			position = Vector3.new(along, 0, -out)
		elseif side == 2 then
			position = Vector3.new(along, 0, out)
		elseif side == 3 then
			position = Vector3.new(-out, 0, along)
		else
			position = Vector3.new(out, 0, along)
		end
		local s = boulderRng:NextNumber(14, 36)
		position += Vector3.new(0, wallHeight - 4 - boulderRng:NextNumber(0, 30), 0)
		makePart({
			Name = "Boulder",
			Size = Vector3.new(s, s * boulderRng:NextNumber(0.6, 1.2), s * boulderRng:NextNumber(0.7, 1.3)),
			CFrame = CFrame.new(position) * CFrame.Angles(
				boulderRng:NextNumber(-0.4, 0.4),
				boulderRng:NextNumber(0, 6.28),
				boulderRng:NextNumber(-0.4, 0.4)
			),
			Material = Enum.Material.Sandstone,
			Color = rockColor:Lerp(Color3.fromRGB(150, 95, 60), boulderRng:NextNumber(0, 0.6)),
			Parent = parent,
		})
	end
end

---------------------------------------------------------------------
-- Zasypané ruiny
---------------------------------------------------------------------

local function buildRuins(parent: Instance, center: Vector3)
	if ruinsModel then
		ruinsModel:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "LostRuins"
	local stone = Color3.fromRGB(214, 180, 130)
	local darkStone = Color3.fromRGB(170, 130, 90)
	local r = W.RuinsRadius

	makePart({
		Name = "Floor",
		Size = Vector3.new(r * 2, 1, r * 2),
		Position = center + Vector3.new(0, 0.5, 0),
		Material = Enum.Material.Limestone,
		Color = darkStone,
		Parent = model,
	})

	-- Kruh sloupů (některé jsou rozbité)
	local pillarCount = 10
	local ringRadius = r - 4
	local pillarTops = {}
	for i = 1, pillarCount do
		local angle = (i / pillarCount) * math.pi * 2
		local broken = rng:NextNumber() < 0.3
		local height = if broken then rng:NextNumber(5, 10) else 16
		local base = center + Vector3.new(math.cos(angle) * ringRadius, 1, math.sin(angle) * ringRadius)
		cylinder({
			Name = "Pillar",
			Height = height,
			Diameter = 3.2,
			Position = base + Vector3.new(0, height / 2, 0),
			Material = Enum.Material.Limestone,
			Color = stone,
			Parent = model,
		})
		makePart({
			Name = "PillarCap",
			Size = Vector3.new(4.2, 1, 4.2),
			Position = base + Vector3.new(0, height + 0.5, 0),
			Material = Enum.Material.Limestone,
			Color = darkStone,
			Parent = model,
		})
		pillarTops[i] = if broken then nil else base + Vector3.new(0, height + 1.5, 0)
	end

	-- Trámy mezi celými sloupy
	for i = 1, pillarCount do
		local a = pillarTops[i]
		local b = pillarTops[(i % pillarCount) + 1]
		if a and b then
			local mid = (a + b) / 2
			makePart({
				Name = "Lintel",
				Size = Vector3.new(2.5, 1.6, (a - b).Magnitude + 3),
				CFrame = CFrame.lookAt(mid, b),
				Material = Enum.Material.Limestone,
				Color = stone,
				Parent = model,
			})
		end
	end

	-- Oltář uprostřed se zářícími runami
	makePart({
		Name = "AltarStep",
		Size = Vector3.new(12, 1.5, 12),
		Position = center + Vector3.new(0, 1.75, 0),
		Material = Enum.Material.Limestone,
		Color = darkStone,
		Parent = model,
	})
	local altar = makePart({
		Name = "Altar",
		Size = Vector3.new(7, 3, 7),
		Position = center + Vector3.new(0, 4, 0),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(235, 210, 160),
		Parent = model,
	})
	for _, offset in
		{ Vector3.new(0, 0, -3.55), Vector3.new(0, 0, 3.55), Vector3.new(-3.55, 0, 0), Vector3.new(3.55, 0, 0) }
	do
		local isX = offset.X ~= 0
		makePart({
			Name = "Rune",
			Size = if isX then Vector3.new(0.2, 0.6, 5) else Vector3.new(5, 0.6, 0.2),
			Position = altar.Position + offset,
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(80, 220, 255),
			CanCollide = false,
			Parent = model,
		})
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(80, 220, 255)
	glow.Range = 20
	glow.Brightness = 2
	glow.Parent = altar

	-- Velká hlava sochy napůl zasypaná vedle oltáře
	local head = makePart({
		Name = "StatueHead",
		Size = Vector3.new(7, 8, 7),
		Position = center + Vector3.new(-9, 5, -9),
		Material = Enum.Material.Limestone,
		Color = stone,
		Parent = model,
	})
	makePart({
		Name = "StatueHeaddress",
		Size = Vector3.new(9, 3, 8),
		Position = head.Position + Vector3.new(0, 4.5, 0.5),
		Material = Enum.Material.Limestone,
		Color = Color3.fromRGB(60, 120, 200),
		Parent = model,
	})
	for _, x in { -1.6, 1.6 } do
		makePart({
			Name = "Eye",
			Size = Vector3.new(1.2, 0.6, 0.3),
			Position = head.Position + Vector3.new(x, 1, -3.6),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 200, 60),
			CanCollide = false,
			Parent = model,
		})
	end

	model.Parent = parent
	ruinsModel = model
	relicCFrame = CFrame.new(altar.Position + Vector3.new(0, 3, 0))
end

---------------------------------------------------------------------
-- Osvětlení – teplá pouštní atmosféra
---------------------------------------------------------------------

function WorldService.setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(110, 90, 70)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 128, 105)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = 0.1

	for _, child in Lighting:GetChildren() do
		if
			child:IsA("Atmosphere")
			or child:IsA("Sky")
			or child:IsA("ColorCorrectionEffect")
			or child:IsA("SunRaysEffect")
			or child:IsA("BloomEffect")
		then
			child:Destroy()
		end
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.25
	atmosphere.Color = Color3.fromRGB(232, 205, 165)
	atmosphere.Decay = Color3.fromRGB(205, 150, 100)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 16
	sky.Parent = Lighting

	local colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Saturation = 0.15
	colorCorrection.Contrast = 0.08
	colorCorrection.TintColor = Color3.fromRGB(255, 246, 232)
	colorCorrection.Parent = Lighting

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Intensity = 0.06
	sunRays.Spread = 0.6
	sunRays.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.4
	bloom.Size = 24
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	Terrain:SetMaterialColor(SAND, Color3.fromRGB(228, 192, 130))
end

---------------------------------------------------------------------
-- Veřejné API
---------------------------------------------------------------------

function WorldService.isReady(): boolean
	return ready
end

function WorldService.setReady(value: boolean)
	ready = value
	workspace:SetAttribute("WorldReady", value)
end

function WorldService.getSpawnCFrame(): CFrame
	local base = spawnCFrames[rng:NextInteger(1, #spawnCFrames)]
	return base + Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
end

-- Je bod uvnitř lobby (tam se kopat nesmí)?
function WorldService.isInLobby(position: Vector3): boolean
	return math.max(math.abs(position.X), math.abs(position.Z)) < W.CampHalf + 1 and position.Y > W.CampTop - 8
end

-- Bezpečný teleport do tábora (při zapnutém StreamingEnabled nejdřív načte okolí)
function WorldService.teleportToCamp(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local target = WorldService.getSpawnCFrame()
	pcall(function()
		player:RequestStreamAroundAsync(target.Position, 5)
	end)
	if player.Character == character then
		character:PivotTo(target)
	end
end

function WorldService.getRuins(): (Vector3?, CFrame?)
	return ruinsCenter, relicCFrame
end

function WorldService.getMapFolder(): Folder
	return mapFolder :: Folder
end

function WorldService.getClearedFraction(): number
	if totalSand <= 0 then
		return 0
	end
	return math.clamp(1 - remainingSand / totalSand, 0, 1)
end

function WorldService.inBounds(position: Vector3): boolean
	local half = W.Size / 2
	return math.abs(position.X) <= half
		and math.abs(position.Z) <= half
		and position.Y >= -4
		and position.Y <= maxY + 20
end

-- Aktuální výška povrchu (raycast jen do terénu)
local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.FilterDescendantsInstances = { Terrain }

function WorldService.surfaceHeight(x: number, z: number): number
	local result = workspace:Raycast(Vector3.new(x, maxY + 50, z), Vector3.new(0, -(maxY + 60), 0), terrainParams)
	if result then
		return result.Position.Y
	end
	return 0
end

local function sumSand(region: Region3): number
	local materials, occupancies = Terrain:ReadVoxels(region, VOXEL)
	local size = materials.Size
	local total = 0
	for x = 1, size.X do
		local matX, occX = materials[x], occupancies[x]
		for y = 1, size.Y do
			local matY, occY = matX[y], occX[y]
			for z = 1, size.Z do
				if matY[z] == SAND then
					total += occY[z]
				end
			end
		end
	end
	return total
end

-- Vykope kouli písku. Vrací množství písku (už přepočtené přes SandPerVoxel).
-- Po vykopání se "uhladí" tenké zbytky písku: smooth terrain z nich jinak dělá
-- průsvitné slupky a díry, přes které jde vidět.
function WorldService.digSphere(center: Vector3, radius: number): number
	local padding = Vector3.one * (radius + VOXEL)
	local region = Region3.new(center - padding, center + padding):ExpandToGrid(VOXEL)
	local before = sumSand(region)
	if before <= 0 then
		return 0
	end
	Terrain:FillBall(center, radius, AIR)

	local materials, occupancies = Terrain:ReadVoxels(region, VOXEL)
	local size = materials.Size
	local minCorner = region.CFrame.Position - region.Size / 2
	local snapRadius = radius + VOXEL
	local after = 0
	local changed = false
	for x = 1, size.X do
		local matX, occX = materials[x], occupancies[x]
		local wx = minCorner.X + (x - 0.5) * VOXEL
		for y = 1, size.Y do
			local matY, occY = matX[y], occX[y]
			local wy = minCorner.Y + (y - 0.5) * VOXEL
			for z = 1, size.Z do
				if matY[z] == SAND then
					local occ = occY[z]
					if occ < THIN_SAND then
						local wz = minCorner.Z + (z - 0.5) * VOXEL
						if (Vector3.new(wx, wy, wz) - center).Magnitude <= snapRadius then
							matY[z] = AIR
							occY[z] = 0
							occ = 0
							changed = true
						end
					end
					after += occ
				end
			end
		end
	end
	if changed then
		Terrain:WriteVoxels(region, VOXEL, materials, occupancies)
	end

	local removed = math.max(0, before - after) * Config.SandPerVoxel
	remainingSand = math.max(0, remainingSand - removed)
	return removed
end

-- Kolik písku je nad daným bodem (0 = odkryté, 1 = plně zasypané)
function WorldService.coverAt(position: Vector3): number
	local min = position + Vector3.new(-3, 0.5, -3)
	local max = position + Vector3.new(3, 6, 3)
	local region = Region3.new(min, max):ExpandToGrid(VOXEL)
	local materials, occupancies = Terrain:ReadVoxels(region, VOXEL)
	local size = materials.Size
	local total, count = 0, 0
	for x = 1, size.X do
		for y = 1, size.Y do
			for z = 1, size.Z do
				count += 1
				if materials[x][y][z] == SAND then
					total += occupancies[x][y][z]
				end
			end
		end
	end
	if count == 0 then
		return 0
	end
	return total / count
end

local function pickRuinsCenter()
	local angle = rng:NextNumber(0, math.pi * 2)
	local distance = rng:NextNumber(W.RuinsMinDistance, W.RuinsMaxDistance)
	local maxDistance = W.Size / 2 - W.RuinsRadius - 12
	distance = math.min(distance, maxDistance)
	return Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
end

-- (Znovu)vygeneruje poušť a ruiny
function WorldService.regenerate()
	seed = rng:NextNumber(1, 10000)
	ruinsCenter = pickRuinsCenter()
	buildRuins(mapFolder :: Folder, ruinsCenter :: Vector3)
	generateTerrain()
	LobbyBuilder.fillWater()
end

function WorldService.init()
	WorldService.setReady(false)
	WorldService.setupLighting()

	local folder = Instance.new("Folder")
	folder.Name = "Map"
	folder.Parent = workspace
	mapFolder = folder

	Terrain:Clear()
	buildBoundaries(folder)
	local lobby = LobbyBuilder.build(folder)
	WorldService.Lobby = lobby
	WorldService.SellPad = lobby.SellPad
	spawnCFrames = lobby.Spawns
	WorldService.regenerate()
end

return WorldService
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX00000025">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00000023">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX00000022">
				<Properties>
					<string name="Name">Client</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000018">
					<Properties>
						<string name="Name">Audio</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Audio – hudba, ambience a zvukové efekty.

	- Hudba se mění podle místa: menu/lobby = "Lobby", poušť = "Desert",
	  písečná bouře = "Storm" (plynulé prolínání).
	- Vítr hraje jen venku v poušti.
	- Efekty jsou v jednom souboru (Config.SfxPack), přehrávají se jeho části
	  (PlaybackRegion). Dokud není nahraný, použijí se vestavěné zvuky Robloxu.
	- Hlasitost hudby a efektů jde z nastavení hráče.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)

local Audio = {}

local musicGroup: SoundGroup
local sfxGroup: SoundGroup
local tracks = {} -- [name] = Sound
local ambience: Sound? = nil
local current: string? = nil
local inMenu = true
local musicVolume = 0.5
local sfxVolume = 0.8

-- Záložní vestavěné zvuky pro efekty, které v Config.Sounds nejsou
local FALLBACK = {
	Dig = "Dig",
	Dig2 = "Dig",
	Coin = "Sell",
	Sell = "Sell",
	Buy = "Sell",
	Click = "Click",
	Open = "Click",
	Error = "Click",
	Chest = "Chest",
	Rare = "Chest",
	Rebirth = "Chest",
	Storm = nil,
}

local function makeGroup(name: string, volume: number): SoundGroup
	local group = Instance.new("SoundGroup")
	group.Name = name
	group.Volume = volume
	group.Parent = SoundService
	return group
end

local function makeTrack(name: string, id: string, volume: number): Sound?
	if not id or id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = "Music_" .. name
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = 0
	sound:SetAttribute("TargetVolume", volume)
	sound.SoundGroup = musicGroup
	sound.Parent = SoundService
	return sound
end

function Audio.init()
	musicGroup = makeGroup("Music", musicVolume)
	sfxGroup = makeGroup("SFX", sfxVolume)
	local base = Config.Music.Volume or 0.5
	tracks.Lobby = makeTrack("Lobby", Config.Music.Lobby, base)
	tracks.Desert = makeTrack("Desert", Config.Music.Desert, base)
	tracks.Storm = makeTrack("Storm", Config.Music.Storm, base * 1.1)
	ambience = makeTrack("Ambience", Config.Music.Ambience, base * 0.8)
	if Config.Music.Lobby == "" then
		print("[Audio] Hudba zatím není nahraná – viz docs/NAVOD.md, sekce Hudba a zvuky.")
	end
end

function Audio.setVolumes(music: number, sfx: number)
	musicVolume = math.clamp(music, 0, 1)
	sfxVolume = math.clamp(sfx, 0, 1)
	if musicGroup then
		musicGroup.Volume = musicVolume
	end
	if sfxGroup then
		sfxGroup.Volume = sfxVolume
	end
end

local fadeInfo = TweenInfo.new(1.6, Enum.EasingStyle.Sine)

local function fadeTo(sound: Sound?, on: boolean)
	if not sound then
		return
	end
	if on and not sound.IsPlaying then
		sound:Play()
	end
	local target = if on then (sound:GetAttribute("TargetVolume") or 0.5) else 0
	local tween = TweenService:Create(sound, fadeInfo, { Volume = target })
	tween:Play()
	if not on then
		tween.Completed:Connect(function()
			if sound.Volume <= 0.01 then
				sound:Pause()
			end
		end)
	end
end

function Audio.setMusic(name: string?)
	if name == current then
		return
	end
	current = name
	for trackName, sound in tracks do
		fadeTo(sound, trackName == name)
	end
end

function Audio.setMenu(value: boolean)
	inMenu = value
	Audio.refresh()
end

-- Vybere hudbu podle pozice hráče a stavu bouře (volá se pravidelně)
function Audio.refresh()
	local phase = workspace:GetAttribute("StormPhase") or "Calm"
	local inLobby = true
	local player = Players.LocalPlayer
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local p = root.Position
		inLobby = math.max(math.abs(p.X), math.abs(p.Z)) < Config.World.CampHalf + 6 and p.Y > Config.World.CampTop - 6
	end
	local storm = phase == "Warning" or phase == "Active"
	local track = if inMenu or (inLobby and not storm) then "Lobby" elseif storm then "Storm" else "Desert"
	Audio.setMusic(track)
	fadeTo(ambience, not inMenu and not inLobby)
end

-- Zvukový efekt (name = klíč z Config.SfxRegions)
function Audio.sfx(name: string, volume: number?, pitch: number?)
	if sfxVolume <= 0 then
		return
	end
	local sound = Instance.new("Sound")
	local region = Config.SfxRegions[name]
	if Config.SfxPack ~= "" and region then
		sound.SoundId = Config.SfxPack
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(region[1], region[2])
		sound.Volume = volume or 0.7
	else
		local key = FALLBACK[name]
		local id = key and Config.Sounds[key]
		if not id or id == "" then
			sound:Destroy()
			return
		end
		sound.SoundId = id
		sound.Volume = (volume or 0.7) * 0.6
	end
	sound.PlaybackSpeed = pitch or 1
	sound.SoundGroup = sfxGroup
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 4)
end

return Audio
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000019">
					<Properties>
						<string name="Name">DigController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DigController – ovládání kopání.
	Drž myš / prst (nebo tlačítko na ovladači) s nástrojem v ruce = kopeš.
	Kope se tam, kam míříš. Když míříš moc daleko, kope se před tebou.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DigController = {}

local player = Players.LocalPlayer
local state = nil
local currentTool: Tool? = nil
local digToken = nil
local lastFire = 0
local pointerKind = "Mouse"
local lastTouchPosition: Vector3? = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function updateFilter()
	local ignore = {}
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local effects = workspace:FindFirstChild("ClientEffects")
	if effects then
		table.insert(ignore, effects)
	end
	rayParams.FilterDescendantsInstances = ignore
end

local function getTarget(reach: number): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	if not root or not camera then
		return nil
	end
	updateFilter()

	local ray
	if pointerKind == "Touch" and lastTouchPosition then
		ray = camera:ScreenPointToRay(lastTouchPosition.X, lastTouchPosition.Y)
	elseif pointerKind == "Gamepad" then
		local viewport = camera.ViewportSize
		ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	else
		local mouse = UserInputService:GetMouseLocation()
		ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	end

	local result = workspace:Raycast(ray.Origin, ray.Direction * 400, rayParams)
	if result and (result.Position - root.Position).Magnitude <= reach then
		return result.Position
	end

	-- Záložní cíl: zem kousek před postavou
	local forward = root.CFrame.LookVector * math.min(4, reach * 0.4)
	local origin = root.Position + forward + Vector3.new(0, 2, 0)
	local down = workspace:Raycast(origin, Vector3.new(0, -14, 0), rayParams)
	if down then
		return down.Position
	end
	return nil
end

local function swing(tool: Tool, toolConfig)
	if not toolConfig.Swing then
		return
	end
	-- Výchozí Animate skript přehraje "sek" nástrojem, když najde tento StringValue
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
end

local function startDigging(tool: Tool)
	local token = {}
	digToken = token
	task.spawn(function()
		while digToken == token and tool.Parent == player.Character do
			local toolConfig = Config.ToolsById[tool:GetAttribute("DigToolId")]
			if not toolConfig then
				break
			end
			local speed = if state and state.DigSpeed then state.DigSpeed else 1
			local cooldown = toolConfig.Cooldown / speed
			local waitLeft = lastFire + cooldown - os.clock()
			if waitLeft > 0 then
				task.wait(waitLeft)
				if digToken ~= token then
					break
				end
			end
			local target = getTarget(toolConfig.Reach)
			if target then
				lastFire = os.clock()
				Remotes.Dig:FireServer(target)
				swing(tool, toolConfig)
				task.wait(cooldown)
			else
				task.wait(0.1)
			end
		end
	end)
end

local function stopDigging()
	digToken = nil
end

local watchedTools = setmetatable({}, { __mode = "k" })

local function watchTool(tool: Tool)
	if not tool:GetAttribute("DigToolId") then
		return
	end
	currentTool = tool
	if watchedTools[tool] then
		return
	end
	watchedTools[tool] = true
	tool.Activated:Connect(function()
		startDigging(tool)
	end)
	tool.Deactivated:Connect(stopDigging)
	tool.Unequipped:Connect(stopDigging)
end

local function onCharacter(character: Model)
	stopDigging()
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			watchTool(child)
		end
	end)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			watchTool(child)
		end
	end
end

function DigController.setState(newState)
	state = newState
end

function DigController.getTool(): Tool?
	return currentTool
end

function DigController.init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.Touch then
			pointerKind = "Touch"
			-- dotyky joysticku/tlačítek ignorujeme, chceme jen "tap do světa"
			if not gameProcessed then
				lastTouchPosition = input.Position
			end
		elseif
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseMovement
		then
			pointerKind = "Mouse"
		elseif input.UserInputType.Name:find("Gamepad") then
			pointerKind = "Gamepad"
		end
	end)
	UserInputService.InputChanged:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.Touch then
			if not gameProcessed then
				lastTouchPosition = input.Position
			end
		elseif input.UserInputType == Enum.UserInputType.MouseMovement then
			pointerKind = "Mouse"
		end
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end
end

return DigController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000001A">
					<Properties>
						<string name="Name">Effects</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Effects – vizuální efekty na klientovi: prach při kopání, vyskakující čísla,
	písečná bouře, zvuky.
]]

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Effects = {}

local SAND_COLOR = Color3.fromRGB(230, 196, 135)
local effectsFolder = Instance.new("Folder")
effectsFolder.Name = "ClientEffects"
effectsFolder.Parent = workspace

local function anchorPart(position: Vector3): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Position = position
	part.Parent = effectsFolder
	return part
end

-- Nastavení z menu Settings
Effects.lowGraphics = false
Effects.popups = true

-- Zatřesení kamerou (přes Humanoid.CameraOffset)
function Effects.shake(intensity: number, duration: number)
	if Effects.lowGraphics then
		return
	end
	local character = game:GetService("Players").LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	task.spawn(function()
		local started = os.clock()
		while os.clock() - started < duration do
			local fade = 1 - (os.clock() - started) / duration
			humanoid.CameraOffset = Vector3.new(
				(math.random() - 0.5) * intensity * fade,
				(math.random() - 0.5) * intensity * fade,
				(math.random() - 0.5) * intensity * fade
			)
			task.wait()
		end
		humanoid.CameraOffset = Vector3.zero
	end)
end

-- Oblak písku při kopání
function Effects.digBurst(position: Vector3, strength: number)
	if Effects.lowGraphics then
		return
	end
	local part = anchorPart(position)
	local size = math.clamp(strength, 0.6, 4)

	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(SAND_COLOR)
	dust.Size =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8 * size), NumberSequenceKeypoint.new(1, 2.2 * size) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(0.5, 0.9)
	dust.Speed = NumberRange.new(4, 10)
	dust.SpreadAngle = Vector2.new(70, 70)
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Acceleration = Vector3.new(0, -12, 0)
	dust.Drag = 3
	dust.Rate = 0
	dust.LightInfluence = 1
	dust.Parent = part
	dust:Emit(math.clamp(math.floor(size * 5), 4, 24))

	local grains = Instance.new("ParticleEmitter")
	grains.Color = ColorSequence.new(SAND_COLOR, Color3.fromRGB(200, 160, 100))
	grains.Size = NumberSequence.new(0.18 * size)
	grains.Lifetime = NumberRange.new(0.5, 0.8)
	grains.Speed = NumberRange.new(10, 20)
	grains.SpreadAngle = Vector2.new(45, 45)
	grains.EmissionDirection = Enum.NormalId.Top
	grains.Acceleration = Vector3.new(0, -60, 0)
	grains.Rate = 0
	grains.LightInfluence = 1
	grains.Parent = part
	grains:Emit(math.clamp(math.floor(size * 10), 8, 40))

	Debris:AddItem(part, 1.5)
end

-- Vyskakující text ve světě (+12, +500 coins...)
function Effects.popup(position: Vector3, text: string, color: Color3, scale: number?)
	if not Effects.popups then
		return
	end
	local part = anchorPart(position)
	local s = scale or 1
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(160 * s, 50 * s)
	billboard.StudsOffset = Vector3.new(0, 1.5, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Adornee = part
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.TextColor3 = color
	label.Parent = billboard
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(50, 30, 10)
	stroke.Parent = label

	local info = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(billboard, info, { StudsOffset = Vector3.new(0, 5, 0) }):Play()
	TweenService:Create(
		label,
		TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.45),
		{ TextTransparency = 1 }
	):Play()
	TweenService:Create(
		stroke,
		TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.45),
		{ Transparency = 1 }
	):Play()
	Debris:AddItem(part, 1.1)
end

-- Exploze mincí z truhly
function Effects.chestBurst(position: Vector3, color: Color3)
	local part = anchorPart(position + Vector3.new(0, 1.5, 0))
	local coins = Instance.new("ParticleEmitter")
	coins.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	coins.Color = ColorSequence.new(Color3.fromRGB(255, 215, 70), color)
	coins.LightEmission = 1
	coins.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0.2) })
	coins.Lifetime = NumberRange.new(0.8, 1.4)
	coins.Speed = NumberRange.new(15, 28)
	coins.SpreadAngle = Vector2.new(40, 40)
	coins.EmissionDirection = Enum.NormalId.Top
	coins.Acceleration = Vector3.new(0, -40, 0)
	coins.Rate = 0
	coins.Parent = part
	coins:Emit(60)
	Debris:AddItem(part, 2)
end

---------------------------------------------------------------------
-- Písečná bouře (jen vizuálně, na klientovi)
---------------------------------------------------------------------

local stormPart: Part? = nil
local stormEmitter: ParticleEmitter? = nil
local stormConnection: RBXScriptConnection? = nil
local defaultAtmosphere = nil

local function getAtmosphere(): Atmosphere?
	return Lighting:FindFirstChildOfClass("Atmosphere")
end

local function ensureStormEmitter()
	if stormPart then
		return
	end
	local part = Instance.new("Part")
	part.Name = "StormVolume"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(80, 40, 80)
	part.Parent = effectsFolder

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(220, 170, 110))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 14) })
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(2, 3)
	emitter.Speed = NumberRange.new(0, 0)
	emitter.Acceleration = Vector3.new(60, -4, 20)
	emitter.Rate = 0
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter.LightInfluence = 1
	emitter.Parent = part

	stormPart = part
	stormEmitter = emitter
	stormConnection = RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if camera and stormPart then
			stormPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(-25, 0, -10))
		end
	end)
end

function Effects.setStorm(phase: string)
	local atmosphere = getAtmosphere()
	if atmosphere and not defaultAtmosphere then
		defaultAtmosphere = { Density = atmosphere.Density, Color = atmosphere.Color, Haze = atmosphere.Haze }
	end

	local info = TweenInfo.new(3, Enum.EasingStyle.Sine)
	if phase == "Warning" then
		ensureStormEmitter()
		if stormEmitter then
			stormEmitter.Rate = 25
		end
		if atmosphere then
			TweenService:Create(atmosphere, info, { Density = 0.5, Haze = 2.5, Color = Color3.fromRGB(215, 160, 100) })
				:Play()
		end
	elseif phase == "Active" then
		ensureStormEmitter()
		if stormEmitter then
			stormEmitter.Rate = 120
		end
		if atmosphere then
			TweenService:Create(atmosphere, info, { Density = 0.78, Haze = 4, Color = Color3.fromRGB(200, 140, 80) })
				:Play()
		end
	else
		if stormEmitter then
			stormEmitter.Rate = 0
		end
		if atmosphere and defaultAtmosphere then
			TweenService:Create(atmosphere, TweenInfo.new(4, Enum.EasingStyle.Sine), defaultAtmosphere):Play()
		end
		task.delay(4, function()
			if workspace:GetAttribute("StormPhase") == "Calm" and stormPart then
				if stormConnection then
					stormConnection:Disconnect()
					stormConnection = nil
				end
				stormPart:Destroy()
				stormPart = nil
				stormEmitter = nil
			end
		end)
	end
end

return Effects
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000001B">
					<Properties>
						<string name="Name">Hotbar</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Hotbar – vlastní výběr nástrojů (místo výchozího Roblox hotbaru).

	- Sloty pro všechny vlastněné nástroje s 3D náhledem, číslem klávesy a barvou podle úrovně.
	- Klávesy 1–9 / kliknutí / tap = přepnutí nástroje. Znovu stejný slot = schovat / vytáhnout nástroj.
	- Ovladač: LB / RB přepíná mezi nástroji.
	- Poslední slot ukazuje další nástroj k odemčení (cena) a otevře obchod.
	- Při přepnutí se nad lištou ukáže název nástroje.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ToolFactory = require(ReplicatedStorage.Shared.ToolFactory)
local Util = require(ReplicatedStorage.Shared.Util)
local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme
local new = UIKit.new

local Hotbar = {}

local SLOT = 78
local GAP = 10
local KEYS = { One = 1, Two = 2, Three = 3, Four = 4, Five = 5, Six = 6, Seven = 7, Eight = 8, Nine = 9 }
local TIER_COLORS = { T.Gray, Color3.fromRGB(176, 122, 74), T.Blue, T.Blue, T.Purple, T.Gold, T.Purple, T.Gold }

local player = Players.LocalPlayer
local ctx = nil
local bar: Frame
local nameLabel: TextLabel
local nameScale: UIScale
local state = nil
local slots = {} -- { {ToolId, Holder, Face, Ring, Lift} }
local signature = ""
local holding = false
local nameToken = 0

---------------------------------------------------------------------
-- Pomocníci
---------------------------------------------------------------------

local function ownsTool(tool): boolean
	if not state then
		return false
	end
	if tool.Pass then
		return state.Passes[tool.Pass] == true
	end
	return state.OwnedTools[tool.Id] == true
end

local function heldTool(): Tool?
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if tool and tool:GetAttribute("DigToolId") then
		return tool
	end
	return nil
end

local function toolPreview(parent: Instance, tool, zIndex: number)
	if tool.Id == "Hands" then
		UIKit.text({
			Text = tool.Icon or "✋",
			Size = UDim2.fromScale(0.7, 0.7),
			Position = UDim2.fromScale(0.15, 0.1),
			Stroke = false,
			ZIndex = zIndex,
			Parent = parent,
		})
		return
	end
	local viewport = new("ViewportFrame", {
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.fromOffset(4, 2),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(175, 165, 155),
		LightColor = Color3.fromRGB(255, 245, 230),
		LightDirection = Vector3.new(-1, -1.5, -1),
		ZIndex = zIndex,
		Parent = parent,
	})
	local camera = new("Camera", { FieldOfView = 30, Parent = viewport })
	viewport.CurrentCamera = camera
	local model = ToolFactory.createModel(tool.Id)
	model.Parent = viewport
	local ok, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	local center = if ok and cf then cf.Position else Vector3.zero
	local radius = if ok and size then math.max(size.X, size.Y, size.Z) else 4
	local distance = radius * 1.55 + 1
	camera.CFrame = CFrame.lookAt(center + Vector3.new(distance * 0.55, distance * 0.35, -distance * 0.75), center)
end

function Hotbar.showName(text: string, color: Color3?)
	nameToken += 1
	local token = nameToken
	nameLabel.Text = text
	nameLabel.TextColor3 = color or T.White
	nameLabel.Visible = true
	nameLabel.TextTransparency = 0
	nameScale.Scale = 0.7
	TweenService:Create(nameScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
	task.delay(1.6, function()
		if token == nameToken then
			nameLabel.Visible = false
		end
	end)
end

---------------------------------------------------------------------
-- Výběr nástroje
---------------------------------------------------------------------

local function selectTool(toolId: string)
	if not state then
		return
	end
	local tool = Config.ToolsById[toolId]
	if not tool then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if toolId == state.EquippedTool then
		-- stejný nástroj: schovat / vytáhnout
		if not humanoid then
			return
		end
		if heldTool() then
			humanoid:UnequipTools()
		else
			local backpack = player:FindFirstChildOfClass("Backpack")
			for _, item in if backpack then backpack:GetChildren() else {} do
				if item:IsA("Tool") and item:GetAttribute("DigToolId") then
					humanoid:EquipTool(item)
					break
				end
			end
			Hotbar.showName(string.upper(tool.Name), T.Gold)
		end
		ctx.sfx("Click", 0.5)
		return
	end
	Hotbar.showName(string.upper(tool.Name), T.Gold)
	ctx.sfx("Open", 0.5, 1.2)
	task.spawn(function()
		local ok, message = Remotes.EquipItem:InvokeServer("Tool", toolId)
		if not ok then
			ctx.toast(message or "", "error")
		end
	end)
end

local function cycle(direction: number)
	if #slots == 0 or not state then
		return
	end
	local owned = {}
	for _, slot in slots do
		if not slot.Locked then
			table.insert(owned, slot.ToolId)
		end
	end
	local index = table.find(owned, state.EquippedTool) or 1
	index = ((index - 1 + direction) % #owned) + 1
	selectTool(owned[index])
end

---------------------------------------------------------------------
-- Stavba slotů
---------------------------------------------------------------------

local function clearSlots()
	for _, slot in slots do
		slot.Container:Destroy()
	end
	table.clear(slots)
end

local function buildSlots()
	clearSlots()
	local ownedTools = {}
	local nextLocked = nil
	for _, tool in Config.Tools do
		if ownsTool(tool) then
			table.insert(ownedTools, tool)
		elseif not nextLocked and not tool.Pass then
			nextLocked = tool
		end
	end
	while #ownedTools > 9 do
		table.remove(ownedTools, 1)
	end

	for index, tool in ownedTools do
		local tier = TIER_COLORS[tool.Index] or T.Gold
		-- obal slotu (dítě layoutu); tlačítko uvnitř se dá "zvednout"
		local container = new("Frame", {
			Name = "Slot" .. index,
			Size = UDim2.fromOffset(SLOT, SLOT + 14),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = bar,
		})
		local holder, face = UIKit.button({
			Name = "Button",
			Size = UDim2.fromOffset(SLOT, SLOT + 6),
			Position = UDim2.fromOffset(0, 8),
			Color = UIKit.lighten(tier, 0.55),
			Text = "",
			Radius = 16,
			Parent = container,
			OnClick = function()
				selectTool(tool.Id)
			end,
		})
		toolPreview(face, tool, face.ZIndex + 1)
		-- číslo klávesy
		local badge = new("Frame", {
			Size = UDim2.fromOffset(24, 24),
			Position = UDim2.fromOffset(-6, -6),
			BackgroundColor3 = T.Dark,
			ZIndex = face.ZIndex + 3,
			Parent = holder,
		})
		UIKit.corner(badge, 12)
		UIKit.stroke(badge, 2.5, tier)
		UIKit.text({
			Text = tostring(index),
			Size = UDim2.fromScale(1, 1),
			Font = UIKit.Font.Title,
			Stroke = false,
			ZIndex = face.ZIndex + 4,
			Parent = badge,
		})
		-- zlatý rámeček vybraného slotu
		local ring = new("Frame", {
			Name = "Ring",
			Size = UDim2.new(1, 12, 1, 6),
			Position = UDim2.fromOffset(-6, -6),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = face.ZIndex + 2,
			Parent = holder,
		})
		UIKit.corner(ring, 20)
		local ringStroke = UIKit.stroke(ring, 4, T.Gold)
		-- ukazatel "v ruce"
		local hand = new("Frame", {
			Name = "InHand",
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromOffset(28, 8),
			Position = UDim2.new(0.5, 0, 1, 2),
			BackgroundColor3 = T.Green,
			Visible = false,
			ZIndex = face.ZIndex + 2,
			Parent = holder,
		})
		UIKit.corner(hand, 4)
		UIKit.stroke(hand, 2)
		table.insert(slots, {
			ToolId = tool.Id,
			Container = container,
			Holder = holder,
			Face = face,
			Ring = ring,
			RingStroke = ringStroke,
			Hand = hand,
		})
	end

	if nextLocked then
		local container = new("Frame", {
			Name = "LockedSlot",
			Size = UDim2.fromOffset(SLOT, SLOT + 14),
			BackgroundTransparency = 1,
			LayoutOrder = 100,
			Parent = bar,
		})
		local holder, face = UIKit.button({
			Name = "Button",
			Size = UDim2.fromOffset(SLOT, SLOT + 6),
			Position = UDim2.fromOffset(0, 8),
			Color = T.Gray,
			Text = "",
			Radius = 16,
			Parent = container,
			OnClick = function()
				ctx.open("Shop")
			end,
		})
		UIKit.text({
			Text = "🔒",
			Size = UDim2.new(1, 0, 0.55, 0),
			Position = UDim2.fromScale(0, 0.02),
			Stroke = false,
			ZIndex = face.ZIndex + 1,
			Parent = face,
		})
		UIKit.text({
			Text = "💰 " .. Util.formatNumber(nextLocked.Price),
			Size = UDim2.new(1, 4, 0.34, 0),
			Position = UDim2.new(0, -2, 0.6, 0),
			Font = UIKit.Font.Title,
			Stroke = 2,
			ZIndex = face.ZIndex + 1,
			Parent = face,
		})
		table.insert(
			slots,
			{ ToolId = nextLocked.Id, Container = container, Holder = holder, Face = face, Locked = true }
		)
	end

	bar.Size = UDim2.fromOffset(#slots * (SLOT + GAP), SLOT + 14)
end

local function refreshHighlight()
	if not state then
		return
	end
	holding = heldTool() ~= nil
	for _, slot in slots do
		if not slot.Locked then
			local selected = slot.ToolId == state.EquippedTool
			slot.Ring.Visible = selected
			slot.Hand.Visible = selected and holding
			slot.RingStroke.Color = if holding then T.Gold else T.White
			slot.Holder.Position = UDim2.fromOffset(0, if selected then 0 else 8)
		end
	end
end

---------------------------------------------------------------------
-- Veřejné API
---------------------------------------------------------------------

function Hotbar.update(newState)
	state = newState
	local parts = {}
	for _, tool in Config.Tools do
		table.insert(parts, if ownsTool(tool) then "1" else "0")
	end
	local nextSignature = table.concat(parts)
	if nextSignature ~= signature then
		signature = nextSignature
		buildSlots()
	end
	refreshHighlight()
end

function Hotbar.build(parent: Instance, context)
	ctx = context
	bar = new("Frame", {
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.fromOffset(SLOT, SLOT + 14),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = bar,
	})
	nameLabel = UIKit.text({
		Name = "ToolName",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -206),
		Size = UDim2.fromOffset(500, 40),
		Font = UIKit.Font.Title,
		Stroke = 3,
		Visible = false,
		ZIndex = 5,
		Parent = parent,
	})
	nameScale = new("UIScale", { Parent = nameLabel })

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		local index = KEYS[input.KeyCode.Name]
		if index and slots[index] and not slots[index].Locked then
			selectTool(slots[index].ToolId)
		elseif input.KeyCode == Enum.KeyCode.ButtonR1 then
			cycle(1)
		elseif input.KeyCode == Enum.KeyCode.ButtonL1 then
			cycle(-1)
		end
	end)

	local function watchCharacter(character: Model)
		character.ChildAdded:Connect(refreshHighlight)
		character.ChildRemoved:Connect(refreshHighlight)
		refreshHighlight()
	end
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		watchCharacter(player.Character)
	end
end

return Hotbar
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000001C">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Hud – herní rozhraní na obrazovce:
	mince (animované počítadlo), bonusy, menu vlevo, rychlá tlačítka vpravo,
	banner s postupem pouště a bouří, batoh dole, notifikace a efekty.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Hotbar = require(script.Parent.Hotbar)
local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme
local new = UIKit.new

local Hud = {}

local root: Frame
local fxLayer: Frame
local refs = {}
local dots = {}
local ctx = nil
local state = nil
local coinValue: NumberValue
local lastCoins: number? = nil
local toastCounter = 0

local KIND_COLORS = {
	info = T.Dark,
	success = T.Green,
	error = T.Red,
	full = T.Red,
	epic = T.Purple,
	storm = T.Orange,
}

local function formatMultiplier(value: number): string
	local text = string.format("%.2f", value)
	text = text:gsub("0+$", ""):gsub("%.$", "")
	return "x" .. text
end

---------------------------------------------------------------------
-- Stavba
---------------------------------------------------------------------

local function buildCurrency()
	local panel = new("Frame", {
		Name = "Currency",
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.fromOffset(300, 130),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local pill = new("Frame", {
		Name = "CoinsPill",
		Size = UDim2.fromOffset(300, 62),
		BackgroundColor3 = Color3.fromRGB(110, 66, 30),
		BackgroundTransparency = 0.05,
		Parent = panel,
	})
	UIKit.corner(pill, 31)
	UIKit.stroke(pill, 3, T.Gold)
	UIKit.shade(pill, 0.45)
	refs.CoinIcon = UIKit.coin(pill, 50, UDim2.fromOffset(6, 6), 3)
	refs.Coins = UIKit.text({
		Text = "0",
		Position = UDim2.fromOffset(64, 8),
		Size = UDim2.new(1, -120, 1, -16),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = UIKit.Font.Title,
		TextColor3 = T.Gold,
		Stroke = 2.5,
		ZIndex = 3,
		Parent = pill,
	})
	refs.CoinsScale = new("UIScale", { Parent = pill })
	-- zelené "+" otevře obchod za Robux
	UIKit.button({
		Size = UDim2.fromOffset(44, 48),
		Position = UDim2.new(1, -50, 0, 7),
		Color = T.Green,
		Text = "+",
		Radius = 22,
		Depth = 4,
		Parent = pill,
		OnClick = function()
			ctx.open("Store")
		end,
	})

	local chips = new("Frame", {
		Position = UDim2.fromOffset(4, 68),
		Size = UDim2.fromOffset(300, 30),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), Parent = chips })
	local function chip(name: string, color: Color3, width: number)
		local frame =
			new("Frame", { Name = name, Size = UDim2.fromOffset(width, 32), BackgroundColor3 = color, Parent = chips })
		UIKit.corner(frame, 16)
		UIKit.stroke(frame, 2.5)
		UIKit.shade(frame, 0.15)
		local label = UIKit.text({
			Text = "",
			Position = UDim2.fromOffset(8, 3),
			Size = UDim2.new(1, -16, 1, -6),
			Font = UIKit.Font.Title,
			Parent = frame,
		})
		return frame, label
	end
	refs.MultiChip, refs.Multiplier = chip("Multiplier", T.Orange, 178)
	refs.RebirthChip, refs.Rebirths = chip("Rebirths", T.Cyan, 74)
	refs.LuckChip, refs.Luck = chip("Luck", T.Green, 220)
	-- Server Luck má vlastní řádek pod čipy (nepřekrývá banner pouště)
	refs.LuckChip.Parent = panel
	refs.LuckChip.Position = UDim2.fromOffset(4, 104)
	refs.LuckChip.Visible = false
end

local function buildMenu()
	local menu = new("Frame", {
		Name = "Menu",
		Position = UDim2.fromOffset(14, 150),
		Size = UDim2.fromOffset(2 * 76 + 10, 4 * 80 + 3 * 10),
		BackgroundTransparency = 1,
		Parent = root,
	})
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(76, 80),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	local items = {
		{ "Shop", "🛒", "SHOP", T.Orange },
		{ "Store", "💎", "STORE", T.Purple },
		{ "Rebirth", "♻️", "REBIRTH", T.Cyan },
		{ "Index", "📜", "INDEX", Color3.fromRGB(196, 130, 66) },
		{ "Daily", "🎁", "DAILY", T.Green },
		{ "Codes", "🎟️", "CODES", T.Pink },
		{ "Top", "🏆", "TOP", T.Gold },
		{ "Camp", "⛺", "CAMP", T.Blue },
	}
	for index, item in items do
		local _, _, dot = UIKit.menuButton({
			Name = item[1],
			Icon = item[2],
			Label = item[3],
			Color = item[4],
			LayoutOrder = index,
			Parent = menu,
			OnClick = function()
				ctx.menu(item[1])
			end,
		})
		dots[item[1]] = dot
	end

	local right = new("Frame", {
		Name = "QuickMenu",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 20),
		Size = UDim2.fromOffset(76, 2 * 80 + 10),
		BackgroundTransparency = 1,
		Parent = root,
	})
	new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = right })
	local _, musicFace = UIKit.menuButton({
		Name = "Music",
		Icon = "🎵",
		Label = "MUSIC",
		Color = Color3.fromRGB(90, 120, 230),
		LayoutOrder = 1,
		Parent = right,
		OnClick = function()
			ctx.menu("Music")
		end,
	})
	refs.MusicFace = musicFace
	UIKit.menuButton({
		Name = "Settings",
		Icon = "⚙️",
		Label = "SETTINGS",
		Color = T.Gray,
		LayoutOrder = 2,
		Parent = right,
		OnClick = function()
			ctx.menu("Settings")
		end,
	})
end

local function buildBanner()
	local banner = new("Frame", {
		Name = "Desert",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(440, 90),
		BackgroundColor3 = T.Dark,
