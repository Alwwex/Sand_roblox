		Color = T.Sand,
		Radius = 16,
		Parent = panel,
	})
	refs.SandFill = fill
	refs.SandLabel = label
	refs.Hint = UIKit.text({
		Text = "👆 HOLD click / tap to dig!  Sell sand at the golden SELL pad 💰",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -8),
		Size = UDim2.fromOffset(700, 32),
		TextColor3 = T.Gold,
		Font = UIKit.Font.Title,
		Stroke = 3,
		Visible = false,
		Parent = panel,
	})
	refs.HintScale = new("UIScale", { Parent = refs.Hint })
end

---------------------------------------------------------------------
-- Notifikace a efekty
---------------------------------------------------------------------

function Hud.toast(message: string, kind: string?)
	local k = kind or "info"
	local color = KIND_COLORS.info
	if string.sub(k, 1, 7) == "rarity:" then
		local rarity = Config.Rarities[string.sub(k, 8)]
		color = if rarity then rarity.Color else T.Gold
	elseif KIND_COLORS[k] then
		color = KIND_COLORS[k]
	end
	toastCounter += 1
	local toast = new(
		"Frame",
		{ Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = color, LayoutOrder = toastCounter, Parent = refs.Toasts }
	)
	UIKit.corner(toast, 14)
	UIKit.stroke(toast, 3)
	UIKit.shade(toast, 0.2)
	UIKit.text({
		Text = message,
		Size = UDim2.new(1, -24, 1, -12),
		Position = UDim2.fromOffset(12, 6),
		Stroke = 2,
		Parent = toast,
	})
	local scale = UIKit.pop(toast, 0.5)
	local toasts = {}
	for _, child in refs.Toasts:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #toasts - 4 do
			toasts[i]:Destroy()
		end
	end
	task.delay(4, function()
		if toast.Parent then
			local tween = TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 })
			tween:Play()
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
end

function Hud.bigPopup(message: string, color: Color3)
	local label = UIKit.text({
		Text = message,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(640, 90),
		TextColor3 = color,
		Font = UIKit.Font.Title,
		Stroke = 5,
		ZIndex = 40,
		Parent = fxLayer,
	})
	local stroke = label:FindFirstChildOfClass("UIStroke")
	UIKit.pop(label, 0.3)
	task.delay(0.9, function()
		local info = TweenInfo.new(0.6)
		TweenService:Create(label, info, { Position = UDim2.fromScale(0.5, 0.32), TextTransparency = 1 }):Play()
		if stroke then
			TweenService:Create(stroke, info, { Transparency = 1 }):Play()
		end
		task.wait(0.65)
		label:Destroy()
	end)
end

function Hud.flash(color: Color3?, strength: number?)
	local frame = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color or T.White,
		BackgroundTransparency = 1 - (strength or 0.45),
		ZIndex = 50,
		Parent = fxLayer,
	})
	TweenService:Create(frame, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	task.delay(0.55, function()
		frame:Destroy()
	end)
end

-- Mince letí ze středu obrazovky do počítadla
function Hud.flyCoins(count: number)
	local icon = refs.CoinIcon
	local iconPos, iconSize = icon.AbsolutePosition, icon.AbsoluteSize
	local layerPos, layerSize = fxLayer.AbsolutePosition, fxLayer.AbsoluteSize
	if not (iconPos and iconSize and layerPos and layerSize) or layerSize.X < 1 then
		return
	end
	local rel = iconPos + iconSize / 2 - layerPos
	local target = UDim2.fromScale(rel.X / layerSize.X, rel.Y / layerSize.Y)
	for i = 1, math.clamp(count, 3, 12) do
		local coin = UIKit.coin(fxLayer, 40, UDim2.new(0.5, math.random(-120, 120), 0.5, math.random(-60, 60)), 45)
		coin.AnchorPoint = Vector2.new(0.5, 0.5)
		task.delay(i * 0.04, function()
			local tween =
				TweenService:Create(coin, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
					Position = target,
					Size = UDim2.fromOffset(26, 26),
				})
			tween:Play()
			tween.Completed:Wait()
			coin:Destroy()
		end)
	end
end

---------------------------------------------------------------------
-- Aktualizace
---------------------------------------------------------------------

function Hud.updateWorld()
	local cleared = workspace:GetAttribute("DesertCleared") or 0
	local phase = workspace:GetAttribute("StormPhase") or "Calm"
	local stormIn = workspace:GetAttribute("StormIn") or 0
	refs.DesertTitle.Text = "DESERT CLEARED: " .. Util.formatPercent(cleared)
	refs.DesertFill.Size = UDim2.fromScale(math.clamp(cleared / Config.Sandstorm.ClearedThreshold, 0, 1), 1)
	if phase == "Warning" then
		refs.Storm.Text = ("⚠️ SANDSTORM IN %ds!"):format(stormIn)
		refs.Storm.TextColor3 = Color3.fromRGB(255, 120, 90)
		refs.Banner.BackgroundColor3 = Color3.fromRGB(120, 30, 20)
	elseif phase == "Active" then
		refs.Storm.Text = "🌪️ SANDSTORM! Burying the desert..."
		refs.Storm.TextColor3 = Color3.fromRGB(255, 170, 80)
		refs.Banner.BackgroundColor3 = Color3.fromRGB(120, 60, 20)
	else
		refs.Storm.Text = ("🌪️ Sandstorm in %s or at %d%% cleared"):format(
			Util.formatTime(stormIn),
			math.floor(Config.Sandstorm.ClearedThreshold * 100)
		)
		refs.Storm.TextColor3 = T.White
		refs.Banner.BackgroundColor3 = T.Dark
	end
	local luckLeft = (workspace:GetAttribute("ServerLuckUntil") or 0) - os.time()
	refs.LuckChip.Visible = luckLeft > 0
	if luckLeft > 0 then
		refs.Luck.Text = "🍀 LUCK x2 " .. Util.formatTime(luckLeft)
	end
end

function Hud.setDot(name: string, visible: boolean)
	if dots[name] then
		dots[name].Visible = visible
	end
end

function Hud.setMusicOn(on: boolean)
	if refs.MusicFace then
		UIKit.setButtonColor(refs.MusicFace.Parent :: Frame, if on then Color3.fromRGB(90, 120, 230) else T.Gray)
	end
end

function Hud.update(newState)
	state = newState
	if lastCoins and state.Coins > lastCoins then
		refs.CoinsScale.Scale = 1.1
		TweenService:Create(refs.CoinsScale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	if lastCoins == nil then
		coinValue.Value = state.Coins -- první načtení bez animace
		refs.Coins.Text = Util.formatNumber(state.Coins)
	else
		TweenService:Create(coinValue, TweenInfo.new(0.45, Enum.EasingStyle.Quad), { Value = state.Coins }):Play()
	end
	lastCoins = state.Coins

	refs.Multiplier.Text = "⚡ " .. formatMultiplier(state.CoinMultiplier) .. " COINS"
	refs.RebirthChip.Visible = state.Rebirths > 0
	refs.Rebirths.Text = "♻️ " .. state.Rebirths

	local capacity = math.max(1, state.Capacity)
	local fraction = math.clamp(state.Sand / capacity, 0, 1)
	TweenService:Create(refs.SandFill, TweenInfo.new(0.15), { Size = UDim2.fromScale(math.max(fraction, 0.02), 1) })
		:Play()
	if state.Sand >= capacity then
		refs.SandFill.BackgroundColor3 = T.Red
		refs.SandLabel.Text = if state.Passes.AutoSell
			then "⚡ AUTO SELLING..."
			else "🎒 FULL! SELL AT THE CAMP 💰"
	else
		refs.SandFill.BackgroundColor3 = T.Sand
		refs.SandLabel.Text = ("🏜️ %s / %s"):format(Util.formatNumber(state.Sand), Util.formatNumber(capacity))
	end
	local tool = Config.ToolsById[state.EquippedTool]
	local backpack = Config.BackpacksById[state.EquippedBackpack]
	refs.Tool.Text = ("%s %s   •   %s %s"):format(
		tool and tool.Icon or "",
		tool and tool.Name or "",
		backpack and backpack.Icon or "",
		backpack and backpack.Name or ""
	)
	refs.Hint.Visible = state.TotalSand < 150
	Hotbar.update(state)

	-- upozornění (červené tečky)
	local canBuy = false
	for _, item in Config.Tools do
		if not item.Pass and not state.OwnedTools[item.Id] and state.Coins >= item.Price then
			canBuy = true
		end
	end
	for _, item in Config.Backpacks do
		if not state.OwnedBackpacks[item.Id] and state.Coins >= item.Price then
			canBuy = true
		end
	end
	Hud.setDot("Shop", canBuy)
	Hud.setDot("Rebirth", state.Coins >= state.RebirthCost)
	local clockOffset = (state.ServerTime or os.time()) - os.time()
	Hud.setDot("Daily", os.time() + clockOffset >= (state.LastDaily or 0) + (state.DailyCooldown or 0))
end

function Hud.setVisible(visible: boolean)
	root.Visible = visible
end

function Hud.build(gui: ScreenGui, context)
	ctx = context
	root = new(
		"Frame",
		{ Name = "Hud", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui }
	)
	fxLayer = new(
		"Frame",
		{ Name = "Fx", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 40, Parent = gui }
	)
	coinValue = new("NumberValue", { Value = 0, Parent = gui })
	buildCurrency()
	buildMenu()
	buildBanner()
	buildSandBar()
	Hotbar.build(root, ctx)
	refs.Toasts = new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 104),
		Size = UDim2.fromOffset(620, 260),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = gui,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = refs.Toasts,
	})
	coinValue.Changed:Connect(function(value)
		refs.Coins.Text = Util.formatNumber(value)
	end)
	-- pulzování nápovědy
	task.spawn(function()
		while true do
			task.wait(0.6)
			if refs.Hint.Visible then
				TweenService:Create(
					refs.HintScale,
					TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true),
					{ Scale = 1.06 }
				):Play()
			end
		end
	end)
end

return Hud
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX0000001D">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DUNE DIGGERS – hlavní klientský skript
	Hlavní menu → hra. Propojuje UI, hudbu, kopání, efekty a zprávy ze serveru.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Audio = require(script.Parent:WaitForChild("Audio"))
local DigController = require(script.Parent:WaitForChild("DigController"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer
local state = nil
local settings = { Music = 0.5, Sfx = 0.8, LowGfx = false, Popups = true }
local lastMusicVolume = 0.5
local settingsLoaded = false
local saveScheduled = false
local digSoundToggle = false

---------------------------------------------------------------------
-- Nastavení (hlasitost, grafika) – ukládá se na server
---------------------------------------------------------------------

local function applySettings()
	Audio.setVolumes(settings.Music, settings.Sfx)
	Effects.lowGraphics = settings.LowGfx
	Effects.popups = settings.Popups
end

local function onSettingsChanged(newSettings)
	for key, value in newSettings do
		settings[key] = value
	end
	applySettings()
	if not saveScheduled then
		saveScheduled = true
		task.delay(1, function()
			saveScheduled = false
			Remotes.SaveSettings:FireServer(settings)
		end)
	end
end

local function toggleMusic(): boolean
	if settings.Music > 0 then
		lastMusicVolume = settings.Music
		onSettingsChanged({ Music = 0 })
	else
		onSettingsChanged({ Music = if lastMusicVolume > 0 then lastMusicVolume else 0.5 })
	end
	UI.applySettings(settings)
	return settings.Music > 0
end

---------------------------------------------------------------------
-- Start
---------------------------------------------------------------------

-- Výchozí Roblox hotbar vypneme – máme vlastní výběr nástrojů (Hotbar)
task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

Audio.init()
UI.init({ sfx = Audio.sfx, settingsChanged = onSettingsChanged, toggleMusic = toggleMusic })
DigController.init()
applySettings()
Audio.setMenu(true)

UI.showMenu(function()
	Audio.setMenu(false)
	UI.setHudVisible(true)
	Audio.sfx("Open", 0.6)
end)

local function applyState(newState)
	if not newState then
		return
	end
	state = newState
	if not settingsLoaded and newState.Settings then
		settingsLoaded = true
		for key, value in newState.Settings do
			settings[key] = value
		end
		applySettings()
		UI.applySettings(settings)
	end
	UI.update(newState)
	DigController.setState(newState)
end

Remotes.DataSync.OnClientEvent:Connect(applyState)
task.spawn(function()
	applyState(Remotes.GetData:InvokeServer())
end)

-- hudba podle místa (lobby / poušť / bouře)
task.spawn(function()
	while true do
		Audio.refresh()
		task.wait(1)
	end
end)

---------------------------------------------------------------------
-- Zprávy ze serveru
---------------------------------------------------------------------

Remotes.Notify.OnClientEvent:Connect(function(message, kind)
	UI.toast(message, kind)
	if kind == "epic" then
		Audio.sfx("Rare", 0.6)
	elseif kind == "error" or kind == "full" then
		Audio.sfx("Error", 0.5)
	elseif type(kind) == "string" and kind:sub(1, 7) == "rarity:" then
		Audio.sfx("Chest", 0.6)
	end
end)

Remotes.DigResult.OnClientEvent:Connect(function(amount, position, isFull)
	local tool = state and Config.ToolsById[state.EquippedTool]
	local strength = if tool then tool.Radius / 2.6 else 1
	Effects.digBurst(position, strength)
	Effects.popup(
		position,
		"+" .. Util.formatNumber(amount),
		Color3.fromRGB(255, 225, 140),
		math.min(1.4, 0.8 + strength * 0.15)
	)
	digSoundToggle = not digSoundToggle
	Audio.sfx(if digSoundToggle then "Dig" else "Dig2", 0.55, 0.9 + math.random() * 0.25)
	if strength >= 2.3 then
		Effects.shake(0.25 * strength, 0.15)
	end
	if isFull and not (state and state.Passes.AutoSell) then
		Audio.sfx("Error", 0.4)
	end
end)

Remotes.Sold.OnClientEvent:Connect(function(coins, sand, isAuto)
	UI.bigPopup("+" .. Util.formatNumber(coins) .. " 💰", Color3.fromRGB(255, 215, 70))
	UI.flyCoins(math.clamp(math.floor(sand / 20), 4, 12))
	Audio.sfx("Sell", 0.8)
	if not isAuto then
		UI.toast(("Sold %s sand for %s coins!"):format(Util.formatNumber(sand), Util.formatNumber(coins)), "success")
	end
end)

Remotes.ChestOpened.OnClientEvent:Connect(function(rarityName, coins, artifactId, isNew, position)
	local rarity = Config.Rarities[rarityName]
	local color = if rarity then rarity.Color else Color3.fromRGB(255, 215, 70)
	Effects.chestBurst(position, color)
	Effects.popup(
		position + Vector3.new(0, 2, 0),
		"+" .. Util.formatNumber(coins) .. " 💰",
		Color3.fromRGB(255, 215, 70),
		1.5
	)
	UI.flyCoins(8)
	if rarity and rarity.Order >= 3 then
		Audio.sfx("Rare", 0.9)
		UI.flash(color, 0.45)
		Effects.shake(0.6, 0.3)
	else
		Audio.sfx("Chest", 0.8)
	end

	local artifact = artifactId and Config.ArtifactsById[artifactId]
	if artifact then
		if isNew then
			UI.bigPopup(artifact.Icon .. " NEW ARTIFACT!", Config.Rarities[artifact.Rarity].Color)
			UI.toast(
				("%s %s found! +%d%% coins forever"):format(
					artifact.Icon,
					artifact.Name,
					math.floor(artifact.Bonus * 100 + 0.5)
				),
				"rarity:" .. artifact.Rarity
			)
		else
			UI.toast(("%s Duplicate %s → bonus coins!"):format(artifact.Icon, artifact.Name), "info")
		end
	end
end)

Remotes.Reward.OnClientEvent:Connect(function(kind, coins)
	UI.bigPopup(
		(if kind == "Vip" then "👑 VIP " else "🎁 DAILY ") .. "+" .. Util.formatNumber(coins),
		Color3.fromRGB(150, 255, 150)
	)
	UI.flyCoins(10)
	UI.flash(Color3.fromRGB(255, 240, 170), 0.35)
	Audio.sfx("Rare", 0.8)
end)

Remotes.OpenWindow.OnClientEvent:Connect(function(name)
	UI.open(name)
end)

---------------------------------------------------------------------
-- Písečná bouře
---------------------------------------------------------------------

local function onStormPhase()
	local phase = workspace:GetAttribute("StormPhase") or "Calm"
	Effects.setStorm(phase)
	if phase == "Warning" then
		Audio.sfx("Storm", 0.9)
	end
	Audio.refresh()
end
workspace:GetAttributeChangedSignal("StormPhase"):Connect(onStormPhase)
onStormPhase()

---------------------------------------------------------------------
-- Treasure Radar (gamepass): zvýrazní nejbližší zakopané truhly
---------------------------------------------------------------------

local RADAR_RANGE = 140
local RADAR_MAX = 8
local radarHighlights = {} -- [Model] = Highlight

task.spawn(function()
	local treasures = workspace:WaitForChild("Treasures")
	while true do
		task.wait(0.5)
		local hasRadar = state and state.Passes.TreasureRadar
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")

		local wanted = {}
		if hasRadar and root then
			local candidates = {}
			for _, chest in treasures:GetChildren() do
				if chest:IsA("Model") and chest.PrimaryPart and not chest:GetAttribute("Exposed") then
					local distance = (chest.PrimaryPart.Position - root.Position).Magnitude
					if distance <= RADAR_RANGE then
						table.insert(candidates, { Chest = chest, Distance = distance })
					end
				end
			end
			table.sort(candidates, function(a, b)
				return a.Distance < b.Distance
			end)
			for i = 1, math.min(RADAR_MAX, #candidates) do
				wanted[candidates[i].Chest] = true
			end
		end

		for chest, highlight in radarHighlights do
			if not wanted[chest] or not chest.Parent then
				highlight:Destroy()
				radarHighlights[chest] = nil
			end
		end
		for chest in wanted do
			if not radarHighlights[chest] then
				local rarity = Config.Rarities[chest:GetAttribute("Rarity")]
				local highlight = Instance.new("Highlight")
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillColor = if rarity then rarity.Color else Color3.new(1, 1, 1)
				highlight.FillTransparency = 0.5
				highlight.OutlineColor = Color3.new(1, 1, 1)
				highlight.Adornee = chest
				highlight.Parent = chest
				radarHighlights[chest] = highlight
			end
		end
	end
end)

---------------------------------------------------------------------
-- VIP štítek v chatu
---------------------------------------------------------------------

pcall(function()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local sender = Players:GetPlayerByUserId(source.UserId)
			if sender and sender:GetAttribute("VIP") then
				properties.PrefixText = "<font color='#FFD23C'>[👑 VIP]</font> " .. message.PrefixText
			end
		end
		return properties
	end
end)
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000001E">
					<Properties>
						<string name="Name">MainMenu</string>
						<ProtectedString name="Source"><![CDATA[--[[
	MainMenu – úvodní obrazovka: kamera krouží nad Oasis Town a pouští,
	velké logo, tlačítko PLAY (počká, než se poušť vygeneruje), novinky a tipy.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme
local F = UIKit.Font
local new = UIKit.new

local MainMenu = {}

local TIPS = {
	"Deeper chests are rarer – dig down!",
	"Uncover the LOST RUINS for a Mythic relic 💎",
	"Every artifact gives coins forever 📜",
	"Claim your DAILY reward in Oasis Town 🎁",
	"When the desert is 75% gone, a SANDSTORM comes 🌪️",
	"New codes on our TikTok & Instagram 🎟️",
}

local function logoWord(parent: Instance, text: string, y: number, size: number, top: Color3, bottom: Color3)
	local label = UIKit.text({
		Text = text,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, y),
		Size = UDim2.fromOffset(900, size),
		Font = F.Title,
		Stroke = 6,
		ZIndex = 62,
		Parent = parent,
	})
	UIKit.gradient(label, top, bottom)
	-- 3D vytažení (tmavá kopie pod textem)
	local shadow = UIKit.text({
		Text = text,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, y + 8),
		Size = UDim2.fromOffset(900, size),
		Font = F.Title,
		TextColor3 = Color3.fromRGB(120, 50, 10),
		Stroke = 6,
		ZIndex = 61,
		Parent = parent,
	})
	return label, shadow
end

function MainMenu.show(gui: ScreenGui, callbacks)
	local camera = workspace.CurrentCamera
	local root = new(
		"Frame",
		{ Name = "MainMenu", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 60, Parent = gui }
	)
	local shade = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(40, 20, 5),
		BackgroundTransparency = 0.5,
		ZIndex = 60,
		Parent = root,
	})
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(0.45, 0.95),
			NumberSequenceKeypoint.new(1, 0.25),
		}),
		Rotation = 90,
		Parent = shade,
	})

	local logo = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 30),
		Size = UDim2.fromOffset(900, 300),
		BackgroundTransparency = 1,
		Rotation = -3,
		ZIndex = 61,
		Parent = root,
	})
	logoWord(logo, "DUNE", 0, 120, Color3.fromRGB(255, 248, 220), Color3.fromRGB(240, 170, 80))
	logoWord(logo, "DIGGERS", 110, 170, Color3.fromRGB(255, 250, 170), Color3.fromRGB(255, 120, 20))
	TweenService:Create(
		logo,
		TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Position = UDim2.new(0.5, 0, 0, 42) }
	):Play()
	UIKit.text({
		Text = "Dig up the ENTIRE desert!",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 330),
		Size = UDim2.fromOffset(700, 44),
		Font = F.Body,
		Stroke = 3,
		ZIndex = 62,
		Parent = root,
	})

	local buttons = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 400),
		Size = UDim2.fromOffset(360, 260),
		BackgroundTransparency = 1,
		ZIndex = 62,
		Parent = root,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 14),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = buttons,
	})

	local finished = false
	local orbit: RBXScriptConnection? = nil
	local playHolder, playFace

	local function play()
		if finished or not workspace:GetAttribute("WorldReady") then
			return
		end
		finished = true
		local fadeFrame = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(255, 225, 160),
			BackgroundTransparency = 1,
			ZIndex = 80,
			Parent = gui,
		})
		local tween = TweenService:Create(fadeFrame, TweenInfo.new(0.35), { BackgroundTransparency = 0 })
		tween:Play()
		tween.Completed:Wait()
		if orbit then
			orbit:Disconnect()
		end
		root:Destroy()
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			local character = Players.LocalPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				camera.CameraSubject = humanoid
			end
		end
		callbacks.onPlay()
		TweenService:Create(fadeFrame, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
		task.delay(0.7, function()
			fadeFrame:Destroy()
		end)
	end

	playHolder, playFace = UIKit.button({
		Size = UDim2.fromOffset(340, 100),
		Color = T.Green,
		Text = "PLAY!",
		LayoutOrder = 1,
		ZIndex = 63,
		Parent = buttons,
		OnClick = play,
	})
	UIKit.button({
		Size = UDim2.fromOffset(300, 66),
		Color = T.Blue,
		Text = "🆕 UPDATES",
		LayoutOrder = 2,
		ZIndex = 63,
		Parent = buttons,
		OnClick = function()
			local panel = root:FindFirstChild("Updates")
			if panel then
				panel.Visible = not panel.Visible
			end
		end,
	})
	local _, musicFace
	local musicHolder
	musicHolder, musicFace = UIKit.button({
		Size = UDim2.fromOffset(300, 66),
		Color = Color3.fromRGB(90, 120, 230),
		Text = "🎵 MUSIC: ON",
		LayoutOrder = 3,
		ZIndex = 63,
		Parent = buttons,
		OnClick = function()
			local on = callbacks.toggleMusic()
			musicFace.Text = if on then "🎵 MUSIC: ON" else "🎵 MUSIC: OFF"
			UIKit.setButtonColor(musicHolder, if on then Color3.fromRGB(90, 120, 230) else T.Gray)
		end,
	})

	-- Novinky
	local updates = new("Frame", {
		Name = "Updates",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -30, 0.5, 40),
		Size = UDim2.fromOffset(380, 330),
		BackgroundColor3 = T.Panel,
		Visible = false,
		ZIndex = 64,
		Parent = root,
	})
	UIKit.corner(updates, 22)
	UIKit.stroke(updates, 4)
	UIKit.text({
		Text = "🆕 WHAT'S NEW v" .. Config.Version,
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 40),
		TextColor3 = T.Orange,
		Font = F.Title,
		Stroke = 2,
		ZIndex = 65,
		Parent = updates,
	})
	UIKit.text({
		Text = table.concat(Config.Changelog or {}, "\n"),
		Position = UDim2.fromOffset(18, 58),
		Size = UDim2.new(1, -36, 1, -72),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.Text,
		Font = F.Body,
		TextScaled = false,
		TextSize = 22,
		TextWrapped = true,
		Stroke = false,
		ZIndex = 65,
		Parent = updates,
	})

	local tip = UIKit.text({
		Text = "TIP: " .. TIPS[1],
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(900, 34),
		Font = F.Body,
		Stroke = 3,
		ZIndex = 62,
		Parent = root,
	})
	UIKit.text({
		Text = "v" .. Config.Version,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -12),
		Size = UDim2.fromOffset(120, 26),
		Font = F.Body,
		Stroke = 2,
		ZIndex = 62,
		Parent = root,
	})
	task.spawn(function()
		local i = 1
		while root.Parent do
			task.wait(4)
			i = i % #TIPS + 1
			tip.Text = "TIP: " .. TIPS[i]
		end
	end)

	-- Stav načítání
	local function updateReady()
		if finished then
			return
		end
		local ready = workspace:GetAttribute("WorldReady") == true
		playFace.Text = if ready then "PLAY!" else "LOADING..."
		UIKit.setButtonColor(playHolder, if ready then T.Green else T.Gray)
	end
	workspace:GetAttributeChangedSignal("WorldReady"):Connect(updateReady)
	updateReady()

	-- Kamera krouží kolem lobby
	if camera then
		camera.CameraType = Enum.CameraType.Scriptable
		local angle = 0
		local center = Vector3.new(0, Config.World.CampTop + 6, 0)
		orbit = RunService.RenderStepped:Connect(function(dt)
			angle += dt * 0.06
			local position = center + Vector3.new(math.cos(angle) * 150, 60, math.sin(angle) * 150)
			camera.CFrame = CFrame.lookAt(position, center)
		end)
	end

	return play
end

return MainMenu
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000001F">
					<Properties>
						<string name="Name">UI</string>
						<ProtectedString name="Source"><![CDATA[--[[
	UI – vstupní bod uživatelského rozhraní. Spojuje HUD, okna a hlavní menu.
	Návrh je pro 1280x720 a automaticky se škáluje (PC, tablet, mobil).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Hud = require(script.Parent.Hud)
local MainMenu = require(script.Parent.MainMenu)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local UI = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local state = nil
local callbacks = nil

local function onMenu(name: string)
	if name == "Daily" then
		local ok, message = Remotes.ClaimDaily:InvokeServer()
		if not ok then
			Hud.toast(message or "", "info")
			callbacks.sfx("Error", 0.5)
		end
	elseif name == "Camp" then
		Windows.close()
		Remotes.TeleportCamp:FireServer()
	elseif name == "Music" then
		local on = callbacks.toggleMusic()
		Hud.setMusicOn(on)
	else
		Windows.open(name)
	end
end

function UI.init(cb)
	callbacks = cb
	local playerGui = player:WaitForChild("PlayerGui")
	gui = UIKit.new("ScreenGui", {
		Name = "DuneDiggersUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	-- škálování podle velikosti obrazovky
	local uiScale = UIKit.new("UIScale", { Parent = gui })
	local function rescale()
		local camera = workspace.CurrentCamera
		if camera then
			local viewport = camera.ViewportSize
			uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.5, 1.5)
		end
	end
	rescale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	UIKit.clickSound = function()
		cb.sfx("Click", 0.5)
	end

	local context = {
		open = Windows.open,
		menu = onMenu,
		toast = Hud.toast,
		bigPopup = Hud.bigPopup,
		flash = Hud.flash,
		flyCoins = Hud.flyCoins,
		sfx = cb.sfx,
		settingsChanged = cb.settingsChanged,
	}
	Hud.build(gui, context)
	Windows.build(gui, context)

	for _, attribute in { "DesertCleared", "StormPhase", "StormIn", "ServerLuckUntil" } do
		workspace:GetAttributeChangedSignal(attribute):Connect(Hud.updateWorld)
	end
	Hud.updateWorld()
	task.spawn(function()
		while true do
			task.wait(1)
			Hud.updateWorld()
		end
	end)
end

function UI.showMenu(onPlay)
	return MainMenu.show(gui, { onPlay = onPlay, toggleMusic = callbacks.toggleMusic })
end

function UI.update(newState)
	state = newState
	Hud.update(newState)
	Windows.update(newState)
end

function UI.getState()
	return state
end

UI.toast = function(message: string, kind: string?)
	Hud.toast(message, kind)
end
UI.bigPopup = function(message: string, color: Color3)
	Hud.bigPopup(message, color)
end
UI.flash = function(color: Color3?, strength: number?)
	Hud.flash(color, strength)
end
UI.flyCoins = function(count: number)
	Hud.flyCoins(count)
end
UI.open = function(name: string)
	Windows.open(name)
end
UI.close = function()
	Windows.close()
end
UI.setHudVisible = function(visible: boolean)
	Hud.setVisible(visible)
end
UI.applySettings = function(settings)
	Windows.applySettings(settings)
	Hud.setMusicOn((settings.Music or 0) > 0)
end

return UI
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000020">
					<Properties>
						<string name="Name">UIKit</string>
						<ProtectedString name="Source"><![CDATA[--[[
	UIKit – stavebnice UI: barvy, písma a hotové prvky (3D tlačítka, panely,
	ikony mincí, lišty, posuvníky). Vzhled odpovídá marketingovým grafikám.
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UIKit = {}

UIKit.Theme = {
	Panel = Color3.fromRGB(255, 244, 222),
	PanelDark = Color3.fromRGB(244, 224, 188),
	PanelDeep = Color3.fromRGB(226, 196, 150),
	Outline = Color3.fromRGB(61, 29, 8),
	Text = Color3.fromRGB(85, 50, 22),
	SubText = Color3.fromRGB(140, 100, 62),
	White = Color3.new(1, 1, 1),
	Orange = Color3.fromRGB(255, 138, 31),
	Gold = Color3.fromRGB(255, 201, 40),
	Cyan = Color3.fromRGB(71, 220, 255),
	Blue = Color3.fromRGB(61, 155, 255),
	Purple = Color3.fromRGB(169, 85, 255),
	Green = Color3.fromRGB(85, 200, 80),
	Red = Color3.fromRGB(235, 70, 70),
	Pink = Color3.fromRGB(255, 60, 106),
	Gray = Color3.fromRGB(160, 148, 135),
	Sand = Color3.fromRGB(240, 196, 110),
	Dark = Color3.fromRGB(58, 34, 16),
}
local T = UIKit.Theme

UIKit.Font = {
	Title = Enum.Font.LuckiestGuy,
	Body = Enum.Font.FredokaOne,
	Small = Enum.Font.GothamMedium,
}

UIKit.clickSound = nil -- nastaví UI (přehraje zvuk kliknutí)

function UIKit.new(className: string, props, children): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end
local new = UIKit.new

function UIKit.corner(parent: Instance, radius: number)
	return new("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

function UIKit.stroke(parent: Instance, thickness: number, color: Color3?, contextual: boolean?)
	return new("UIStroke", {
		Thickness = thickness,
		Color = color or T.Outline,
		ApplyStrokeMode = if contextual then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

-- Pozor: UIGradient v Robloxu NÁSOBÍ barvu prvku. Barevný přechod proto
-- používej jen na bílý text/prvek (např. logo). Na barevné plochy je UIKit.shade.
function UIKit.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?)
	return new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90, Parent = parent })
end

-- Stínování barevné plochy: nahoře plná barva, dole o "amount" tmavší
function UIKit.shade(parent: Instance, amount: number)
	local bottom = 1 - amount
	return new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(bottom, bottom, bottom)),
		Rotation = 90,
		Parent = parent,
	})
end

function UIKit.padding(parent: Instance, px: number, py: number?)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, py or px),
		PaddingBottom = UDim.new(0, py or px),
		Parent = parent,
	})
end

function UIKit.lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

function UIKit.darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

-- Text s obrysem (Stroke = tloušťka obrysu, false = bez obrysu)
function UIKit.text(props): TextLabel
	local strokeThickness = props.Stroke
	local strokeColor = props.StrokeColor
	props.Stroke = nil
	props.StrokeColor = nil
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Font = props.Font or UIKit.Font.Body
	props.TextColor3 = props.TextColor3 or T.White
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local label = new("TextLabel", props)
	if strokeThickness ~= false then
		UIKit.stroke(label, strokeThickness or 2, strokeColor, true)
	end
	return label
end

local quick = TweenInfo.new(0.08, Enum.EasingStyle.Quad)

--[[
	3D tlačítko: barevná plocha s přechodem + tmavý "spodek".
	Vrací holder (pro layout) a face (TextButton).
	props: Size, Position, AnchorPoint, Color, Text, Font, TextColor, Icon, OnClick, LayoutOrder, Parent, Radius, Depth
]]
function UIKit.button(props)
	local color = props.Color or T.Orange
	local depth = props.Depth or 5
	local radius = props.Radius or 14
	local holder = new("Frame", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(180, 56),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	local base = new("Frame", {
		Name = "Base",
		Size = UDim2.new(1, 0, 1, -depth),
		Position = UDim2.fromOffset(0, depth),
		BackgroundColor3 = UIKit.darken(color, 0.45),
		ZIndex = holder.ZIndex,
		Parent = holder,
	})
	UIKit.corner(base, radius)
	UIKit.stroke(base, 3)
	local face = new("TextButton", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -depth),
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = props.Text or "",
		Font = props.Font or UIKit.Font.Title,
		TextColor3 = props.TextColor or T.White,
		TextScaled = true,
		ZIndex = holder.ZIndex + 1,
		Parent = holder,
	})
	UIKit.corner(face, radius)
	UIKit.stroke(face, 3)
	UIKit.shade(face, 0.22)
	UIKit.padding(face, 10, 7)
	local textStroke = new(
		"UIStroke",
		{ Thickness = 2, Color = T.Outline, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = face }
	)
	textStroke.Name = "TextStroke"
	-- lesk nahoře
	local shine = new("Frame", {
		Name = "Shine",
		Size = UDim2.new(1, -12, 0.32, 0),
		Position = UDim2.new(0, 6, 0, 4),
		BackgroundColor3 = T.White,
		BackgroundTransparency = 0.78,
		ZIndex = holder.ZIndex + 1,
		Parent = face,
	})
	UIKit.corner(shine, radius)
	local scale = new("UIScale", { Parent = holder })

	face.MouseEnter:Connect(function()
		TweenService:Create(scale, quick, { Scale = 1.05 }):Play()
	end)
	face.MouseLeave:Connect(function()
		TweenService:Create(scale, quick, { Scale = 1 }):Play()
		TweenService:Create(face, quick, { Position = UDim2.fromOffset(0, 0) }):Play()
	end)
	face.MouseButton1Down:Connect(function()
		TweenService:Create(face, quick, { Position = UDim2.fromOffset(0, depth - 1) }):Play()
	end)
	face.MouseButton1Up:Connect(function()
		TweenService:Create(face, quick, { Position = UDim2.fromOffset(0, 0) }):Play()
	end)
	face.Activated:Connect(function()
		if UIKit.clickSound then
			UIKit.clickSound()
		end
		if props.OnClick then
			props.OnClick()
		end
	end)
	return holder, face
end

-- Přebarví 3D tlačítko
function UIKit.setButtonColor(holder: Frame, color: Color3)
	local face = holder:FindFirstChild("Face") :: TextButton?
	local base = holder:FindFirstChild("Base") :: Frame?
	if face then
		face.BackgroundColor3 = color
	end
	if base then
		base.BackgroundColor3 = UIKit.darken(color, 0.45)
	end
end

-- Čtvercové tlačítko menu: velká ikona + popisek + červená tečka (upozornění)
function UIKit.menuButton(props)
	local holder, face = UIKit.button({
		Name = props.Name,
		Size = props.Size or UDim2.fromOffset(76, 80),
		Color = props.Color,
		Text = "",
		LayoutOrder = props.LayoutOrder,
		OnClick = props.OnClick,
		Parent = props.Parent,
		Radius = 16,
	})
	UIKit.text({
		Text = props.Icon,
		Size = UDim2.new(1, 0, 0.62, 0),
		Position = UDim2.fromScale(0, -0.06),
		Stroke = false,
		ZIndex = face.ZIndex + 1,
		Parent = face,
	})
	UIKit.text({
		Text = props.Label,
		Size = UDim2.new(1, 4, 0.34, 0),
		Position = UDim2.new(0, -2, 0.66, 0),
		Font = UIKit.Font.Title,
		Stroke = 2,
		ZIndex = face.ZIndex + 1,
		Parent = face,
	})
	local dot = new("Frame", {
		Name = "Dot",
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -8, 0, -8),
		BackgroundColor3 = T.Red,
		Visible = false,
		ZIndex = face.ZIndex + 3,
		Parent = holder,
	})
	UIKit.corner(dot, 11)
	UIKit.stroke(dot, 3)
	UIKit.text({
		Text = "!",
		Size = UDim2.fromScale(1, 1),
		Font = UIKit.Font.Title,
		Stroke = false,
		ZIndex = face.ZIndex + 4,
		Parent = dot,
	})
	return holder, face, dot
end

-- Ikona mince složená z kruhů
function UIKit.coin(parent: Instance, size: number, position: UDim2?, zIndex: number?)
	local z = zIndex or 2
	local coin = new("Frame", {
		Name = "Coin",
		Size = UDim2.fromOffset(size, size),
		Position = position or UDim2.new(),
		BackgroundColor3 = T.Gold,
		ZIndex = z,
		Parent = parent,
	})
	UIKit.corner(coin, size)
	UIKit.stroke(coin, math.max(2, size / 14))
	UIKit.shade(coin, 0.18)
	local inner = new("Frame", {
		Size = UDim2.fromScale(0.62, 0.62),
		Position = UDim2.fromScale(0.19, 0.19),
		BackgroundColor3 = Color3.fromRGB(255, 220, 90),
		ZIndex = z + 1,
		Parent = coin,
	})
	UIKit.corner(inner, size)
	new("UIStroke", { Thickness = math.max(1, size / 22), Color = Color3.fromRGB(214, 138, 0), Parent = inner })
	local slot = new("Frame", {
		Size = UDim2.fromScale(0.16, 0.42),
		Position = UDim2.fromScale(0.42, 0.29),
		BackgroundColor3 = Color3.fromRGB(214, 138, 0),
		BorderSizePixel = 0,
		ZIndex = z + 2,
		Parent = coin,
	})
	UIKit.corner(slot, 3)
	return coin
end

-- Lišta s výplní a textem
function UIKit.bar(props)
	local background = new("Frame", {
		Name = props.Name or "Bar",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = T.Dark,
		Parent = props.Parent,
	})
	UIKit.corner(background, props.Radius or 12)
	UIKit.stroke(background, 3)
	local fill = new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = props.Color or T.Sand,
		Parent = background,
	})
	UIKit.corner(fill, props.Radius or 12)
	UIKit.shade(fill, 0.2)
	local shine = new("Frame", {
		Size = UDim2.new(1, -6, 0.3, 0),
		Position = UDim2.new(0, 3, 0, 3),
		BackgroundColor3 = T.White,
		BackgroundTransparency = 0.7,
		Parent = fill,
	})
	UIKit.corner(shine, 8)
	local label = UIKit.text({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		Text = "",
		Font = UIKit.Font.Title,
		ZIndex = 3,
		Parent = background,
	})
	return background, fill, label
end

-- Posuvník 0..1 (hlasitost)
function UIKit.slider(props)
	local value = props.Value or 0.5
	local track = new("Frame", {
		Name = "Slider",
		Size = props.Size or UDim2.fromOffset(260, 22),
		Position = props.Position or UDim2.new(),
		BackgroundColor3 = T.PanelDeep,
		Parent = props.Parent,
	})
	UIKit.corner(track, 11)
	UIKit.stroke(track, 3)
	local fill =
		new("Frame", { Size = UDim2.fromScale(value, 1), BackgroundColor3 = props.Color or T.Orange, Parent = track })
	UIKit.corner(fill, 11)
	local knob = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(34, 34),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(value, 0.5),
		BackgroundColor3 = T.White,
		ZIndex = 3,
		Parent = track,
	})
	UIKit.corner(knob, 17)
	UIKit.stroke(knob, 3)

	local dragging = false
	local function set(v: number, fire: boolean)
		value = math.clamp(v, 0, 1)
		fill.Size = UDim2.fromScale(value, 1)
		knob.Position = UDim2.fromScale(value, 0.5)
		if fire and props.OnChanged then
			props.OnChanged(value)
		end
	end
	local function fromInput(input: InputObject)
		local x = input.Position.X
		local abs = track.AbsolutePosition.X
		local width = math.max(1, track.AbsoluteSize.X)
		set((x - abs) / width, true)
	end
	local function begin(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			fromInput(input)
		end
	end
	track.InputBegan:Connect(begin)
	knob.InputBegan:Connect(begin)
	UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			fromInput(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = false
		end
	end)
	return track, function(v)
		set(v, false)
	end
end

-- Přepínač ON/OFF
function UIKit.toggle(props)
	local on = props.Value == true
	local holder, face
	holder, face = UIKit.button({
		Size = props.Size or UDim2.fromOffset(120, 50),
		Position = props.Position,
		Color = if on then T.Green else T.Gray,
		Text = if on then "ON" else "OFF",
		Parent = props.Parent,
		OnClick = function()
			on = not on
			face.Text = if on then "ON" else "OFF"
			UIKit.setButtonColor(holder, if on then T.Green else T.Gray)
			if props.OnChanged then
				props.OnChanged(on)
			end
		end,
	})
	return holder,
		function(v: boolean)
			on = v
			face.Text = if on then "ON" else "OFF"
			UIKit.setButtonColor(holder, if on then T.Green else T.Gray)
		end
end

function UIKit.pop(instance: Instance, from: number?)
	local scale = instance:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = instance })
	scale.Scale = from or 0.6
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
	return scale
end

return UIKit
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000021">
					<Properties>
						<string name="Name">Windows</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Windows – okna hry: SHOP (3D náhledy nástrojů), STORE (Robux), REBIRTH,
	INDEX (artefakty), CODES, TOP (globální žebříček) a SETTINGS.
	Při otevřeném okně se pozadí rozmaže a ztmaví.
]]

local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ToolFactory = require(ReplicatedStorage.Shared.ToolFactory)
local Util = require(ReplicatedStorage.Shared.Util)
local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme
local F = UIKit.Font
local new = UIKit.new

local Windows = {}

local player = Players.LocalPlayer
local ctx = nil
local gui: ScreenGui
local dim: Frame
local blur: BlurEffect
local windows = {}
local openName: string? = nil
local state = nil
local prices = {}
local spinners = {}

local TIER_COLORS = { T.Gray, Color3.fromRGB(176, 122, 74), T.Blue, T.Blue, T.Purple, T.Gold, T.Purple, T.Gold }

---------------------------------------------------------------------
-- Rám okna
---------------------------------------------------------------------

local function newWindow(name: string, title: string, color: Color3, size: Vector2): Frame
	local frame = new("Frame", {
		Name = name .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 14),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = T.Panel,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	})
	UIKit.corner(frame, 26)
	UIKit.stroke(frame, 5)
	UIKit.shade(frame, 0.06)
	local scale = new("UIScale", { Parent = frame })

	local header = new(
		"Frame",
		{ Name = "Header", Size = UDim2.new(1, 0, 0, 74), BackgroundColor3 = color, ZIndex = 21, Parent = frame }
	)
	UIKit.corner(header, 26)
	UIKit.shade(header, 0.22)
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.new(0, 0, 1, -26),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 21,
		Parent = header,
	})
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = T.Outline,
		BorderSizePixel = 0,
		ZIndex = 22,
		Parent = header,
	})
	UIKit.text({
		Text = title,
		Position = UDim2.fromOffset(24, 10),
		Size = UDim2.new(1, -120, 1, -18),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = F.Title,
		Stroke = 3,
		ZIndex = 23,
		Parent = header,
	})
	UIKit.button({
		Size = UDim2.fromOffset(56, 60),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 6),
		Color = T.Red,
		Text = "X",
		Radius = 28,
		ZIndex = 24,
		Parent = header,
		OnClick = function()
			Windows.close()
		end,
	})
	local content = new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 90),
		Size = UDim2.new(1, -40, 1, -106),
		ZIndex = 21,
		Parent = frame,
	})
	windows[name] = { Frame = frame, Scale = scale }
	return content
end

local function scroll(parent: Instance, position: UDim2, size: UDim2): ScrollingFrame
	local frame = new("ScrollingFrame", {
		Position = position,
		Size = size,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = T.Outline,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 22,
		Parent = parent,
	})
	UIKit.padding(frame, 6, 6)
	return frame
end

local function tabs(parent: Instance, list, onSelect)
	local bar =
		new("Frame", { Size = UDim2.new(1, 0, 0, 54), BackgroundTransparency = 1, ZIndex = 22, Parent = parent })
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), Parent = bar })
	local holders = {}
	local function selectTab(key)
		for k, holder in holders do
			UIKit.setButtonColor(holder, if k == key then list[k].Color else T.Gray)
		end
		onSelect(key)
	end
	for key, info in list do
		holders[key] = UIKit.button({
			Size = UDim2.fromOffset(info.Width or 200, 54),
			Color = T.Gray,
			Text = info.Text,
			LayoutOrder = info.Order,
			ZIndex = 22,
			Parent = bar,
			OnClick = function()
				selectTab(key)
			end,
		})
	end
	return selectTab
end

---------------------------------------------------------------------
-- SHOP
---------------------------------------------------------------------

local function ownsItem(category: string, item): boolean
	if not state then
		return false
	end
	if category == "Tool" then
		if item.Pass then
			return state.Passes[item.Pass] == true
		end
		return state.OwnedTools[item.Id] == true
	end
	return state.OwnedBackpacks[item.Id] == true
end

local function promptPass(key: string)
	local pass = Config.GamePasses[key]
	if not pass then
		return
	end
	if state and state.Passes[key] then
		ctx.toast("You already own " .. pass.Name, "success")
	elseif pass.Id == 0 then
		ctx.toast("This gamepass is not set up yet (developer: add its ID in Config)", "error")
	else
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	end
end

local function promptProduct(key: string)
	local product = Config.Products[key]
	if product.Id == 0 then
		ctx.toast("This product is not set up yet (developer: add its ID in Config)", "error")
	else
		MarketplaceService:PromptProductPurchase(player, product.Id)
	end
end

local function toolPreview(parent: Instance, toolId: string, icon: string)
	local box = new("Frame", {
		Size = UDim2.new(1, -16, 0, 128),
		Position = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Color3.fromRGB(125, 80, 40),
		ZIndex = 23,
		Parent = parent,
	})
	UIKit.corner(box, 14)
	UIKit.shade(box, 0.5)
	if toolId == "Hands" or toolId == "" then
		UIKit.text({
			Text = icon,
			Size = UDim2.fromScale(0.7, 0.8),
			Position = UDim2.fromScale(0.15, 0.1),
			Stroke = false,
			ZIndex = 24,
			Parent = box,
		})
		return box
	end
	local viewport = new("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 160, 150),
		LightColor = Color3.fromRGB(255, 245, 230),
		LightDirection = Vector3.new(-1, -1.5, -1),
		ZIndex = 24,
		Parent = box,
	})
	local camera = new("Camera", { FieldOfView = 32, Parent = viewport })
	viewport.CurrentCamera = camera
	local model = ToolFactory.createModel(toolId)
	model.Parent = viewport
	local ok, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	local center = if ok and cf then cf.Position else Vector3.zero
	local radius = if ok and size then math.max(size.X, size.Y, size.Z) else 4
	table.insert(
		spinners,
		{ Camera = camera, Center = center, Distance = radius * 1.7 + 1.5, Angle = math.random() * 6 }
	)
	return box
end

local function buildShop()
	local content = newWindow("Shop", "🛒 SHOP", T.Orange, Vector2.new(840, 580))
	local lists = {}
	local cards = {}
	local selectTab = tabs(content, {
		Tool = { Text = "⛏️ TOOLS", Color = T.Orange, Order = 1, Width = 220 },
		Backpack = { Text = "🎒 BACKPACKS", Color = T.Blue, Order = 2, Width = 260 },
	}, function(key)
		for k, list in lists do
			list.Visible = k == key
		end
	end)
	for _, category in { "Tool", "Backpack" } do
		local list = scroll(content, UDim2.fromOffset(0, 66), UDim2.new(1, 0, 1, -66))
		list.Visible = category == "Tool"
		new("UIGridLayout", {
			CellSize = UDim2.fromOffset(240, 292),
			CellPadding = UDim2.fromOffset(14, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = list,
		})
		lists[category] = list
		local items = if category == "Tool" then Config.Tools else Config.Backpacks
		for index, item in items do
			local tier = TIER_COLORS[index] or T.Gold
			local card = new("Frame", { BackgroundColor3 = T.Panel, LayoutOrder = index, ZIndex = 22, Parent = list })
			UIKit.corner(card, 18)
			local stroke = UIKit.stroke(card, 4, tier)
			if category == "Tool" then
				toolPreview(card, item.Id, item.Icon or "")
			else
				toolPreview(card, "", item.Icon or "🎒")
			end
			UIKit.text({
				Text = string.upper(item.Name),
				Position = UDim2.fromOffset(10, 142),
				Size = UDim2.new(1, -20, 0, 32),
				TextColor3 = T.Text,
				Font = F.Title,
				Stroke = false,
				ZIndex = 23,
				Parent = card,
			})
			local stats
			if category == "Tool" then
				stats = ("Size %.1f  •  Reach %d\n%.1f digs / sec"):format(item.Radius, item.Reach, 1 / item.Cooldown)
			else
				stats = ("Holds %s sand"):format(Util.formatNumber(item.Capacity))
			end
			UIKit.text({
				Text = stats,
				Position = UDim2.fromOffset(10, 176),
				Size = UDim2.new(1, -20, 0, 44),
				TextColor3 = T.SubText,
				Font = F.Small,
				Stroke = false,
				ZIndex = 23,
				Parent = card,
			})
			local holder, face = UIKit.button({
				Size = UDim2.new(1, -20, 0, 58),
				Position = UDim2.new(0, 10, 1, -66),
				Color = T.Green,
				Text = "",
				ZIndex = 23,
				Parent = card,
				OnClick = function()
					if not state then
						return
					end
					local owned = ownsItem(category, item)
					if category == "Tool" and item.Pass and not owned then
						promptPass(item.Pass)
						return
					end
					local remote = if owned then Remotes.EquipItem else Remotes.BuyItem
					local ok, message = remote:InvokeServer(category, item.Id)
					ctx.toast(message or "", if ok then "success" else "error")
					ctx.sfx(if ok and not owned then "Buy" elseif ok then "Click" else "Error")
				end,
			})
			table.insert(
				cards,
				{ Category = category, Item = item, Holder = holder, Face = face, Stroke = stroke, Tier = tier }
			)
		end
	end
	selectTab("Tool")

	windows.Shop.Tab = selectTab
	windows.Shop.Refresh = function()
		for _, c in cards do
			local item = c.Item
			local owned = ownsItem(c.Category, item)
			local equipped = (c.Category == "Tool" and state.EquippedTool == item.Id)
				or (c.Category == "Backpack" and state.EquippedBackpack == item.Id)
			if equipped then
				c.Face.Text = "✅ EQUIPPED"
				UIKit.setButtonColor(c.Holder, T.Gray)
				c.Stroke.Color = T.Green
			elseif owned then
				c.Face.Text = "EQUIP"
				UIKit.setButtonColor(c.Holder, T.Blue)
				c.Stroke.Color = c.Tier
			elseif item.Pass then
				local pass = Config.GamePasses[item.Pass]
				c.Face.Text = pass.Icon .. " " .. pass.Name .. " ONLY"
				UIKit.setButtonColor(c.Holder, T.Purple)
				c.Stroke.Color = T.Purple
			else
				c.Face.Text = "💰 " .. Util.formatNumber(item.Price)
				UIKit.setButtonColor(c.Holder, if state.Coins >= item.Price then T.Green else T.Gray)
				c.Stroke.Color = c.Tier
			end
		end
	end
end

---------------------------------------------------------------------
-- STORE (Robux)
---------------------------------------------------------------------

local PASS_COLORS = {
	VIP = T.Gold,
	DoubleCoins = T.Orange,
	AutoSell = Color3.fromRGB(255, 210, 40),
	TreasureRadar = T.Green,
	BigBackpack = T.Blue,
	FastDig = T.Red,
}
local RIBBONS = { VIP = "BEST", AutoSell = "POPULAR" }

local function buildStore()
	local content = newWindow("Store", "💎 STORE", T.Purple, Vector2.new(860, 600))
	local list = scroll(content, UDim2.new(), UDim2.fromScale(1, 1))
	new("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	local rows = {}

	local function header(order: number, text: string)
		UIKit.text({
			Text = text,
			Size = UDim2.new(1, 0, 0, 36),
			LayoutOrder = order,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = T.Text,
			Font = F.Title,
			Stroke = false,
			ZIndex = 22,
			Parent = list,
		})
	end

	header(1, "⭐ GAMEPASSES – YOURS FOREVER")
	-- pevná výška mřížky (spolehlivější než AutomaticSize)
	local passRows = math.ceil(#Config.GamePassOrder / 2)
	local passGrid = new("Frame", {
		Size = UDim2.new(1, 0, 0, passRows * 182),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		ZIndex = 22,
		Parent = list,
	})
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(384, 168),
		CellPadding = UDim2.fromOffset(14, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = passGrid,
	})
	for index, key in Config.GamePassOrder do
		local pass = Config.GamePasses[key]
		local color = PASS_COLORS[key] or T.Gold
		local card = new(
			"Frame",
			{ BackgroundColor3 = UIKit.lighten(color, 0.42), LayoutOrder = index, ZIndex = 22, Parent = passGrid }
		)
		UIKit.corner(card, 20)
		UIKit.stroke(card, 4)
		UIKit.shade(card, 0.15)
		local iconBox = new("Frame", {
			Size = UDim2.fromOffset(112, 112),
			Position = UDim2.fromOffset(14, 14),
			BackgroundColor3 = UIKit.darken(color, 0.25),
			ZIndex = 23,
			Parent = card,
		})
		UIKit.corner(iconBox, 56)
		UIKit.stroke(iconBox, 4)
		UIKit.text({
			Text = pass.Icon,
			Size = UDim2.fromScale(0.7, 0.7),
			Position = UDim2.fromScale(0.15, 0.15),
			Stroke = false,
			ZIndex = 24,
			Parent = iconBox,
		})
		UIKit.text({
			Text = string.upper(pass.Name),
			Position = UDim2.fromOffset(138, 12),
			Size = UDim2.new(1, -150, 0, 38),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = F.Title,
			Stroke = 3,
			ZIndex = 23,
			Parent = card,
		})
		UIKit.text({
			Text = pass.Description,
			Position = UDim2.fromOffset(138, 52),
			Size = UDim2.new(1, -150, 0, 48),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Font = F.Small,
			TextColor3 = T.Outline,
			Stroke = false,
			ZIndex = 23,
			Parent = card,
		})
		local holder, face = UIKit.button({
			Size = UDim2.fromOffset(170, 52),
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -12, 1, -10),
			Color = T.Green,
			Text = "",
			ZIndex = 23,
			Parent = card,
			OnClick = function()
				promptPass(key)
			end,
		})
		if RIBBONS[key] then
			local ribbon = new("Frame", {
				Size = UDim2.fromOffset(120, 32),
				Position = UDim2.new(1, -110, 0, -12),
				BackgroundColor3 = T.Red,
				Rotation = 8,
				ZIndex = 26,
				Parent = card,
			})
			UIKit.corner(ribbon, 10)
			UIKit.stroke(ribbon, 3)
			UIKit.text({
				Text = RIBBONS[key],
				Size = UDim2.fromScale(1, 1),
				Font = F.Title,
				ZIndex = 27,
				Parent = ribbon,
			})
		end
		table.insert(rows, { Kind = "Pass", Key = key, Holder = holder, Face = face, Price = pass.Price })
	end

	header(3, "⚡ BOOSTS & COINS")
	local productRows = math.ceil(#Config.ProductOrder / 4)
	local productGrid = new("Frame", {
		Size = UDim2.new(1, 0, 0, productRows * 233),
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		ZIndex = 22,
		Parent = list,
	})
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(186, 220),
		CellPadding = UDim2.fromOffset(13, 13),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = productGrid,
	})
	for index, key in Config.ProductOrder do
		local product = Config.Products[key]
		local color = if key == "ServerLuck" then T.Green else T.Gold
		local card =
			new("Frame", { BackgroundColor3 = T.PanelDark, LayoutOrder = index, ZIndex = 22, Parent = productGrid })
		UIKit.corner(card, 18)
		UIKit.stroke(card, 4, UIKit.darken(color, 0.2))
		UIKit.text({
			Text = product.Icon,
			Position = UDim2.fromOffset(0, 10),
			Size = UDim2.new(1, 0, 0, 70),
			Stroke = false,
			ZIndex = 23,
			Parent = card,
		})
		UIKit.text({
			Text = string.upper(product.Name),
			Position = UDim2.fromOffset(8, 84),
			Size = UDim2.new(1, -16, 0, 44),
			TextColor3 = T.Text,
			Font = F.Title,
			Stroke = false,
			ZIndex = 23,
			Parent = card,
		})
		local desc = if product.Coins
			then "+" .. Util.formatNumber(product.Coins) .. " coins\n× (rebirths + 1)"
			else "Rarer chests for\nEVERYONE!"
		UIKit.text({
			Text = desc,
			Position = UDim2.fromOffset(8, 128),
			Size = UDim2.new(1, -16, 0, 34),
			TextColor3 = T.SubText,
			Font = F.Small,
			Stroke = false,
			ZIndex = 23,
			Parent = card,
		})
		local holder, face = UIKit.button({
			Size = UDim2.new(1, -20, 0, 48),
			Position = UDim2.new(0, 10, 1, -56),
			Color = T.Green,
			Text = "",
			ZIndex = 23,
			Parent = card,
			OnClick = function()
				promptProduct(key)
			end,
		})
		table.insert(rows, { Kind = "Product", Key = key, Holder = holder, Face = face, Price = product.Price })
	end

	windows.Store.Refresh = function()
		for _, row in rows do
			if row.Kind == "Pass" and state.Passes[row.Key] then
				row.Face.Text = "✅ OWNED"
				UIKit.setButtonColor(row.Holder, T.Gray)
			else
				row.Face.Text = "R$ " .. tostring(prices[row.Kind .. row.Key] or row.Price)
				UIKit.setButtonColor(row.Holder, T.Green)
			end
		end
	end

	task.spawn(function()
		for key, pass in Config.GamePasses do
			if pass.Id ~= 0 then
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(pass.Id, Enum.InfoType.GamePass)
				end)
				if ok and info and info.PriceInRobux then
					prices["Pass" .. key] = info.PriceInRobux
				end
			end
		end
		for key, product in Config.Products do
			if product.Id ~= 0 then
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(product.Id, Enum.InfoType.Product)
				end)
				if ok and info and info.PriceInRobux then
					prices["Product" .. key] = info.PriceInRobux
				end
			end
		end
	end)
end

---------------------------------------------------------------------
-- REBIRTH
---------------------------------------------------------------------

local function buildRebirth()
	local content = newWindow("Rebirth", "♻️ REBIRTH", T.Cyan, Vector2.new(620, 520))
	local multi = UIKit.text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 74),
		Font = F.Title,
		TextColor3 = T.Green,
		Stroke = 4,
		ZIndex = 22,
		Parent = content,
	})
	UIKit.text({
		Text = "COINS FOREVER",
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 0, 30),
		Font = F.Title,
		TextColor3 = T.Text,
		Stroke = false,
		ZIndex = 22,
		Parent = content,
	})
	local info = new("Frame", {
		Position = UDim2.fromOffset(20, 116),
		Size = UDim2.new(1, -40, 0, 96),
		BackgroundColor3 = T.PanelDark,
		ZIndex = 22,
		Parent = content,
	})
	UIKit.corner(info, 16)
	UIKit.stroke(info, 3)
	UIKit.text({
		Text = "❌ Coins, tools & backpacks reset",
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 34),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = T.Red,
		Font = F.Body,
		Stroke = false,
		ZIndex = 23,
		Parent = info,
	})
	UIKit.text({
		Text = "✅ Artifacts, gamepasses & leaderboard stay",
		Position = UDim2.fromOffset(16, 52),
		Size = UDim2.new(1, -32, 0, 34),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UIKit.darken(T.Green, 0.2),
		Font = F.Body,
		Stroke = false,
		ZIndex = 23,
		Parent = info,
	})
	local _, fill, label = UIKit.bar({
		Position = UDim2.fromOffset(20, 230),
		Size = UDim2.new(1, -40, 0, 52),
		Color = T.Gold,
		Parent = content,
	})
	local holder = UIKit.button({
		Size = UDim2.fromOffset(320, 76),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Color = T.Cyan,
		Text = "♻️ REBIRTH",
		ZIndex = 22,
		Parent = content,
		OnClick = function()
			local ok, message = Remotes.Rebirth:InvokeServer()
			ctx.toast(message or "", if ok then "epic" else "error")
			if ok then
				ctx.sfx("Rebirth", 0.9)
				ctx.flash(T.Cyan, 0.6)
				ctx.bigPopup("♻️ REBIRTH!", T.Cyan)
				Windows.close()
			else
				ctx.sfx("Error")
			end
		end,
	})
	windows.Rebirth.Refresh = function()
		local per = Config.Rebirth.MultiplierPerRebirth
		multi.Text = ("x%.1f  ➜  x%.1f"):format(1 + state.Rebirths * per, 1 + (state.Rebirths + 1) * per)
		local fraction = math.clamp(state.Coins / math.max(1, state.RebirthCost), 0, 1)
		fill.Size = UDim2.fromScale(math.max(fraction, 0.02), 1)
		label.Text = ("💰 %s / %s"):format(Util.formatNumber(state.Coins), Util.formatNumber(state.RebirthCost))
		UIKit.setButtonColor(holder, if fraction >= 1 then T.Cyan else T.Gray)
	end
end

---------------------------------------------------------------------
-- INDEX (artefakty)
---------------------------------------------------------------------

local function buildIndex()
	local content = newWindow("Index", "📜 ARTIFACT INDEX", Color3.fromRGB(196, 130, 66), Vector2.new(860, 580))
	local summary = UIKit.text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 34),
		TextColor3 = T.Text,
		Font = F.Title,
		Stroke = false,
		ZIndex = 22,
		Parent = content,
	})
	local total = 0
	for _, name in Config.RarityOrder do
		total += Config.Rarities[name].Weight
	end
	local odds = {}
	for _, name in Config.RarityOrder do
		local weight = Config.Rarities[name].Weight
		if weight > 0 then
			table.insert(odds, ("%s %d%%"):format(name, math.floor(weight / total * 100 + 0.5)))
		end
	end
	UIKit.text({
		Text = "Chest odds: " .. table.concat(odds, " • ") .. "  (deeper = rarer, Mythic only in the ruins)",
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 22),
		TextColor3 = T.SubText,
		Font = F.Small,
		Stroke = false,
		ZIndex = 22,
		Parent = content,
	})
	local grid = scroll(content, UDim2.fromOffset(0, 66), UDim2.new(1, 0, 1, -66))
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(148, 186),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local cells = {}
	for index, artifact in Config.Artifacts do
		local rarity = Config.Rarities[artifact.Rarity]
		local cell = new(
			"Frame",
			{ BackgroundColor3 = UIKit.lighten(rarity.Color, 0.7), LayoutOrder = index, ZIndex = 22, Parent = grid }
		)
		UIKit.corner(cell, 16)
		UIKit.stroke(cell, 4, rarity.Color)
		UIKit.shade(cell, 0.12)
		local icon = UIKit.text({
			Text = "❓",
			Position = UDim2.fromOffset(0, 10),
			Size = UDim2.new(1, 0, 0, 76),
			Stroke = false,
			ZIndex = 23,
			Parent = cell,
		})
		local name = UIKit.text({
			Text = "???",
			Position = UDim2.fromOffset(6, 92),
			Size = UDim2.new(1, -12, 0, 40),
			TextColor3 = T.Text,
			Font = F.Title,
			Stroke = false,
			ZIndex = 23,
			Parent = cell,
		})
		UIKit.text({
			Text = string.upper(artifact.Rarity) .. ("  +%d%%"):format(math.floor(artifact.Bonus * 100 + 0.5)),
			Position = UDim2.fromOffset(6, 140),
			Size = UDim2.new(1, -12, 0, 30),
			TextColor3 = rarity.Color,
			Font = F.Title,
			Stroke = 2,
			ZIndex = 23,
			Parent = cell,
		})
		local count = UIKit.text({
			Text = "",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 6),
			Size = UDim2.fromOffset(50, 26),
			TextXAlignment = Enum.TextXAlignment.Right,
			Font = F.Title,
			ZIndex = 24,
			Parent = cell,
		})
		cells[artifact.Id] = { Icon = icon, Name = name, Count = count, Artifact = artifact }
	end
	windows.Index.Refresh = function()
		local collected = 0
		for id, cell in cells do
			local owned = state.Artifacts[id] or 0
			if owned > 0 then
				collected += 1
				cell.Icon.Text = cell.Artifact.Icon
				cell.Name.Text = string.upper(cell.Artifact.Name)
				cell.Count.Text = "x" .. owned
			else
				cell.Icon.Text = "❓"
				cell.Name.Text = "???"
				cell.Count.Text = ""
			end
		end
		summary.Text = ("COLLECTED %d/%d  •  BONUS +%d%% COINS"):format(
			collected,
			#Config.Artifacts,
			math.floor(state.ArtifactBonus * 100 + 0.5)
		)
	end
end

