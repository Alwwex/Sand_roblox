	<Item class="ServerScriptService" referent="RBX00000013">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Folder" referent="RBX00000012">
			<Properties>
				<string name="Name">Server</string>
			</Properties>
			<Item class="Script" referent="RBX00000007">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DUNE DIGGERS – hlavní serverový skript
	Spouští všechny služby ve správném pořadí.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
require(ReplicatedStorage.Shared.Remotes) -- vytvoří RemoteEventy

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local WorldService = require(Services.WorldService)
local TreasureService = require(Services.TreasureService)
local ShopService = require(Services.ShopService)
local DigService = require(Services.DigService)
local MonetizationService = require(Services.MonetizationService)
local SandstormService = require(Services.SandstormService)

-- Postavy spawnujeme až když je svět hotový
Players.CharacterAutoLoads = false

DataService.init()
MonetizationService.init()

print("[Dune Diggers] Generuji poušť...")
local started = os.clock()
WorldService.init()
TreasureService.init()
TreasureService.populate()
ShopService.init()
DigService.init()
WorldService.setReady(true)
SandstormService.start()
print(("[Dune Diggers] Svět hotový za %.1f s"):format(os.clock() - started))

---------------------------------------------------------------------
-- Hráči
---------------------------------------------------------------------

local function spawnCharacter(player: Player)
	if player.Parent and DataService.get(player) then
		player:LoadCharacter()
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	-- CharacterAdded přijde dřív, než je postava ve Workspace – počkáme
	if not character:IsDescendantOf(workspace) then
		character.AncestryChanged:Wait()
	end
	player:WaitForChild("Backpack", 10)
	task.wait()
	if player.Character ~= character then
		return
	end
	ShopService.giveTool(player)

	-- VIP: zlaté jméno nad hlavou
	if player:GetAttribute("VIP") then
		humanoid.DisplayName = "👑 " .. player.DisplayName
	end

	humanoid.Died:Connect(function()
		task.delay(Config.RespawnTime, function()
			if player.Character == character then
				spawnCharacter(player)
			end
		end)
	end)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	local session = DataService.loadPlayer(player)
	if not session then
		return
	end
	MonetizationService.loadPasses(player)
	DataService.syncNow(player)

	while not WorldService.isReady() and player.Parent do
		task.wait(0.5)
	end
	spawnCharacter(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX00000011">
				<Properties>
					<string name="Name">Services</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000008">
					<Properties>
						<string name="Name">DataService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DataService – ukládání hráčských dat (DataStore) + posílání dat klientovi.

	- Načítá data s jednoduchým "zámkem" (aby se data nepřepsala, když hráč
	  rychle přejde na jiný server).
	- Automaticky ukládá každou minutu, při odchodu hráče a při vypnutí serveru.
	- Ve Studiu bez zapnutého "Studio Access to API Services" hra funguje,
	  jen se nic neukládá (v Output uvidíš varování).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Stats = require(script.Parent.Stats)

local STORE_NAME = "DuneDiggers_PlayerData_v1"
local AUTOSAVE_INTERVAL = 60
local LOCK_TIMEOUT = 150 -- po kolika sekundách se "zámek" z jiného serveru považuje za mrtvý
local SYNC_INTERVAL = 0.1

local DataService = {}

local sessions = {} -- [Player] = session
local store = nil

local IS_STUDIO = RunService:IsStudio()

local function defaultData()
	return {
		Coins = Config.Economy.StartingCoins,
		Sand = 0,
		TotalSand = 0,
		Rebirths = 0,
		OwnedTools = { Hands = true },
		EquippedTool = "Hands",
		OwnedBackpacks = { Pocket = true },
		EquippedBackpack = "Pocket",
		Artifacts = {},
		Codes = {},
		Receipts = {},
		ChestsOpened = 0,
		FirstJoin = os.time(),
	}
end

-- Doplní chybějící klíče (když přidáš do hry nové věci, staré uložené hry je dostanou)
local function reconcile(data, template)
	for key, value in template do
		if data[key] == nil then
			if type(value) == "table" then
				data[key] = table.clone(value)
			else
				data[key] = value
			end
		end
	end
	return data
end

local function dataKey(player: Player): string
	return "Player_" .. player.UserId
end

local function getStore()
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	return store
end

local function createLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats

	leaderstats.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local coins = leaderstats:FindFirstChild("Coins")
	local rebirths = leaderstats:FindFirstChild("Rebirths")
	if coins then
		coins.Value = math.min(data.Coins, 2 ^ 53)
	end
	if rebirths then
		rebirths.Value = data.Rebirths
	end
end

-- Načte data s retry a zámkem. Vrací (ok, data, canSave)
local function loadFromStore(player: Player)
	local dataStore = getStore()
	if not dataStore then
		return false, nil
	end

	local key = dataKey(player)
	for attempt = 1, 8 do
		local lockedByOther = false
		local loaded = nil
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(old)
				if old and old.Lock and old.Lock.JobId ~= game.JobId and os.time() - old.Lock.Time < LOCK_TIMEOUT then
					lockedByOther = true
					return nil -- zrušit zápis
				end
				local data = old or defaultData()
				data.Lock = { JobId = game.JobId, Time = os.time() }
				loaded = data
				return data
			end)
		end)

		if ok and loaded then
			return true, loaded
		elseif ok and lockedByOther then
			warn(("[DataService] Data hráče %s jsou otevřená na jiném serveru, čekám..."):format(player.Name))
			if attempt >= 6 then
				-- Starý server se asi zasekl – převezmeme data
				local forced = nil
				local forceOk = pcall(function()
					dataStore:UpdateAsync(key, function(old)
						local data = old or defaultData()
						data.Lock = { JobId = game.JobId, Time = os.time() }
						forced = data
						return data
					end)
				end)
				if forceOk and forced then
					return true, forced
				end
			end
			task.wait(5)
		else
			warn("[DataService] Načtení dat selhalo:", err)
			if IS_STUDIO then
				-- Ve Studiu nečekáme – nejspíš není zapnutý přístup k API
				return false, nil
			end
			task.wait(2 * attempt)
		end

		if not player.Parent then
			return false, nil
		end
	end
	return false, nil
end

local function saveToStore(player: Player, session, releaseLock: boolean): boolean
	if not session.CanSave then
		return true
	end
	local dataStore = getStore()
	if not dataStore then
		return false
	end

	local data = session.Data
	if releaseLock then
		data.Lock = nil
	else
		data.Lock = { JobId = game.JobId, Time = os.time() }
	end

	local key = dataKey(player)
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(old)
				-- Pokud mezitím data převzal jiný server, nepřepisujeme je
				if old and old.Lock and old.Lock.JobId ~= game.JobId and os.time() - old.Lock.Time < LOCK_TIMEOUT then
					return nil
				end
				return data
			end)
		end)
		if ok then
			return true
		end
		warn("[DataService] Uložení selhalo:", err)
		task.wait(attempt)
	end
	return false
end

---------------------------------------------------------------------
-- Veřejné API
---------------------------------------------------------------------

function DataService.get(player: Player)
	return sessions[player]
end

-- Počká, dokud se hráči nenačtou data (max timeout sekund)
function DataService.waitFor(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 30)
	while not sessions[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return sessions[player]
end

function DataService.markDirty(player: Player)
	local session = sessions[player]
	if session then
		session.Dirty = true
	end
end

function DataService.buildPayload(session)
	local data = session.Data
	return {
		Coins = data.Coins,
		Sand = data.Sand,
		TotalSand = data.TotalSand,
		Capacity = Stats.capacity(session),
		Rebirths = data.Rebirths,
		RebirthCost = Stats.rebirthCost(data),
		CoinMultiplier = Stats.coinMultiplier(session),
		DigSpeed = Stats.digSpeed(session),
		OwnedTools = data.OwnedTools,
		EquippedTool = data.EquippedTool,
		OwnedBackpacks = data.OwnedBackpacks,
		EquippedBackpack = data.EquippedBackpack,
		Artifacts = data.Artifacts,
		ArtifactBonus = Stats.artifactBonus(data),
		Passes = session.Passes,
		InGroup = session.InGroup,
		ChestsOpened = data.ChestsOpened,
	}
end

function DataService.syncNow(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	session.Dirty = false
	updateLeaderstats(player, session.Data)
	Remotes.DataSync:FireClient(player, DataService.buildPayload(session))
end

-- Okamžité uložení (používá se po nákupu za Robux)
function DataService.saveNow(player: Player): boolean
	local session = sessions[player]
	if not session then
		return false
	end
	return saveToStore(player, session, false)
end

function DataService.notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function DataService.notifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

-- Načte hráče. Vrací session nebo nil (když se data nepodařilo načíst)
function DataService.loadPlayer(player: Player)
	local ok, data = loadFromStore(player)
	local canSave = ok

	if not ok then
		if IS_STUDIO then
			warn(
				"[DataService] Data se ve Studiu NEUKLÁDAJÍ. Zapni: Game Settings > Security > "
					.. "Enable Studio Access to API Services (hra musí být publikovaná)."
			)
			data = defaultData()
		else
			if player.Parent then
				player:Kick("Could not load your data. Please rejoin in a moment!")
			end
			return nil
		end
	end

	if not player.Parent then
		-- hráč mezitím odešel – uvolníme zámek
		if canSave then
			saveToStore(player, { Data = data, CanSave = true }, true)
		end
		return nil
	end

	reconcile(data, defaultData())

	if IS_STUDIO and Config.Testing.StudioStartCoins > 0 and data.Coins < Config.Testing.StudioStartCoins then
		data.Coins = Config.Testing.StudioStartCoins
	end

	local session = {
		Data = data,
		Passes = {},
		InGroup = false,
		CanSave = canSave,
		Dirty = true,
		LastDig = 0,
		LastSellTouch = 0,
		LastCampTeleport = 0,
		LastFullNotice = 0,
	}

	if Config.Group.Id and Config.Group.Id > 0 then
		local groupOk, inGroup = pcall(function()
			return player:IsInGroup(Config.Group.Id)
		end)
		session.InGroup = groupOk and inGroup == true
	end

	createLeaderstats(player)
	sessions[player] = session
	return session
end

function DataService.releasePlayer(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	saveToStore(player, session, true)
	sessions[player] = nil
end

function DataService.init()
	getStore()

	-- Synchronizace dat ke klientům (max 10x za sekundu)
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < SYNC_INTERVAL then
			return
		end
		accumulator = 0
		for player, session in sessions do
			if session.Dirty then
				DataService.syncNow(player)
			end
		end
	end)

	-- Autosave
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player, session in sessions do
				task.spawn(saveToStore, player, session, false)
			end
		end
	end)

	Remotes.GetData.OnServerInvoke = function(player)
		local session = sessions[player]
		if not session then
			return nil
		end
		return DataService.buildPayload(session)
	end

	-- Uložení všech při vypnutí serveru
	game:BindToClose(function()
		local pending = 0
		for player, session in sessions do
			pending += 1
			task.spawn(function()
				saveToStore(player, session, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		DataService.releasePlayer(player)
	end)
end

return DataService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000009">
					<Properties>
						<string name="Name">DigService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DigService – kopání. Klient pošle "kde chci kopat", server vše ověří
	(vzdálenost, cooldown, nástroj v ruce, místo v batohu) a teprve pak kope.
	Díky tomu se kopání nedá jednoduše hacknout.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local Stats = require(script.Parent.Stats)
local TreasureService = require(script.Parent.TreasureService)
local WorldService = require(script.Parent.WorldService)

local DigService = {}

local function isFiniteVector(v: Vector3): boolean
	for _, n in { v.X, v.Y, v.Z } do
		if n ~= n or n == math.huge or n == -math.huge then
			return false
		end
	end
	return true
end

local function handleDig(player: Player, target)
	if typeof(target) ~= "Vector3" or not isFiniteVector(target) then
		return
	end
	if not WorldService.isReady() then
		return
	end
	local session = DataService.get(player)
	if not session then
		return
	end
	local data = session.Data

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	-- Hráč musí držet svůj nástroj
	local held = character:FindFirstChildOfClass("Tool")
	if not held or held:GetAttribute("DigToolId") ~= data.EquippedTool then
		return
	end
	local tool = Config.ToolsById[data.EquippedTool]
	if not tool then
		return
	end

	-- Cooldown (s malou tolerancí na lag)
	local now = os.clock()
	local cooldown = tool.Cooldown / Stats.digSpeed(session)
	if now - session.LastDig < cooldown * 0.8 then
		return
	end

	-- Dosah
	if (target - root.Position).Magnitude > tool.Reach + 8 or not WorldService.inBounds(target) then
		return
	end

	-- Plný batoh
	local capacity = Stats.capacity(session)
	if data.Sand >= capacity then
		if session.Passes.AutoSell then
			ShopService.sell(player, true)
		else
			if now - session.LastFullNotice > 4 then
				session.LastFullNotice = now
				DataService.notify(player, "Your bag is full! Sell your sand at the camp 💰", "full")
			end
			return
		end
	end

	session.LastDig = now
	local removed = WorldService.digSphere(target, tool.Radius)
	if removed <= 0 then
		return
	end

	local amount = math.max(1, math.floor(removed + 0.5))
	local gained = math.min(amount, capacity - data.Sand)
	data.Sand += gained
	data.TotalSand += gained
	DataService.markDirty(player)
	Remotes.DigResult:FireClient(player, gained, target, data.Sand >= capacity)

	TreasureService.onDig(player, target, tool.Radius)

	if session.Passes.AutoSell and data.Sand >= capacity then
		ShopService.sell(player, true)
	end
end

function DigService.init()
	Remotes.Dig.OnServerEvent:Connect(handleDig)
end

return DigService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000A">
					<Properties>
						<string name="Name">MonetizationService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	MonetizationService – gamepassy a developer produkty (nákupy za Robux).

	- Gamepassy: koupí se jednou, platí navždy. Ověřují se při připojení
	  a hned po nákupu (bez nutnosti se znovu připojit).
	- Developer produkty: dají se kupovat opakovaně (mince, Server Luck).
	  Zpracování přes ProcessReceipt s ochranou proti dvojímu připsání.

	ID se vyplňují v ReplicatedStorage > Shared > Config (GamePasses / Products).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local MonetizationService = {}

local MAX_STORED_RECEIPTS = 100

local function passKeyFromId(passId: number): string?
	for key, pass in Config.GamePasses do
		if pass.Id ~= 0 and pass.Id == passId then
			return key
		end
	end
	return nil
end

local function productKeyFromId(productId: number): string?
	for key, product in Config.Products do
		if product.Id ~= 0 and product.Id == productId then
			return key
		end
	end
	return nil
end

-- Aktivuje gamepass pro hráče
local function grantPass(player: Player, key: string, announce: boolean)
	local session = DataService.get(player)
	if not session or session.Passes[key] then
		return
	end
	session.Passes[key] = true
	player:SetAttribute("Pass_" .. key, true)
	if key == "VIP" then
		player:SetAttribute("VIP", true)
		-- Po koupi VIP dostane hráč Zlatou lopatu do ruky (pokud nemá lepší nástroj)
		local current = Config.ToolsById[session.Data.EquippedTool]
		local golden = Config.ToolsById.GoldenShovel
		if announce and golden and (not current or current.Index < golden.Index) then
			session.Data.EquippedTool = "GoldenShovel"
			ShopService.giveTool(player)
		end
	end
	DataService.markDirty(player)
	if announce then
		local pass = Config.GamePasses[key]
		DataService.notify(player, ("%s %s activated! Thank you! ❤️"):format(pass.Icon, pass.Name), "epic")
	end
end

-- Zkontroluje všechny gamepassy hráče (volá se po načtení dat)
function MonetizationService.loadPasses(player: Player)
	local giveAll = RunService:IsStudio() and Config.Testing.GiveAllPassesInStudio
	for key, pass in Config.GamePasses do
		if giveAll then
			grantPass(player, key, false)
		elseif pass.Id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and owns then
				grantPass(player, key, false)
			end
		end
	end
end

---------------------------------------------------------------------
-- Developer produkty
---------------------------------------------------------------------

local PRODUCT_HANDLERS = {}

local function grantCoins(player: Player, session, baseCoins: number)
	local coins = baseCoins * (session.Data.Rebirths + 1)
	session.Data.Coins += coins
	DataService.notify(player, ("💰 +%s coins! Thank you! ❤️"):format(Util.formatNumber(coins)), "epic")
end

PRODUCT_HANDLERS.CoinsSmall = function(player, session)
	grantCoins(player, session, Config.Products.CoinsSmall.Coins)
end
PRODUCT_HANDLERS.CoinsMedium = function(player, session)
	grantCoins(player, session, Config.Products.CoinsMedium.Coins)
end
PRODUCT_HANDLERS.CoinsLarge = function(player, session)
	grantCoins(player, session, Config.Products.CoinsLarge.Coins)
end
PRODUCT_HANDLERS.ServerLuck = function(player, _session)
	local now = os.time()
	local current = workspace:GetAttribute("ServerLuckUntil") or 0
	local base = math.max(now, current)
	workspace:SetAttribute("ServerLuckUntil", base + Config.Products.ServerLuck.LuckMinutes * 60)
	DataService.notifyAll(
		("🍀 %s activated SERVER LUCK! Rarer chests for everyone for %d minutes!"):format(
			player.DisplayName,
			Config.Products.ServerLuck.LuckMinutes
		),
		"epic"
	)
end

local function trimReceipts(receipts)
	local count = 0
	local oldestKey, oldestTime = nil, math.huge
	for key, time in receipts do
		count += 1
		if time < oldestTime then
			oldestKey, oldestTime = key, time
		end
	end
	if count > MAX_STORED_RECEIPTS and oldestKey then
		receipts[oldestKey] = nil
	end
end

local function processReceipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local session = DataService.get(player)
	if not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = session.Data
	local purchaseId = tostring(receiptInfo.PurchaseId)
	if data.Receipts[purchaseId] then
		-- už jsme to připsali dřív
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local key = productKeyFromId(receiptInfo.ProductId)
	local handler = key and PRODUCT_HANDLERS[key]
	if not handler then
		warn("[Monetization] Neznámý produkt ID:", receiptInfo.ProductId, "– doplň ho do Config.Products")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, err = pcall(handler, player, session)
	if not ok then
		warn("[Monetization] Chyba při připsání produktu:", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	data.Receipts[purchaseId] = os.time()
	trimReceipts(data.Receipts)
	DataService.markDirty(player)

	if not DataService.saveNow(player) then
		-- Data se nepodařilo uložit – Roblox zkusí nákup zpracovat znovu později.
		-- Účtenka je už zapsaná v paměti, takže se nákup v tomto serveru nepřipíše dvakrát.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.init()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		if not wasPurchased then
			return
		end
		local key = passKeyFromId(passId)
		if key then
			grantPass(player, key, true)
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt

	-- Upozornění pro vývojáře
	local missing = {}
	for key, pass in Config.GamePasses do
		if pass.Id == 0 then
			table.insert(missing, key)
		end
	end
	if #missing > 0 then
		warn(
			"[Monetization] Gamepassy bez ID (nejdou koupit): "
				.. table.concat(missing, ", ")
				.. ". Vytvoř je na create.roblox.com a vlož ID do Config.GamePasses."
		)
	end
end

return MonetizationService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000B">
					<Properties>
						<string name="Name">SandstormService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	SandstormService – písečná bouře.
	Když hráči vykopou velkou část pouště (nebo uplyne čas), přijde bouře,
	všechny odnese do tábora a poušť se znovu zasype – s novými poklady
	a ruinami na jiném místě. Díky tomu hra "nikdy nedojde".

	Stav se posílá klientům přes atributy na Workspace:
	  DesertCleared (0..1), StormPhase ("Calm"/"Warning"/"Active"), StormIn (sekundy)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local TreasureService = require(script.Parent.TreasureService)
local WorldService = require(script.Parent.WorldService)

local S = Config.Sandstorm

local SandstormService = {}

local phase = "Calm"
local nextStorm = 0
local warningEnds = 0

local function setPhase(newPhase: string)
	phase = newPhase
	workspace:SetAttribute("StormPhase", newPhase)
end

local function runStorm()
	setPhase("Active")
	local started = os.clock()
	WorldService.setReady(false)

	-- Všechny odneseme do tábora, aby je písek nezasypal
	for _, player in Players:GetPlayers() do
		task.spawn(WorldService.teleportToCamp, player)
	end
	task.wait(1)

	TreasureService.clearAll()
	WorldService.regenerate()
	TreasureService.populate()

	local elapsed = os.clock() - started
	if elapsed < S.MinStormTime then
		task.wait(S.MinStormTime - elapsed)
	end

	WorldService.setReady(true)
	nextStorm = os.time() + S.Interval
	setPhase("Calm")
	DataService.notifyAll("🏜️ The storm is over! The desert is full of NEW treasures. Start digging!", "epic")
end

function SandstormService.forceStorm()
	if phase == "Calm" then
		nextStorm = os.time()
	end
end

function SandstormService.start()
	nextStorm = os.time() + S.Interval
	setPhase("Calm")

	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			workspace:SetAttribute("DesertCleared", WorldService.getClearedFraction())

			if phase == "Calm" then
				workspace:SetAttribute("StormIn", math.max(0, nextStorm - now))
				if
					WorldService.isReady()
					and (WorldService.getClearedFraction() >= S.ClearedThreshold or now >= nextStorm)
				then
					warningEnds = now + S.WarningTime
					setPhase("Warning")
					DataService.notifyAll(
						("🌪️ A SANDSTORM is coming in %d seconds! The desert will be buried again!"):format(
							S.WarningTime
						),
						"storm"
					)
				end
			elseif phase == "Warning" then
				workspace:SetAttribute("StormIn", math.max(0, warningEnds - now))
				if now >= warningEnds then
					task.spawn(runStorm)
				end
			end
		end
	end)
end

return SandstormService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000C">
					<Properties>
						<string name="Name">ShopService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	ShopService – prodej písku, obchod s nástroji/batohy, rebirth, kódy,
	teleport do tábora a výdej nástroje do ruky.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local Stats = require(script.Parent.Stats)
local ToolFactory = require(script.Parent.ToolFactory)
local WorldService = require(script.Parent.WorldService)

local ShopService = {}

---------------------------------------------------------------------
-- Nástroj v ruce
---------------------------------------------------------------------

function ShopService.giveTool(player: Player)
	local session = DataService.get(player)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not session or not character or not backpack then
		return
	end

	-- Pojistka: když hráč přišel o gamepass nástroj, vrátíme ho k nejlepšímu vlastněnému
	if not Stats.ownsTool(session, session.Data.EquippedTool) then
		session.Data.EquippedTool = "Hands"
		for _, tool in Config.Tools do
			if Stats.ownsTool(session, tool.Id) then
				session.Data.EquippedTool = tool.Id
			end
		end
	end

	for _, container in { backpack, character } do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("DigToolId") then
				child:Destroy()
			end
		end
	end

	local tool = ToolFactory.create(session.Data.EquippedTool)
	tool.Parent = backpack
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(tool)
	end
end

---------------------------------------------------------------------
-- Prodej
---------------------------------------------------------------------

function ShopService.sell(player: Player, isAuto: boolean?): number
	local session = DataService.get(player)
	if not session then
		return 0
	end
	local data = session.Data
	if data.Sand <= 0 then
		return 0
	end
	local sand = data.Sand
	local coins = math.floor(sand * Config.Economy.CoinsPerSand * Stats.coinMultiplier(session))
	data.Sand = 0
	data.Coins += coins
	DataService.markDirty(player)
	Remotes.Sold:FireClient(player, coins, sand, isAuto == true)
	return coins
end

---------------------------------------------------------------------
-- Nákupy za mince
---------------------------------------------------------------------

local function buyItem(player: Player, category: string, id: string)
	local session = DataService.get(player)
	if not session or type(category) ~= "string" or type(id) ~= "string" then
		return false, "Not ready yet"
	end
	local data = session.Data

	if category == "Tool" then
		local tool = Config.ToolsById[id]
		if not tool then
			return false, "Unknown tool"
		end
		if tool.Pass then
			return false, "This tool comes with the " .. Config.GamePasses[tool.Pass].Name .. " gamepass"
		end
		if data.OwnedTools[id] then
			return false, "You already own this"
		end
		if data.Coins < tool.Price then
			return false, ("You need %s more coins"):format(Util.formatNumber(tool.Price - data.Coins))
		end
		data.Coins -= tool.Price
		data.OwnedTools[id] = true
		data.EquippedTool = id
		DataService.markDirty(player)
		ShopService.giveTool(player)
		return true, ("Bought %s!"):format(tool.Name)
	elseif category == "Backpack" then
		local backpack = Config.BackpacksById[id]
		if not backpack then
			return false, "Unknown backpack"
		end
		if data.OwnedBackpacks[id] then
			return false, "You already own this"
		end
		if data.Coins < backpack.Price then
			return false, ("You need %s more coins"):format(Util.formatNumber(backpack.Price - data.Coins))
		end
		data.Coins -= backpack.Price
		data.OwnedBackpacks[id] = true
		data.EquippedBackpack = id
		DataService.markDirty(player)
		return true, ("Bought %s!"):format(backpack.Name)
	end
	return false, "Unknown item"
end

local function equipItem(player: Player, category: string, id: string)
	local session = DataService.get(player)
	if not session or type(category) ~= "string" or type(id) ~= "string" then
		return false, "Not ready yet"
	end
	local data = session.Data

	if category == "Tool" then
		if not Stats.ownsTool(session, id) then
			return false, "You don't own this tool"
		end
		data.EquippedTool = id
		DataService.markDirty(player)
		ShopService.giveTool(player)
		return true, "Equipped " .. Config.ToolsById[id].Name
	elseif category == "Backpack" then
		if not data.OwnedBackpacks[id] or not Config.BackpacksById[id] then
			return false, "You don't own this backpack"
		end
		data.EquippedBackpack = id
		DataService.markDirty(player)
		return true, "Equipped " .. Config.BackpacksById[id].Name
	end
	return false, "Unknown item"
end

local function rebirth(player: Player)
	local session = DataService.get(player)
	if not session then
		return false, "Not ready yet"
	end
	local data = session.Data
	local cost = Stats.rebirthCost(data)
	if data.Coins < cost then
		return false, ("You need %s coins to rebirth"):format(Util.formatNumber(cost))
	end
	data.Rebirths += 1
	data.Coins = 0
	data.Sand = 0
	data.OwnedTools = { Hands = true }
	data.OwnedBackpacks = { Pocket = true }
	data.EquippedBackpack = "Pocket"
	-- Nasadíme nejlepší nástroj, který hráči zůstal (např. Golden Shovel z VIP)
	data.EquippedTool = "Hands"
	for _, tool in Config.Tools do
		if Stats.ownsTool(session, tool.Id) then
			data.EquippedTool = tool.Id
		end
	end
	DataService.markDirty(player)
	ShopService.giveTool(player)
	DataService.notifyAll(("♻️ %s reached Rebirth %d!"):format(player.DisplayName, data.Rebirths), "epic")
	return true,
		("Rebirth %d! Coins x%s forever"):format(
			data.Rebirths,
			string.format("%.1f", 1 + data.Rebirths * Config.Rebirth.MultiplierPerRebirth)
		)
end

local function redeemCode(player: Player, rawCode: string)
	local session = DataService.get(player)
	if not session or type(rawCode) ~= "string" or #rawCode > 40 then
		return false, "Invalid code"
	end
	local code = rawCode:upper():gsub("%s", "")
	local reward = Config.Codes[code]
	if not reward then
		return false, "Invalid code"
	end
	local data = session.Data
	if data.Codes[code] then
		return false, "Code already redeemed"
	end
	data.Codes[code] = true
	local coins = 0
	if reward.Coins then
		coins = reward.Coins * (data.Rebirths + 1)
		data.Coins += coins
	end
	DataService.markDirty(player)
	return true, ("Code redeemed! +%s coins"):format(Util.formatNumber(coins))
end

function ShopService.init()
	Remotes.BuyItem.OnServerInvoke = buyItem
	Remotes.EquipItem.OnServerInvoke = equipItem
	Remotes.Rebirth.OnServerInvoke = rebirth
	Remotes.RedeemCode.OnServerInvoke = redeemCode

	Remotes.TeleportCamp.OnServerEvent:Connect(function(player)
		local session = DataService.get(player)
		local character = player.Character
		if not session or not character then
			return
		end
		local now = os.clock()
		if now - session.LastCampTeleport < Config.CampTeleportCooldown then
			DataService.notify(
				player,
				("Wait %ds before teleporting again"):format(
					math.ceil(Config.CampTeleportCooldown - (now - session.LastCampTeleport))
				),
				"error"
			)
			return
		end
		session.LastCampTeleport = now
		WorldService.teleportToCamp(player)
	end)

	-- Výkupna písku (šlápnutí na zlatou plochu)
	local sellPad = WorldService.SellPad
	if sellPad then
		sellPad.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if not player then
				return
			end
			local session = DataService.get(player)
			if not session then
				return
			end
			local now = os.clock()
			if now - session.LastSellTouch < 0.75 then
				return
			end
			session.LastSellTouch = now
			ShopService.sell(player, false)
		end)
	end

	-- Prompty v táboře otevřou okna v UI
	local function addPrompt(part: BasePart?, actionText: string, window: string)
		if not part then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = actionText
		prompt.ObjectText = ""
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = part
		prompt.Triggered:Connect(function(player)
			Remotes.OpenWindow:FireClient(player, window)
		end)
	end
	addPrompt(WorldService.ShopCounter, "Open Shop", "Shop")
	addPrompt(WorldService.RebirthStatue, "Rebirth", "Rebirth")
end

return ShopService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000D">
					<Properties>
						<string name="Name">Stats</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Stats – výpočty násobičů (mince, kapacita, rychlost, štěstí).
	Vše na jednom místě, ať se to snadno ladí.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Stats = {}

function Stats.artifactBonus(data): number
	local bonus = 0
	for artifactId, count in data.Artifacts do
		local artifact = Config.ArtifactsById[artifactId]
		if artifact and count > 0 then
			bonus += artifact.Bonus
		end
	end
	return bonus
end

function Stats.coinMultiplier(session): number
	local data = session.Data
	local multiplier = 1 + data.Rebirths * Config.Rebirth.MultiplierPerRebirth
	multiplier *= 1 + Stats.artifactBonus(data)
	if session.Passes.DoubleCoins then
		multiplier *= Config.PassEffects.DoubleCoins
	end
	if session.Passes.VIP then
		multiplier *= Config.VIP.CoinBonus
	end
	if session.InGroup then
		multiplier *= 1 + Config.Group.CoinBonus
	end
	return multiplier
end

function Stats.capacity(session): number
	local backpack = Config.BackpacksById[session.Data.EquippedBackpack] or Config.Backpacks[1]
	local capacity = backpack.Capacity
	if session.Passes.BigBackpack then
		capacity *= Config.PassEffects.BigBackpack
	end
	return math.floor(capacity)
end

function Stats.digSpeed(session): number
	if session.Passes.FastDig then
		return Config.PassEffects.FastDig
	end
	return 1
end

function Stats.serverLuck(): number
	local luckUntil = workspace:GetAttribute("ServerLuckUntil") or 0
	if os.time() < luckUntil then
		return 2
	end
	return 1
end

function Stats.rebirthCost(data): number
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ data.Rebirths)
end

function Stats.ownsTool(session, toolId: string): boolean
	local tool = Config.ToolsById[toolId]
	if not tool then
		return false
	end
	if tool.Pass then
		return session.Passes[tool.Pass] == true
	end
	return session.Data.OwnedTools[toolId] == true
end

return Stats
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000E">
					<Properties>
						<string name="Name">ToolFactory</string>
						<ProtectedString name="Source"><![CDATA[--[[
	ToolFactory – staví modely nástrojů z Partů (žádné externí modely nejsou potřeba).

	Konvence: nástroj míří dopředu po ose -Z, "nahoru" je +Y.
	Grip = místo, kde ho postava drží (+ lehký náklon špičkou dolů).
	Chceš vlastní model? Viz docs/NAVOD.md – sekce "Vlastní modely nástrojů".
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local ToolFactory = {}

local WOOD = Color3.fromRGB(150, 100, 58)
local METAL = Color3.fromRGB(175, 180, 190)
local DARK = Color3.fromRGB(55, 55, 60)
local GOLD = Color3.fromRGB(255, 200, 60)

local function piece(
	tool: Tool,
	handle: BasePart,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material,
	mesh: Enum.MeshType?
)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = handle.CFrame * offset
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Anchored = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if mesh then
		local specialMesh = Instance.new("SpecialMesh")
		specialMesh.MeshType = mesh
		specialMesh.Parent = part
	end
	-- Klasický Weld s pevným offsetem – spolehlivý i když se nástroj staví mimo Workspace
	local weld = Instance.new("Weld")
	weld.Part0 = handle
	weld.Part1 = part
	weld.C0 = offset
	weld.Parent = part
	part.Parent = tool
	return part
end

local function newHandle(tool: Tool, size: Vector3, color: Color3, material: Enum.Material, transparency: number?): Part
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = size
	handle.Color = color
	handle.Material = material
	handle.Transparency = transparency or 0
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.CFrame = CFrame.new()
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle.Parent = tool
	return handle
end

local function grip(z: number, tiltDegrees: number): CFrame
	return CFrame.new(0, 0, z) * CFrame.Angles(math.rad(tiltDegrees), 0, 0)
end

local BUILDERS = {}

BUILDERS.Hands = function(tool: Tool)
	newHandle(tool, Vector3.new(0.4, 0.4, 0.4), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, 1)
	tool.Grip = CFrame.new()
end

BUILDERS.Spoon = function(tool: Tool)
	local handle = newHandle(tool, Vector3.new(0.22, 0.1, 1.8), METAL, Enum.Material.Metal)
	piece(
		tool,
		handle,
		"Bowl",
		Vector3.new(0.75, 0.22, 0.95),
		CFrame.new(0, 0.02, -1.25),
		METAL,
		Enum.Material.Metal,
		Enum.MeshType.Sphere
	)
	tool.Grip = grip(0.55, 15)
end

BUILDERS.Trowel = function(tool: Tool)
	local handle =
		newHandle(tool, Vector3.new(0.32, 0.32, 1.2), Color3.fromRGB(200, 70, 50), Enum.Material.SmoothPlastic)
	piece(tool, handle, "Ferrule", Vector3.new(0.36, 0.36, 0.25), CFrame.new(0, 0, -0.7), METAL, Enum.Material.Metal)
	piece(tool, handle, "Neck", Vector3.new(0.12, 0.12, 0.5), CFrame.new(0, -0.1, -1), METAL, Enum.Material.Metal)
	piece(tool, handle, "Blade", Vector3.new(0.95, 0.08, 1.4), CFrame.new(0, -0.18, -1.9), METAL, Enum.Material.Metal)
	tool.Grip = grip(0.15, 20)
end

BUILDERS.Shovel = function(tool: Tool)
	local handle = newHandle(tool, Vector3.new(0.25, 0.25, 4.4), WOOD, Enum.Material.Wood)
	piece(tool, handle, "Grip", Vector3.new(0.9, 0.22, 0.22), CFrame.new(0, 0, 2.25), DARK, Enum.Material.SmoothPlastic)
	piece(tool, handle, "Collar", Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, 0, -2.3), DARK, Enum.Material.Metal)
	piece(
		tool,
		handle,
		"Blade",
		Vector3.new(1.4, 0.12, 1.6),
		CFrame.new(0, 0, -3.25),
		Color3.fromRGB(90, 95, 105),
		Enum.Material.Metal
	)
	tool.Grip = grip(1.3, 25)
end

BUILDERS.GoldenShovel = function(tool: Tool)
	local handle = newHandle(tool, Vector3.new(0.27, 0.27, 4.4), Color3.fromRGB(60, 35, 20), Enum.Material.Wood)
	piece(tool, handle, "Grip", Vector3.new(0.95, 0.25, 0.25), CFrame.new(0, 0, 2.25), GOLD, Enum.Material.Metal)
	piece(tool, handle, "Collar", Vector3.new(0.45, 0.45, 0.45), CFrame.new(0, 0, -2.3), GOLD, Enum.Material.Metal)
	local blade =
		piece(tool, handle, "Blade", Vector3.new(1.6, 0.14, 1.8), CFrame.new(0, 0, -3.35), GOLD, Enum.Material.Metal)
	blade.Reflectance = 0.25
	piece(
		tool,
		handle,
		"Gem",
		Vector3.new(0.4, 0.3, 0.4),
		CFrame.new(0, 0.1, -2.75),
		Color3.fromRGB(90, 230, 255),
		Enum.Material.Neon
	)
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = GOLD
	sparkle.Parent = blade
	tool.Grip = grip(1.3, 25)
end

BUILDERS.Vacuum = function(tool: Tool)
	local handle = newHandle(tool, Vector3.new(0.9, 1.1, 1.5), Color3.fromRGB(230, 80, 50), Enum.Material.SmoothPlastic)
	piece(
		tool,
		handle,
		"Tank",
		Vector3.new(0.8, 0.8, 1.2),
		CFrame.new(0, 0.6, 0.4),
		Color3.fromRGB(200, 220, 230),
		Enum.Material.Glass
	)
	piece(
		tool,
		handle,
		"Tube",
		Vector3.new(0.38, 0.38, 3.2),
		CFrame.new(0, -0.15, -2.3),
		DARK,
		Enum.Material.SmoothPlastic
	)
	piece(
		tool,
		handle,
		"Nozzle",
		Vector3.new(1.3, 0.3, 0.5),
		CFrame.new(0, -0.15, -4.05),
		Color3.fromRGB(30, 30, 30),
		Enum.Material.SmoothPlastic
	)
	piece(
		tool,
		handle,
		"Glow",
		Vector3.new(0.45, 0.45, 0.12),
		CFrame.new(0, -0.15, -3.7),
		Color3.fromRGB(90, 230, 255),
		Enum.Material.Neon
	)
	tool.Grip = grip(0.3, 12)
end

BUILDERS.Blaster = function(tool: Tool)
	local handle = newHandle(tool, Vector3.new(1.2, 1.3, 2), Color3.fromRGB(255, 190, 40), Enum.Material.SmoothPlastic)
	piece(
		tool,
		handle,
		"Stripe",
		Vector3.new(1.25, 0.25, 2.05),
		CFrame.new(0, 0.2, 0),
		DARK,
		Enum.Material.SmoothPlastic
	)
	piece(tool, handle, "Barrel", Vector3.new(0.8, 0.8, 2.6), CFrame.new(0, 0, -2.2), DARK, Enum.Material.Metal)
	piece(
		tool,
		handle,
		"Muzzle",
		Vector3.new(1.3, 1.3, 0.6),
		CFrame.new(0, 0, -3.6),
		Color3.fromRGB(255, 190, 40),
		Enum.Material.SmoothPlastic
	)
	piece(
		tool,
		handle,
		"Core",
		Vector3.new(0.9, 0.9, 0.15),
		CFrame.new(0, 0, -3.95),
		Color3.fromRGB(255, 120, 40),
		Enum.Material.Neon
	)
	tool.Grip = grip(0.4, 8)
end

BUILDERS.Excavator = function(tool: Tool)
	local yellow = Color3.fromRGB(255, 196, 30)
	local handle = newHandle(tool, Vector3.new(0.7, 0.7, 5.5), yellow, Enum.Material.Metal)
	piece(tool, handle, "Piston", Vector3.new(0.35, 0.35, 3.5), CFrame.new(0, 0.6, -0.5), METAL, Enum.Material.Metal)
	piece(tool, handle, "Joint", Vector3.new(1, 1, 1), CFrame.new(0, 0, -2.9), DARK, Enum.Material.Metal)
	piece(
		tool,
		handle,
		"BucketBack",
		Vector3.new(3.2, 1.8, 0.3),
		CFrame.new(0, -0.6, -3.5),
		yellow,
		Enum.Material.Metal
	)
	piece(
		tool,
		handle,
		"BucketBottom",
		Vector3.new(3.2, 0.3, 1.8),
		CFrame.new(0, -1.5, -4.3),
		yellow,
		Enum.Material.Metal
	)
	piece(tool, handle, "SideL", Vector3.new(0.25, 1.8, 1.8), CFrame.new(-1.5, -0.6, -4.3), yellow, Enum.Material.Metal)
	piece(tool, handle, "SideR", Vector3.new(0.25, 1.8, 1.8), CFrame.new(1.5, -0.6, -4.3), yellow, Enum.Material.Metal)
	for i = -2, 2 do
		piece(
			tool,
			handle,
			"Tooth",
			Vector3.new(0.35, 0.3, 0.7),
			CFrame.new(i * 0.65, -1.5, -5.4),
			DARK,
			Enum.Material.Metal
		)
	end
	tool.Grip = grip(2.2, 18)
end

function ToolFactory.create(toolId: string): Tool
	local config = Config.ToolsById[toolId] or Config.Tools[1]

	-- Vlastní model: ServerStorage > CustomTools > Tool pojmenovaný podle Id (např. "Spoon")
	local customFolder = ServerStorage:FindFirstChild("CustomTools")
	local custom = customFolder and customFolder:FindFirstChild(config.Id)
	if custom and custom:IsA("Tool") then
		local clone = custom:Clone()
		clone.Name = config.Name
		clone.CanBeDropped = false
		clone:SetAttribute("DigToolId", config.Id)
		return clone
	end

	local tool = Instance.new("Tool")
	tool.Name = config.Name
	tool.ToolTip = config.Name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("DigToolId", config.Id)
	local builder = BUILDERS[config.Id] or BUILDERS.Shovel
	builder(tool)
	return tool
end

return ToolFactory
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000F">
					<Properties>
						<string name="Name">TreasureService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	TreasureService – zakopané truhly, artefakty a relikvie v ruinách.

	Truhly jsou zakopané v písku. Když hráč odkope písek nad truhlou,
	truhla se "odkryje" (rozzáří se) a jde otevřít (ProximityPrompt).
	Hlubší truhly mají větší šanci na vzácnost.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local Stats = require(script.Parent.Stats)
local WorldService = require(script.Parent.WorldService)

local T = Config.Treasure
local W = Config.World

local TreasureService = {}

local rng = Random.new()
local folder: Folder? = nil
local chests = {} -- [Model] = info

---------------------------------------------------------------------
-- Model truhly
---------------------------------------------------------------------

local function chestPart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function buildChest(rarityName: string, cframe: CFrame, isRelic: boolean)
	local rarity = Config.Rarities[rarityName]
	local model = Instance.new("Model")
	model.Name = rarityName .. "Chest"

	local scale = if isRelic then 1.6 else 1
	local bodyColor = rarity.Color
	local material = if rarity.Order >= 4
		then Enum.Material.Metal
		elseif rarity.Order == 1 then Enum.Material.WoodPlanks
		else Enum.Material.SmoothPlastic
	local gold = Color3.fromRGB(255, 205, 70)

	local base = chestPart(model, "Base", Vector3.new(3, 1.8, 2) * scale, cframe, bodyColor, material)
	local hinge = cframe * CFrame.new(0, 1.6 * scale, 1 * scale)
	local lidOffset = CFrame.new(0, -0.35 * scale, -1 * scale)
	local lid = chestPart(
		model,
		"Lid",
		Vector3.new(3, 0.7, 2) * scale,
		hinge * lidOffset,
		bodyColor:Lerp(Color3.new(1, 1, 1), 0.12),
		material
	)
	chestPart(
		model,
		"Trim",
		Vector3.new(3.1, 0.25, 2.1) * scale,
		cframe * CFrame.new(0, 0.9 * scale, 0),
		gold,
		Enum.Material.Metal
	)
	local lock = chestPart(
		model,
		"Lock",
		Vector3.new(0.5, 0.6, 0.2) * scale,
		cframe * CFrame.new(0, 0.9 * scale, -1.05 * scale),
		gold,
		Enum.Material.Neon
	)
	lock.CanCollide = false

	model.PrimaryPart = base

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = (if isRelic then "Ancient Relic" else rarityName .. " Chest")
	prompt.HoldDuration = if isRelic then 1.5 else 0.4
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = base

	model:SetAttribute("Rarity", rarityName)
	model:SetAttribute("Exposed", false)
	model:SetAttribute("IsRelic", isRelic)

	return model, prompt, lid, hinge, lidOffset
end

---------------------------------------------------------------------
-- Rarita
---------------------------------------------------------------------

local function rollRarity(depthFactor: number): string
	local luck = Stats.serverLuck()
	local weights = {}
	local total = 0
	for _, name in Config.RarityOrder do
		local rarity = Config.Rarities[name]
		local weight = rarity.Weight
		if weight > 0 and rarity.Order > 1 then
			weight *= luck * (1 + depthFactor * T.DepthLuck)
		end
		weights[name] = weight
		total += weight
	end
	local roll = rng:NextNumber() * total
	for _, name in Config.RarityOrder do
		roll -= weights[name]
		if roll <= 0 and weights[name] > 0 then
			return name
		end
	end
	return "Common"
end

local function rollArtifact(rarityName: string): string?
	-- Vybere artefakt dané rarity (nebo nižší, když žádný není)
	local order = Config.Rarities[rarityName].Order
	for o = order, 1, -1 do
		local pool = {}
		for _, artifact in Config.Artifacts do
			if Config.Rarities[artifact.Rarity].Order == o then
				table.insert(pool, artifact.Id)
			end
		end
		if #pool > 0 then
			return pool[rng:NextInteger(1, #pool)]
		end
	end
	return nil
end

---------------------------------------------------------------------
-- Odkrytí a otevření
---------------------------------------------------------------------

local function expose(model: Model, info, finder: Player?)
	if info.Exposed then
		return
	end
	info.Exposed = true
	model:SetAttribute("Exposed", true)
	info.Prompt.Enabled = true

	local rarity = Config.Rarities[info.Rarity]
	local base = model.PrimaryPart :: BasePart

	local light = Instance.new("PointLight")
	light.Color = rarity.Color
	light.Range = 12
	light.Brightness = 2
	light.Parent = base

	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(rarity.Color)
	sparkle.LightEmission = 1
	sparkle.Rate = 6 + rarity.Order * 4
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	sparkle.Speed = NumberRange.new(2, 5)
	sparkle.Size = NumberSequence.new(0.5)
	sparkle.Parent = base

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(7, 1.6)
	billboard.StudsOffset = Vector3.new(0, 3.2, 0)
	billboard.MaxDistance = 120
	billboard.LightInfluence = 0
	billboard.Parent = base
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = if info.IsRelic then "✨ ANCIENT RELIC ✨" else string.upper(info.Rarity)
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = rarity.Color
	label.Parent = billboard
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(40, 25, 10)
	stroke.Parent = label

	if info.IsRelic then
		DataService.notifyAll(
			("🏛️ %s uncovered the LOST RUINS! An Ancient Relic awaits..."):format(
				if finder then finder.DisplayName else "Someone"
			),
			"epic"
		)
	elseif finder and rarity.Order >= 2 then
		DataService.notify(
			finder,
			("You uncovered a %s chest!"):format(string.upper(info.Rarity)),
			"rarity:" .. info.Rarity
		)
	end
end

local function openChest(model: Model, info, player: Player)
	if info.Opened or not info.Exposed then
		return
	end
	local session = DataService.get(player)
	if not session then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - (model.PrimaryPart :: BasePart).Position).Magnitude > 16 then
		return
	end

	info.Opened = true
	info.Prompt.Enabled = false

	local data = session.Data
	local rarity = Config.Rarities[info.Rarity]
	local tool = Config.ToolsById[data.EquippedTool]
	local toolTier = if tool then tool.Index else 1
	local coins = rarity.Coins * (1 + (toolTier - 1) * T.ToolTierBonus) * Stats.coinMultiplier(session)
	if session.Passes.TreasureRadar then
		coins *= Config.PassEffects.TreasureRadarCoins
	end

	local artifactId = nil
	local isNew = false
	if rng:NextNumber() <= rarity.ArtifactChance then
		artifactId = rollArtifact(info.Rarity)
		if artifactId then
			local count = data.Artifacts[artifactId] or 0
			isNew = count == 0
			data.Artifacts[artifactId] = count + 1
			if not isNew then
				-- duplikát = bonusové mince
				coins += rarity.Coins * 2 * Stats.coinMultiplier(session)
			end
		end
	end

	coins = math.floor(coins)
	data.Coins += coins
	data.ChestsOpened += 1
	DataService.markDirty(player)

	local position = (model.PrimaryPart :: BasePart).Position
	Remotes.ChestOpened:FireClient(player, info.Rarity, coins, artifactId, isNew, position)

	if info.IsRelic or rarity.Order >= 4 then
		local artifact = artifactId and Config.ArtifactsById[artifactId]
		local suffix = if artifact then (" and found %s %s!"):format(artifact.Icon, artifact.Name) else "!"
		DataService.notifyAll(
			("%s opened a %s chest%s (+%s coins)"):format(
				player.DisplayName,
				string.upper(info.Rarity),
				suffix,
				Util.formatNumber(coins)
			),
			"rarity:" .. info.Rarity
		)
	end

	-- Animace otevření víka, pak zmizí
	local openCFrame = info.Hinge * CFrame.Angles(math.rad(75), 0, 0) * info.LidOffset
	TweenService
		:Create(info.Lid, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = openCFrame })
		:Play()
	task.delay(4, function()
		chests[model] = nil
		model:Destroy()
	end)
end

---------------------------------------------------------------------
-- Spawnování
---------------------------------------------------------------------

local function spawnChest(position: Vector3, rarityName: string, isRelic: boolean, surfaceY: number)
	local cframe = CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local model, prompt, lid, hinge, lidOffset = buildChest(rarityName, cframe, isRelic)
	local info = {
		Rarity = rarityName,
		IsRelic = isRelic,
		Exposed = false,
		Opened = false,
		Prompt = prompt,
		Lid = lid,
		Hinge = hinge,
		LidOffset = lidOffset,
		Top = position + Vector3.new(0, if isRelic then 1.8 else 1.2, 0),
		SurfaceY = surfaceY,
	}
	chests[model] = info
	prompt.Triggered:Connect(function(player)
		openChest(model, info, player)
	end)
	model.Parent = folder
	return model
end

local function randomDesertPoint(): (number, number)
	local half = W.Size / 2 - 10
	local campZone = W.CampHalf + 14
	for _ = 1, 30 do
		local x = rng:NextNumber(-half, half)
		local z = rng:NextNumber(-half, half)
		if math.max(math.abs(x), math.abs(z)) > campZone then
			return x, z
		end
	end
	return half * 0.8, half * 0.8
end

-- useHeightmap = true při generování světa (rychlejší, terén je čerstvý)
local function spawnRandomChest(useHeightmap: boolean): boolean
	for _ = 1, 10 do
		local x, z = randomDesertPoint()
		local surface = if useHeightmap then WorldService.heightAt(x, z) else WorldService.surfaceHeight(x, z)
		if surface >= 8 then
			local y = rng:NextNumber(2, surface - 4)
			local depthFactor = math.clamp(1 - y / 40, 0, 1)
			local rarity = rollRarity(depthFactor)
			spawnChest(Vector3.new(x, y, z), rarity, false, surface)
			return true
		end
	end
	return false
end

local function countChests(): number
	local count = 0
	for _, info in chests do
		if not info.Opened then
			count += 1
		end
	end
	return count
end

---------------------------------------------------------------------
-- Veřejné API
---------------------------------------------------------------------

-- Volá DigService po každém kopnutí
function TreasureService.onDig(player: Player, position: Vector3, radius: number)
	for model, info in chests do
		if not info.Exposed and not info.Opened then
			if (info.Top - position).Magnitude <= radius + 8 then
				if WorldService.coverAt(info.Top) <= T.ExposeThreshold then
					expose(model, info, player)
				end
			end
		end
	end
end

function TreasureService.clearAll()
	for model in chests do
		model:Destroy()
	end
	table.clear(chests)
end

function TreasureService.populate()
	TreasureService.clearAll()

	-- Relikvie v ruinách + pár vzácných truhel kolem
	local ruinsCenter, relicCFrame = WorldService.getRuins()
	if ruinsCenter and relicCFrame then
		spawnChest(relicCFrame.Position, "Mythic", true, W.RuinsBuryHeight)
		for _, degrees in { 30, 150, 270 } do
			local angle = math.rad(degrees) + rng:NextNumber(-0.2, 0.2)
			local offset = Vector3.new(math.cos(angle) * 9, 2, math.sin(angle) * 9)
			local rarity = if rng:NextNumber() < 0.35 then "Legendary" else "Epic"
			spawnChest(ruinsCenter + offset, rarity, false, W.RuinsBuryHeight)
		end
	end

	for _ = 1, T.StartChests do
		spawnRandomChest(true)
	end
end

function TreasureService.init()
	local treasureFolder = Instance.new("Folder")
	treasureFolder.Name = "Treasures"
	treasureFolder.Parent = workspace
	folder = treasureFolder

	-- Doplňování truhel
	task.spawn(function()
		while true do
			task.wait(T.RespawnInterval)
			if WorldService.isReady() and countChests() < T.MaxChests then
				spawnRandomChest(false)
			end
		end
	end)
end

return TreasureService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000010">
					<Properties>
						<string name="Name">WorldService</string>
						<ProtectedString name="Source"><![CDATA[--[[
	WorldService – generuje poušť, tábor, ruiny a řeší kopání do terénu.

	Poušť je z Roblox Terrain (materiál Sand). Kopání = Terrain:FillBall(..., Air).
	Množství vykopaného písku se počítá přesně přes ReadVoxels (před/po).
	Pod pískem je skalní dno (Part) – to vykopat nejde.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local W = Config.World
local Terrain = workspace.Terrain
local SAND = Enum.Material.Sand
local AIR = Enum.Material.Air
local VOXEL = 4
local CHUNK = 64

local WorldService = {}

local rng = Random.new()
local seed = 0
local ready = false
local totalSand = 0
local remainingSand = 0
local ruinsCenter: Vector3? = nil
local relicCFrame: CFrame? = nil
local ruinsModel: Model? = nil
local mapFolder: Folder? = nil
local spawnCFrame = CFrame.new(0, W.CampTop + 4, 0)
local maxY = math.ceil(W.MaxSand / VOXEL) * VOXEL

WorldService.SellPad = nil :: BasePart?
WorldService.ShopCounter = nil :: BasePart?
WorldService.RebirthStatue = nil :: BasePart?

---------------------------------------------------------------------
-- Pomocné funkce
---------------------------------------------------------------------

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function makePart(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

local function cylinder(props): Part
	-- Válec stojící svisle (Roblox válce mají osu X, proto otočení)
	local height = props.Height
	local diameter = props.Diameter
	local position = props.Position
	props.Height = nil
	props.Diameter = nil
	props.Position = nil
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	return makePart(props)
end

local function addBillboard(part: BasePart, text: string, color: Color3, studsSize: Vector2, offset: number)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(studsSize.X, studsSize.Y)
	billboard.StudsOffset = Vector3.new(0, offset, 0)
	billboard.MaxDistance = 250
	billboard.LightInfluence = 0
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color
	label.Parent = billboard

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(60, 35, 15)
	stroke.Parent = label
	return billboard
end

---------------------------------------------------------------------
-- Výšková mapa pouště
---------------------------------------------------------------------

local function rawHeight(x: number, z: number): number
	local s = W.DuneScale
	local n1 = math.noise(x / s, z / s, seed)
	local n2 = math.noise(x / (s * 0.45), z / (s * 0.45), seed + 17.31)
	local n3 = math.noise(x / (s * 0.16), z / (s * 0.16), seed + 41.77)
	local ridge = 1 - math.abs(n2) * 2.2
	return W.BaseSandHeight + n1 * W.DuneHeight * 1.4 + ridge * W.DuneHeight * 0.35 + n3 * 2.5
end

function WorldService.heightAt(x: number, z: number): number
	local h = rawHeight(x, z)

	-- Kopec nad ruinami (aby byly celé zasypané)
	if ruinsCenter then
		local d = Vector2.new(x - ruinsCenter.X, z - ruinsCenter.Z).Magnitude
		local blend = smoothstep((d - W.RuinsRadius) / 30)
		h = math.max(h, lerp(W.RuinsBuryHeight, h, blend))
	end

	-- Kolem tábora je písek zarovnaný s táborem
	local campDistance = math.max(math.abs(x), math.abs(z)) - W.CampHalf
	if campDistance < 48 then
		h = lerp(W.CampTop - 1, h, smoothstep(campDistance / 48))
	end

	return math.clamp(h, W.MinSand, W.MaxSand)
end

---------------------------------------------------------------------
-- Generování terénu
---------------------------------------------------------------------

local function generateTerrain()
	local half = W.Size / 2
	local nx, ny, nz = CHUNK / VOXEL, maxY / VOXEL, CHUNK / VOXEL
	local sum = 0

	for cx = -half, half - CHUNK, CHUNK do
		for cz = -half, half - CHUNK, CHUNK do
			local region = Region3.new(Vector3.new(cx, 0, cz), Vector3.new(cx + CHUNK, maxY, cz + CHUNK))
			local materials = table.create(nx)
			local occupancy = table.create(nx)

			for ix = 1, nx do
				local matX = table.create(ny)
				local occX = table.create(ny)
				for iy = 1, ny do
					matX[iy] = table.create(nz)
					occX[iy] = table.create(nz)
				end

				local wx = cx + (ix - 0.5) * VOXEL
				for iz = 1, nz do
					local wz = cz + (iz - 0.5) * VOXEL
					local h = WorldService.heightAt(wx, wz)
					-- Uvnitř skalního tábora žádný písek (byl by schovaný a nešel by "vidět")
					if math.max(math.abs(wx), math.abs(wz)) < W.CampHalf then
						h = 0
					end
					for iy = 1, ny do
						local bottom = (iy - 1) * VOXEL
						local occ = math.clamp((h - bottom) / VOXEL, 0, 1)
						if occ > 0.02 then
							matX[iy][iz] = SAND
							occX[iy][iz] = occ
							sum += occ
						else
							matX[iy][iz] = AIR
							occX[iy][iz] = 0
						end
					end
				end

				materials[ix] = matX
				occupancy[ix] = occX
			end

			Terrain:WriteVoxels(region, VOXEL, materials, occupancy)
			task.wait()
		end
	end

	totalSand = sum * Config.SandPerVoxel
	remainingSand = totalSand
end

---------------------------------------------------------------------
-- Statické části mapy: dno, okraje, tábor
---------------------------------------------------------------------

local function buildBoundaries(parent: Instance)
	local size = W.Size
	local half = size / 2
	local rockColor = Color3.fromRGB(196, 128, 82)

	makePart({
		Name = "Bedrock",
		Size = Vector3.new(size + 120, 4, size + 120),
		Position = Vector3.new(0, -2, 0),
		Material = Enum.Material.Sandstone,
		Color = Color3.fromRGB(205, 150, 98),
		Parent = parent,
	})

	-- Útesy kolem pouště
	local wallHeight = 110
	local walls = {
		{ Vector3.new(0, wallHeight / 2 - 4, -half - 20), Vector3.new(size + 120, wallHeight, 40) },
		{ Vector3.new(0, wallHeight / 2 - 4, half + 20), Vector3.new(size + 120, wallHeight, 40) },
		{ Vector3.new(-half - 20, wallHeight / 2 - 4, 0), Vector3.new(40, wallHeight, size + 120) },
		{ Vector3.new(half + 20, wallHeight / 2 - 4, 0), Vector3.new(40, wallHeight, size + 120) },
	}
	for i, wall in walls do
		makePart({
			Name = "Cliff" .. i,
			Size = wall[2],
			Position = wall[1],
			Material = Enum.Material.Sandstone,
			Color = rockColor,
			Parent = parent,
		})
	end

	-- Náhodné balvany na útesech (vypadá to přirozeněji)
	local boulderRng = Random.new(1234)
	for _ = 1, 70 do
		local side = boulderRng:NextInteger(1, 4)
		local along = boulderRng:NextNumber(-half, half)
		local out = half + boulderRng:NextNumber(-2, 10)
		local position
		if side == 1 then
			position = Vector3.new(along, 0, -out)
		elseif side == 2 then
			position = Vector3.new(along, 0, out)
		elseif side == 3 then
			position = Vector3.new(-out, 0, along)
		else
			position = Vector3.new(out, 0, along)
		end
		local s = boulderRng:NextNumber(14, 36)
		position += Vector3.new(0, wallHeight - 4 - boulderRng:NextNumber(0, 30), 0)
		makePart({
			Name = "Boulder",
			Size = Vector3.new(s, s * boulderRng:NextNumber(0.6, 1.2), s * boulderRng:NextNumber(0.7, 1.3)),
			CFrame = CFrame.new(position) * CFrame.Angles(
				boulderRng:NextNumber(-0.4, 0.4),
				boulderRng:NextNumber(0, 6.28),
				boulderRng:NextNumber(-0.4, 0.4)
			),
			Material = Enum.Material.Sandstone,
			Color = rockColor:Lerp(Color3.fromRGB(150, 95, 60), boulderRng:NextNumber(0, 0.6)),
			Parent = parent,
		})
	end
end

local function buildPalm(parent: Instance, base: Vector3, lean: number)
	local palm = Instance.new("Model")
	palm.Name = "Palm"
	local trunkColor = Color3.fromRGB(140, 98, 60)
	local position = base
	local direction = Vector3.new(lean, 1, lean * 0.4).Unit
	for i = 1, 6 do
		local segment = 2.6
		local center = position + direction * segment / 2
		makePart({
			Name = "Trunk",
			Size = Vector3.new(1.3 - i * 0.08, segment + 0.3, 1.3 - i * 0.08),
			CFrame = CFrame.lookAt(center, center + direction) * CFrame.Angles(math.rad(90), 0, 0),
			Material = Enum.Material.Wood,
			Color = trunkColor:Lerp(Color3.fromRGB(110, 75, 45), (i % 2) * 0.5),
			Parent = palm,
		})
		position += direction * segment
		direction = (direction + Vector3.new(lean * 0.12, 0, 0)).Unit
	end
	for i = 1, 7 do
		local angle = (i / 7) * math.pi * 2
		local leafDir = Vector3.new(math.cos(angle), -0.35, math.sin(angle)).Unit
		local center = position + leafDir * 3
		makePart({
			Name = "Leaf",
			Size = Vector3.new(1.6, 0.2, 6.5),
			CFrame = CFrame.lookAt(center, center + leafDir),
			Material = Enum.Material.Grass,
			Color = Color3.fromRGB(70, 150, 60):Lerp(Color3.fromRGB(110, 175, 70), (i % 3) / 3),
			Parent = palm,
		})
	end
	palm.Parent = parent
end

local function buildTent(parent: Instance, center: Vector3, color: Color3, title: string): Part
	local tent = Instance.new("Model")
	tent.Name = title .. "Tent"
	local w, d, h = 12, 9, 8
	for _, offset in
		{
			Vector3.new(-w / 2, 0, -d / 2),
			Vector3.new(w / 2, 0, -d / 2),
			Vector3.new(-w / 2, 0, d / 2),
			Vector3.new(w / 2, 0, d / 2),
		}
	do
		cylinder({
			Name = "Pole",
			Height = h,
			Diameter = 0.6,
			Position = center + offset + Vector3.new(0, h / 2, 0),
			Material = Enum.Material.Wood,
			Color = Color3.fromRGB(120, 80, 45),
			Parent = tent,
		})
	end
	-- Střecha (dvě šikmé plachty)
	for _, sign in { -1, 1 } do
		local roofCenter = center + Vector3.new(0, h + 1.2, sign * d / 4)
		makePart({
			Name = "Roof",
			Size = Vector3.new(w + 2, 0.3, d / 2 + 1.8),
			CFrame = CFrame.new(roofCenter) * CFrame.Angles(math.rad(sign * 22), 0, 0),
			Material = Enum.Material.Fabric,
			Color = color,
			Parent = tent,
		})
	end
	local counter = makePart({
		Name = "Counter",
		Size = Vector3.new(w - 1, 3, 2.5),
		Position = center + Vector3.new(0, 1.5, -d / 2 + 1.5),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(160, 110, 65),
		Parent = tent,
	})
	tent.Parent = parent
	addBillboard(counter, title, Color3.fromRGB(255, 240, 200), Vector2.new(12, 3), 9)
	return counter
end

local function buildCamp(parent: Instance)
	local camp = Instance.new("Model")
	camp.Name = "BaseCamp"
	-- Tábor je vždy načtený u všech hráčů (důležité při StreamingEnabled)
	pcall(function()
		camp.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	local top = W.CampTop
	local half = W.CampHalf

	makePart({
		Name = "Mesa",
		Size = Vector3.new(half * 2, top, half * 2),
		Position = Vector3.new(0, top / 2, 0),
		Material = Enum.Material.Sandstone,
		Color = Color3.fromRGB(190, 128, 84),
		Parent = camp,
	})
	makePart({
		Name = "Deck",
		Size = Vector3.new(half * 2 - 6, 0.6, half * 2 - 6),
		Position = Vector3.new(0, top + 0.3, 0),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(176, 124, 76),
		Parent = camp,
	})

	-- Rampy dolů (odkryjí se, až hráči vykopou písek kolem tábora)
	local run = top * 1.7
	for _, dir in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		local topPoint = dir * half + Vector3.new(0, top, 0)
		local bottomPoint = dir * (half + run) + Vector3.new(0, 0, 0)
		local mid = (topPoint + bottomPoint) / 2
		local length = (topPoint - bottomPoint).Magnitude
		makePart({
			Name = "Ramp",
			Size = Vector3.new(10, 1.5, length + 2),
			CFrame = CFrame.lookAt(mid, topPoint),
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(150, 100, 60),
			Parent = camp,
		})
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = Vector3.new(0, top + 0.8, 8)
	spawn.Material = Enum.Material.Sandstone
	spawn.Color = Color3.fromRGB(240, 210, 150)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = camp
	spawnCFrame = CFrame.new(spawn.Position + Vector3.new(0, 4, 0))

	-- Výkupna písku
	local sellPad = makePart({
		Name = "SellPad",
		Size = Vector3.new(12, 1, 12),
		Position = Vector3.new(-17, top + 0.6, -15),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 196, 60),
		Parent = camp,
	})
	addBillboard(sellPad, "💰 SELL SAND", Color3.fromRGB(255, 225, 90), Vector2.new(14, 3.5), 6)
	WorldService.SellPad = sellPad
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90))
	sparkle.Rate = 8
	sparkle.Lifetime = NumberRange.new(1, 1.6)
	sparkle.Speed = NumberRange.new(2, 4)
	sparkle.Size = NumberSequence.new(0.6)
	sparkle.LightEmission = 1
	sparkle.Parent = sellPad

	WorldService.ShopCounter =
		buildTent(camp, Vector3.new(16, top + 0.6, -15), Color3.fromRGB(230, 90, 60), "🛒 TOOL SHOP")

	-- Rebirth socha
	local statue = makePart({
		Name = "RebirthObelisk",
		Size = Vector3.new(4, 14, 4),
		Position = Vector3.new(18, top + 7.6, 16),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(255, 215, 120),
		Parent = camp,
	})
	makePart({
		Name = "ObeliskTip",
		Size = Vector3.new(2.6, 2.6, 2.6),
		CFrame = CFrame.new(statue.Position + Vector3.new(0, 8.3, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(120, 230, 255),
		Parent = camp,
	})
	addBillboard(statue, "♻️ REBIRTH", Color3.fromRGB(150, 235, 255), Vector2.new(10, 2.6), 11)
	WorldService.RebirthStatue = statue

	-- Cedule s názvem hry
	local sign = makePart({
		Name = "Sign",
		Size = Vector3.new(22, 6, 1),
		Position = Vector3.new(0, top + 6, half - 3),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(130, 85, 50),
		Parent = camp,
	})
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local surface = Instance.new("SurfaceGui")
		surface.Face = face
		surface.CanvasSize = Vector2.new(660, 180)
		surface.LightInfluence = 0
		surface.Parent = sign
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = string.upper(Config.GameName)
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextColor3 = Color3.fromRGB(255, 214, 110)
		label.Parent = surface
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 4
		stroke.Color = Color3.fromRGB(70, 40, 20)
		stroke.Parent = label
	end
	for _, x in { -9, 9 } do
		cylinder({
			Name = "SignPost",
			Height = 9,
			Diameter = 0.8,
			Position = Vector3.new(x, top + 4.5, half - 3),
			Material = Enum.Material.Wood,
			Color = Color3.fromRGB(110, 72, 40),
			Parent = camp,
		})
	end

	-- Palmy a pochodně
	buildPalm(camp, Vector3.new(-half + 5, top, -half + 5), 0.15)
	buildPalm(camp, Vector3.new(half - 5, top, half - 9), -0.12)
	buildPalm(camp, Vector3.new(-half + 5, top, half - 6), 0.1)
	buildPalm(camp, Vector3.new(half - 6, top, -half + 5), -0.18)

	for _, position in
		{ Vector3.new(-6, top, 2), Vector3.new(6, top, 2), Vector3.new(-6, top, 14), Vector3.new(6, top, 14) }
	do
		cylinder({
			Name = "Torch",
			Height = 4,
			Diameter = 0.5,
			Position = position + Vector3.new(0, 2, 0),
			Material = Enum.Material.Wood,
			Color = Color3.fromRGB(100, 65, 35),
			Parent = camp,
		})
		local flame = makePart({
			Name = "Flame",
			Size = Vector3.new(0.8, 0.8, 0.8),
			Position = position + Vector3.new(0, 4.4, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 150, 40),
			CanCollide = false,
			Parent = camp,
		})
		local fire = Instance.new("Fire")
		fire.Size = 3
		fire.Heat = 6
		fire.Parent = flame
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 170, 80)
		light.Range = 14
		light.Brightness = 1.2
		light.Parent = flame
	end

	camp.Parent = parent
end

---------------------------------------------------------------------
-- Zasypané ruiny
---------------------------------------------------------------------

local function buildRuins(parent: Instance, center: Vector3)
	if ruinsModel then
		ruinsModel:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "LostRuins"
	local stone = Color3.fromRGB(214, 180, 130)
	local darkStone = Color3.fromRGB(170, 130, 90)
	local r = W.RuinsRadius

	makePart({
		Name = "Floor",
		Size = Vector3.new(r * 2, 1, r * 2),
		Position = center + Vector3.new(0, 0.5, 0),
		Material = Enum.Material.Limestone,
		Color = darkStone,
		Parent = model,
	})

	-- Kruh sloupů (některé jsou rozbité)
	local pillarCount = 10
	local ringRadius = r - 4
	local pillarTops = {}
	for i = 1, pillarCount do
		local angle = (i / pillarCount) * math.pi * 2
		local broken = rng:NextNumber() < 0.3
		local height = if broken then rng:NextNumber(5, 10) else 16
		local base = center + Vector3.new(math.cos(angle) * ringRadius, 1, math.sin(angle) * ringRadius)
		cylinder({
			Name = "Pillar",
			Height = height,
			Diameter = 3.2,
			Position = base + Vector3.new(0, height / 2, 0),
			Material = Enum.Material.Limestone,
			Color = stone,
			Parent = model,
		})
		makePart({
			Name = "PillarCap",
			Size = Vector3.new(4.2, 1, 4.2),
			Position = base + Vector3.new(0, height + 0.5, 0),
			Material = Enum.Material.Limestone,
			Color = darkStone,
			Parent = model,
		})
		pillarTops[i] = if broken then nil else base + Vector3.new(0, height + 1.5, 0)
	end

	-- Trámy mezi celými sloupy
	for i = 1, pillarCount do
		local a = pillarTops[i]
		local b = pillarTops[(i % pillarCount) + 1]
		if a and b then
			local mid = (a + b) / 2
			makePart({
				Name = "Lintel",
				Size = Vector3.new(2.5, 1.6, (a - b).Magnitude + 3),
				CFrame = CFrame.lookAt(mid, b),
				Material = Enum.Material.Limestone,
				Color = stone,
				Parent = model,
			})
		end
	end

	-- Oltář uprostřed se zářícími runami
	makePart({
		Name = "AltarStep",
		Size = Vector3.new(12, 1.5, 12),
		Position = center + Vector3.new(0, 1.75, 0),
		Material = Enum.Material.Limestone,
		Color = darkStone,
		Parent = model,
	})
	local altar = makePart({
		Name = "Altar",
		Size = Vector3.new(7, 3, 7),
		Position = center + Vector3.new(0, 4, 0),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(235, 210, 160),
		Parent = model,
	})
	for _, offset in
		{ Vector3.new(0, 0, -3.55), Vector3.new(0, 0, 3.55), Vector3.new(-3.55, 0, 0), Vector3.new(3.55, 0, 0) }
	do
		local isX = offset.X ~= 0
		makePart({
			Name = "Rune",
			Size = if isX then Vector3.new(0.2, 0.6, 5) else Vector3.new(5, 0.6, 0.2),
			Position = altar.Position + offset,
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(80, 220, 255),
			CanCollide = false,
			Parent = model,
		})
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(80, 220, 255)
	glow.Range = 20
	glow.Brightness = 2
	glow.Parent = altar

	-- Velká hlava sochy napůl zasypaná vedle oltáře
	local head = makePart({
		Name = "StatueHead",
		Size = Vector3.new(7, 8, 7),
		Position = center + Vector3.new(-9, 5, -9),
		Material = Enum.Material.Limestone,
		Color = stone,
		Parent = model,
	})
	makePart({
		Name = "StatueHeaddress",
		Size = Vector3.new(9, 3, 8),
		Position = head.Position + Vector3.new(0, 4.5, 0.5),
		Material = Enum.Material.Limestone,
		Color = Color3.fromRGB(60, 120, 200),
		Parent = model,
	})
	for _, x in { -1.6, 1.6 } do
		makePart({
			Name = "Eye",
			Size = Vector3.new(1.2, 0.6, 0.3),
			Position = head.Position + Vector3.new(x, 1, -3.6),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 200, 60),
			CanCollide = false,
			Parent = model,
		})
	end

	model.Parent = parent
	ruinsModel = model
	relicCFrame = CFrame.new(altar.Position + Vector3.new(0, 3, 0))
end

---------------------------------------------------------------------
-- Osvětlení – teplá pouštní atmosféra
---------------------------------------------------------------------

function WorldService.setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(110, 90, 70)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 128, 105)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = 0.1

	for _, child in Lighting:GetChildren() do
		if
			child:IsA("Atmosphere")
			or child:IsA("Sky")
			or child:IsA("ColorCorrectionEffect")
			or child:IsA("SunRaysEffect")
			or child:IsA("BloomEffect")
		then
			child:Destroy()
		end
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.25
	atmosphere.Color = Color3.fromRGB(232, 205, 165)
	atmosphere.Decay = Color3.fromRGB(205, 150, 100)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 16
	sky.Parent = Lighting

	local colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Saturation = 0.15
	colorCorrection.Contrast = 0.08
	colorCorrection.TintColor = Color3.fromRGB(255, 246, 232)
	colorCorrection.Parent = Lighting

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Intensity = 0.06
	sunRays.Spread = 0.6
	sunRays.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.4
	bloom.Size = 24
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	Terrain:SetMaterialColor(SAND, Color3.fromRGB(228, 192, 130))
end

---------------------------------------------------------------------
-- Veřejné API
---------------------------------------------------------------------

function WorldService.isReady(): boolean
	return ready
end

function WorldService.setReady(value: boolean)
	ready = value
	workspace:SetAttribute("WorldReady", value)
end

function WorldService.getSpawnCFrame(): CFrame
	local offset = Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
	return spawnCFrame + offset
end

-- Bezpečný teleport do tábora (při zapnutém StreamingEnabled nejdřív načte okolí)
function WorldService.teleportToCamp(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local target = WorldService.getSpawnCFrame()
	pcall(function()
		player:RequestStreamAroundAsync(target.Position, 5)
	end)
	if player.Character == character then
		character:PivotTo(target)
	end
end

function WorldService.getRuins(): (Vector3?, CFrame?)
	return ruinsCenter, relicCFrame
end

function WorldService.getMapFolder(): Folder
	return mapFolder :: Folder
end

function WorldService.getClearedFraction(): number
	if totalSand <= 0 then
		return 0
	end
	return math.clamp(1 - remainingSand / totalSand, 0, 1)
end

function WorldService.inBounds(position: Vector3): boolean
	local half = W.Size / 2
	return math.abs(position.X) <= half
		and math.abs(position.Z) <= half
		and position.Y >= -4
		and position.Y <= maxY + 20
end

-- Aktuální výška povrchu (raycast jen do terénu)
local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.FilterDescendantsInstances = { Terrain }

function WorldService.surfaceHeight(x: number, z: number): number
	local result = workspace:Raycast(Vector3.new(x, maxY + 50, z), Vector3.new(0, -(maxY + 60), 0), terrainParams)
	if result then
		return result.Position.Y
	end
	return 0
end

local function sumSand(region: Region3): number
	local materials, occupancies = Terrain:ReadVoxels(region, VOXEL)
	local size = materials.Size
	local total = 0
	for x = 1, size.X do
		local matX, occX = materials[x], occupancies[x]
		for y = 1, size.Y do
			local matY, occY = matX[y], occX[y]
			for z = 1, size.Z do
				if matY[z] == SAND then
					total += occY[z]
				end
			end
		end
	end
	return total
end

-- Vykope kouli písku. Vrací množství písku (už přepočtené přes SandPerVoxel).
function WorldService.digSphere(center: Vector3, radius: number): number
	local padding = Vector3.one * (radius + VOXEL)
	local region = Region3.new(center - padding, center + padding):ExpandToGrid(VOXEL)
	local before = sumSand(region)
	if before <= 0 then
		return 0
	end
	Terrain:FillBall(center, radius, AIR)
	local after = sumSand(region)
	local removed = math.max(0, before - after) * Config.SandPerVoxel
	remainingSand = math.max(0, remainingSand - removed)
	return removed
end

-- Kolik písku je nad daným bodem (0 = odkryté, 1 = plně zasypané)
function WorldService.coverAt(position: Vector3): number
	local min = position + Vector3.new(-3, 0.5, -3)
	local max = position + Vector3.new(3, 6, 3)
	local region = Region3.new(min, max):ExpandToGrid(VOXEL)
	local materials, occupancies = Terrain:ReadVoxels(region, VOXEL)
	local size = materials.Size
	local total, count = 0, 0
	for x = 1, size.X do
		for y = 1, size.Y do
			for z = 1, size.Z do
				count += 1
				if materials[x][y][z] == SAND then
					total += occupancies[x][y][z]
				end
			end
		end
	end
	if count == 0 then
		return 0
	end
	return total / count
end

local function pickRuinsCenter()
	local angle = rng:NextNumber(0, math.pi * 2)
	local distance = rng:NextNumber(W.RuinsMinDistance, W.RuinsMaxDistance)
	local maxDistance = W.Size / 2 - W.RuinsRadius - 12
	distance = math.min(distance, maxDistance)
	return Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
end

-- (Znovu)vygeneruje poušť a ruiny
function WorldService.regenerate()
	seed = rng:NextNumber(1, 10000)
	ruinsCenter = pickRuinsCenter()
	buildRuins(mapFolder :: Folder, ruinsCenter :: Vector3)
	generateTerrain()
end

function WorldService.init()
	WorldService.setReady(false)
	WorldService.setupLighting()

	local folder = Instance.new("Folder")
	folder.Name = "Map"
	folder.Parent = workspace
	mapFolder = folder

	Terrain:Clear()
	buildBoundaries(folder)
	buildCamp(folder)
	WorldService.regenerate()
end

return WorldService
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX0000001B">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00000019">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX00000018">
				<Properties>
					<string name="Name">Client</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000014">
					<Properties>
						<string name="Name">DigController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DigController – ovládání kopání.
	Drž myš / prst (nebo tlačítko na ovladači) s nástrojem v ruce = kopeš.
	Kope se tam, kam míříš. Když míříš moc daleko, kope se před tebou.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DigController = {}

local player = Players.LocalPlayer
local state = nil
local currentTool: Tool? = nil
local digToken = nil
local lastFire = 0
local pointerKind = "Mouse"
local lastTouchPosition: Vector3? = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function updateFilter()
	local ignore = {}
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local effects = workspace:FindFirstChild("ClientEffects")
	if effects then
		table.insert(ignore, effects)
	end
	rayParams.FilterDescendantsInstances = ignore
end

local function getTarget(reach: number): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	if not root or not camera then
		return nil
	end
	updateFilter()

	local ray
	if pointerKind == "Touch" and lastTouchPosition then
		ray = camera:ScreenPointToRay(lastTouchPosition.X, lastTouchPosition.Y)
	elseif pointerKind == "Gamepad" then
		local viewport = camera.ViewportSize
		ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	else
		local mouse = UserInputService:GetMouseLocation()
		ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	end

	local result = workspace:Raycast(ray.Origin, ray.Direction * 400, rayParams)
	if result and (result.Position - root.Position).Magnitude <= reach then
		return result.Position
	end

	-- Záložní cíl: zem kousek před postavou
	local forward = root.CFrame.LookVector * math.min(4, reach * 0.4)
	local origin = root.Position + forward + Vector3.new(0, 2, 0)
	local down = workspace:Raycast(origin, Vector3.new(0, -14, 0), rayParams)
	if down then
		return down.Position
	end
	return nil
end

local function swing(tool: Tool, toolConfig)
	if not toolConfig.Swing then
		return
	end
	-- Výchozí Animate skript přehraje "sek" nástrojem, když najde tento StringValue
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
end

local function startDigging(tool: Tool)
	local token = {}
	digToken = token
	task.spawn(function()
		while digToken == token and tool.Parent == player.Character do
			local toolConfig = Config.ToolsById[tool:GetAttribute("DigToolId")]
			if not toolConfig then
				break
			end
			local speed = if state and state.DigSpeed then state.DigSpeed else 1
			local cooldown = toolConfig.Cooldown / speed
			local waitLeft = lastFire + cooldown - os.clock()
			if waitLeft > 0 then
				task.wait(waitLeft)
				if digToken ~= token then
					break
				end
			end
			local target = getTarget(toolConfig.Reach)
			if target then
				lastFire = os.clock()
				Remotes.Dig:FireServer(target)
				swing(tool, toolConfig)
				task.wait(cooldown)
			else
				task.wait(0.1)
			end
		end
	end)
end

local function stopDigging()
	digToken = nil
end

local watchedTools = setmetatable({}, { __mode = "k" })

local function watchTool(tool: Tool)
	if not tool:GetAttribute("DigToolId") then
		return
	end
	currentTool = tool
	if watchedTools[tool] then
		return
	end
	watchedTools[tool] = true
	tool.Activated:Connect(function()
		startDigging(tool)
	end)
	tool.Deactivated:Connect(stopDigging)
	tool.Unequipped:Connect(stopDigging)
end

local function onCharacter(character: Model)
	stopDigging()
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			watchTool(child)
		end
	end)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			watchTool(child)
		end
	end
end

function DigController.setState(newState)
	state = newState
end

function DigController.getTool(): Tool?
	return currentTool
end

function DigController.init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.Touch then
			pointerKind = "Touch"
			-- dotyky joysticku/tlačítek ignorujeme, chceme jen "tap do světa"
			if not gameProcessed then
				lastTouchPosition = input.Position
			end
		elseif
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseMovement
		then
			pointerKind = "Mouse"
		elseif input.UserInputType.Name:find("Gamepad") then
			pointerKind = "Gamepad"
		end
	end)
	UserInputService.InputChanged:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.Touch then
			if not gameProcessed then
				lastTouchPosition = input.Position
			end
		elseif input.UserInputType == Enum.UserInputType.MouseMovement then
			pointerKind = "Mouse"
		end
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end
end

return DigController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000015">
					<Properties>
						<string name="Name">Effects</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Effects – vizuální efekty na klientovi: prach při kopání, vyskakující čísla,
	písečná bouře, zvuky.
]]

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)

local Effects = {}

local SAND_COLOR = Color3.fromRGB(230, 196, 135)
local effectsFolder = Instance.new("Folder")
effectsFolder.Name = "ClientEffects"
effectsFolder.Parent = workspace

local function anchorPart(position: Vector3): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Position = position
	part.Parent = effectsFolder
	return part
end

function Effects.playSound(name: string, volume: number?, pitch: number?)
	local id = Config.Sounds[name]
	if not id or id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 3)
end

-- Oblak písku při kopání
function Effects.digBurst(position: Vector3, strength: number)
	local part = anchorPart(position)
	local size = math.clamp(strength, 0.6, 4)

	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(SAND_COLOR)
	dust.Size =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8 * size), NumberSequenceKeypoint.new(1, 2.2 * size) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(0.5, 0.9)
	dust.Speed = NumberRange.new(4, 10)
	dust.SpreadAngle = Vector2.new(70, 70)
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Acceleration = Vector3.new(0, -12, 0)
	dust.Drag = 3
	dust.Rate = 0
	dust.LightInfluence = 1
	dust.Parent = part
	dust:Emit(math.clamp(math.floor(size * 5), 4, 24))

	local grains = Instance.new("ParticleEmitter")
	grains.Color = ColorSequence.new(SAND_COLOR, Color3.fromRGB(200, 160, 100))
	grains.Size = NumberSequence.new(0.18 * size)
	grains.Lifetime = NumberRange.new(0.5, 0.8)
	grains.Speed = NumberRange.new(10, 20)
	grains.SpreadAngle = Vector2.new(45, 45)
	grains.EmissionDirection = Enum.NormalId.Top
	grains.Acceleration = Vector3.new(0, -60, 0)
	grains.Rate = 0
	grains.LightInfluence = 1
	grains.Parent = part
	grains:Emit(math.clamp(math.floor(size * 10), 8, 40))

	Debris:AddItem(part, 1.5)
end

-- Vyskakující text ve světě (+12, +500 coins...)
function Effects.popup(position: Vector3, text: string, color: Color3, scale: number?)
	local part = anchorPart(position)
	local s = scale or 1
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(160 * s, 50 * s)
	billboard.StudsOffset = Vector3.new(0, 1.5, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Adornee = part
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color
	label.Parent = billboard
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(50, 30, 10)
	stroke.Parent = label

	local info = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(billboard, info, { StudsOffset = Vector3.new(0, 5, 0) }):Play()
	TweenService:Create(
		label,
		TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.45),
		{ TextTransparency = 1 }
	):Play()
	TweenService:Create(
		stroke,
		TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.45),
		{ Transparency = 1 }
	):Play()
	Debris:AddItem(part, 1.1)
end

-- Exploze mincí z truhly
function Effects.chestBurst(position: Vector3, color: Color3)
	local part = anchorPart(position + Vector3.new(0, 1.5, 0))
	local coins = Instance.new("ParticleEmitter")
	coins.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	coins.Color = ColorSequence.new(Color3.fromRGB(255, 215, 70), color)
	coins.LightEmission = 1
	coins.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0.2) })
	coins.Lifetime = NumberRange.new(0.8, 1.4)
	coins.Speed = NumberRange.new(15, 28)
	coins.SpreadAngle = Vector2.new(40, 40)
	coins.EmissionDirection = Enum.NormalId.Top
	coins.Acceleration = Vector3.new(0, -40, 0)
	coins.Rate = 0
	coins.Parent = part
	coins:Emit(60)
	Debris:AddItem(part, 2)
end

---------------------------------------------------------------------
-- Písečná bouře (jen vizuálně, na klientovi)
---------------------------------------------------------------------

local stormPart: Part? = nil
local stormEmitter: ParticleEmitter? = nil
local stormConnection: RBXScriptConnection? = nil
local defaultAtmosphere = nil

local function getAtmosphere(): Atmosphere?
	return Lighting:FindFirstChildOfClass("Atmosphere")
end

local function ensureStormEmitter()
	if stormPart then
		return
	end
	local part = Instance.new("Part")
	part.Name = "StormVolume"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(80, 40, 80)
	part.Parent = effectsFolder

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(220, 170, 110))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 14) })
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(2, 3)
	emitter.Speed = NumberRange.new(0, 0)
	emitter.Acceleration = Vector3.new(60, -4, 20)
	emitter.Rate = 0
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter.LightInfluence = 1
	emitter.Parent = part

	stormPart = part
	stormEmitter = emitter
	stormConnection = RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if camera and stormPart then
			stormPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(-25, 0, -10))
		end
	end)
end

function Effects.setStorm(phase: string)
	local atmosphere = getAtmosphere()
	if atmosphere and not defaultAtmosphere then
		defaultAtmosphere = { Density = atmosphere.Density, Color = atmosphere.Color, Haze = atmosphere.Haze }
	end

	local info = TweenInfo.new(3, Enum.EasingStyle.Sine)
	if phase == "Warning" then
		ensureStormEmitter()
		if stormEmitter then
			stormEmitter.Rate = 25
		end
		if atmosphere then
			TweenService:Create(atmosphere, info, { Density = 0.5, Haze = 2.5, Color = Color3.fromRGB(215, 160, 100) })
				:Play()
		end
	elseif phase == "Active" then
		ensureStormEmitter()
		if stormEmitter then
			stormEmitter.Rate = 120
		end
		if atmosphere then
			TweenService:Create(atmosphere, info, { Density = 0.78, Haze = 4, Color = Color3.fromRGB(200, 140, 80) })
				:Play()
		end
	else
		if stormEmitter then
			stormEmitter.Rate = 0
		end
		if atmosphere and defaultAtmosphere then
			TweenService:Create(atmosphere, TweenInfo.new(4, Enum.EasingStyle.Sine), defaultAtmosphere):Play()
		end
		task.delay(4, function()
			if workspace:GetAttribute("StormPhase") == "Calm" and stormPart then
				if stormConnection then
					stormConnection:Disconnect()
					stormConnection = nil
				end
				stormPart:Destroy()
				stormPart = nil
				stormEmitter = nil
			end
		end)
	end
end

return Effects
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX00000016">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DUNE DIGGERS – hlavní klientský skript
	Propojuje UI, kopání, efekty a zprávy ze serveru.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local DigController = require(script.Parent:WaitForChild("DigController"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer
local state = nil

UI.init()
DigController.init()

local function applyState(newState)
	if not newState then
		return
	end
	state = newState
	UI.update(newState)
	DigController.setState(newState)
end

Remotes.DataSync.OnClientEvent:Connect(applyState)
task.spawn(function()
	applyState(Remotes.GetData:InvokeServer())
end)

---------------------------------------------------------------------
-- Zprávy ze serveru
---------------------------------------------------------------------

Remotes.Notify.OnClientEvent:Connect(function(message, kind)
	UI.toast(message, kind)
	if kind == "epic" or (type(kind) == "string" and kind:sub(1, 7) == "rarity:") then
		Effects.playSound("Chest", 0.5, 0.9)
	end
end)

Remotes.DigResult.OnClientEvent:Connect(function(amount, position, isFull)
	local tool = state and Config.ToolsById[state.EquippedTool]
	local strength = if tool then tool.Radius / 2.6 else 1
	Effects.digBurst(position, strength)
	Effects.popup(
		position,
		"+" .. Util.formatNumber(amount),
		Color3.fromRGB(255, 225, 140),
		math.min(1.4, 0.8 + strength * 0.15)
	)
	Effects.playSound("Dig", 0.35, 0.9 + math.random() * 0.3)
	if isFull and not (state and state.Passes.AutoSell) then
		Effects.playSound("Click", 0.4, 0.6)
	end
end)

Remotes.Sold.OnClientEvent:Connect(function(coins, sand, isAuto)
	UI.bigPopup("+" .. Util.formatNumber(coins) .. " 💰", Color3.fromRGB(255, 215, 70))
	Effects.playSound("Sell", 0.6, 1)
	if not isAuto then
		UI.toast(("Sold %s sand for %s coins!"):format(Util.formatNumber(sand), Util.formatNumber(coins)), "success")
	end
end)

Remotes.ChestOpened.OnClientEvent:Connect(function(rarityName, coins, artifactId, isNew, position)
	local rarity = Config.Rarities[rarityName]
	local color = if rarity then rarity.Color else Color3.fromRGB(255, 215, 70)
	Effects.chestBurst(position, color)
	Effects.popup(
		position + Vector3.new(0, 2, 0),
		"+" .. Util.formatNumber(coins) .. " 💰",
		Color3.fromRGB(255, 215, 70),
		1.5
	)
	Effects.playSound("Chest", 0.7, 1.1)

	local artifact = artifactId and Config.ArtifactsById[artifactId]
	if artifact then
		if isNew then
			UI.bigPopup(artifact.Icon .. " NEW ARTIFACT!", Config.Rarities[artifact.Rarity].Color)
			UI.toast(
				("%s %s found! +%d%% coins forever"):format(
					artifact.Icon,
					artifact.Name,
					math.floor(artifact.Bonus * 100 + 0.5)
				),
				"rarity:" .. artifact.Rarity
			)
		else
			UI.toast(("%s Duplicate %s → bonus coins!"):format(artifact.Icon, artifact.Name), "info")
		end
	end
end)

Remotes.OpenWindow.OnClientEvent:Connect(function(name)
	UI.open(name)
end)

---------------------------------------------------------------------
-- Písečná bouře
---------------------------------------------------------------------

local function onStormPhase()
	Effects.setStorm(workspace:GetAttribute("StormPhase") or "Calm")
end
workspace:GetAttributeChangedSignal("StormPhase"):Connect(onStormPhase)
onStormPhase()

---------------------------------------------------------------------
-- Treasure Radar (gamepass): zvýrazní nejbližší zakopané truhly
---------------------------------------------------------------------

local RADAR_RANGE = 140
local RADAR_MAX = 8
local radarHighlights = {} -- [Model] = Highlight

task.spawn(function()
	local treasures = workspace:WaitForChild("Treasures")
	while true do
		task.wait(0.5)
		local hasRadar = state and state.Passes.TreasureRadar
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")

		local wanted = {}
		if hasRadar and root then
			local candidates = {}
			for _, chest in treasures:GetChildren() do
				if chest:IsA("Model") and chest.PrimaryPart and not chest:GetAttribute("Exposed") then
					local distance = (chest.PrimaryPart.Position - root.Position).Magnitude
					if distance <= RADAR_RANGE then
						table.insert(candidates, { Chest = chest, Distance = distance })
					end
				end
			end
			table.sort(candidates, function(a, b)
				return a.Distance < b.Distance
			end)
			for i = 1, math.min(RADAR_MAX, #candidates) do
				wanted[candidates[i].Chest] = true
			end
		end

		for chest, highlight in radarHighlights do
			if not wanted[chest] or not chest.Parent then
				highlight:Destroy()
				radarHighlights[chest] = nil
			end
		end
		for chest in wanted do
			if not radarHighlights[chest] then
				local rarity = Config.Rarities[chest:GetAttribute("Rarity")]
				local highlight = Instance.new("Highlight")
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillColor = if rarity then rarity.Color else Color3.new(1, 1, 1)
				highlight.FillTransparency = 0.5
				highlight.OutlineColor = Color3.new(1, 1, 1)
				highlight.Adornee = chest
				highlight.Parent = chest
				radarHighlights[chest] = highlight
			end
		end
	end
end)

---------------------------------------------------------------------
-- VIP štítek v chatu
---------------------------------------------------------------------

pcall(function()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local sender = Players:GetPlayerByUserId(source.UserId)
			if sender and sender:GetAttribute("VIP") then
				properties.PrefixText = "<font color='#FFD23C'>[👑 VIP]</font> " .. message.PrefixText
			end
		end
		return properties
	end
end)
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000017">
					<Properties>
						<string name="Name">UI</string>
						<ProtectedString name="Source"><![CDATA[--[[
	UI – celé uživatelské rozhraní hry, postavené kódem.
	HUD (mince, batoh, postup pouště), menu vlevo a okna:
	Shop, Store (Robux), Rebirth, Index (artefakty), Codes.

	Design se počítá pro rozlišení 1280x720 a automaticky se škáluje (UIScale),
	takže funguje na PC, tabletu i mobilu.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local Effects = require(script.Parent.Effects)

local UI = {}

local player = Players.LocalPlayer
local state = nil

local THEME = {
	Panel = Color3.fromRGB(255, 243, 220),
	PanelDark = Color3.fromRGB(242, 222, 186),
	Border = Color3.fromRGB(90, 55, 28),
	Text = Color3.fromRGB(85, 52, 25),
	SubText = Color3.fromRGB(130, 95, 60),
	White = Color3.new(1, 1, 1),
	Orange = Color3.fromRGB(255, 150, 40),
	Green = Color3.fromRGB(80, 195, 85),
	Blue = Color3.fromRGB(60, 150, 255),
	Purple = Color3.fromRGB(165, 85, 255),
	Cyan = Color3.fromRGB(60, 200, 230),
	Red = Color3.fromRGB(235, 70, 70),
	Gold = Color3.fromRGB(255, 200, 50),
	Gray = Color3.fromRGB(150, 140, 130),
	Sand = Color3.fromRGB(240, 200, 120),
	Dark = Color3.fromRGB(70, 45, 25),
}

local KIND_COLORS = {
	info = THEME.Dark,
	success = THEME.Green,
	error = THEME.Red,
	full = THEME.Red,
	epic = THEME.Purple,
	storm = THEME.Orange,
}

local gui: ScreenGui
local windows = {}
local openName: string? = nil
local refreshers = {}
local prices = {}

-- HUD prvky
local hud = {}

---------------------------------------------------------------------
-- Pomocníci pro stavbu UI
---------------------------------------------------------------------

local function create(className: string, props, children): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function corner(parent: Instance, radius: number)
	return create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function border(parent: Instance, thickness: number, color: Color3?)
	return create("UIStroke", {
		Thickness = thickness,
		Color = color or THEME.Border,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function text(props): TextLabel
	local strokeThickness = props.Stroke
	props.Stroke = nil
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Font = props.Font or Enum.Font.FredokaOne
	props.TextColor3 = props.TextColor3 or THEME.White
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local label = create("TextLabel", props)
	if strokeThickness ~= false then
		create("UIStroke", {
			Thickness = strokeThickness or 2,
			Color = THEME.Border,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Parent = label,
		})
	end
	return label
end

local function makeButton(props, onClick: () -> ()): TextButton
	props.AutoButtonColor = false
	props.Font = props.Font or Enum.Font.FredokaOne
	props.TextColor3 = props.TextColor3 or THEME.White
	props.TextStrokeColor3 = THEME.Border
	props.TextStrokeTransparency = 0.1
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local button = create("TextButton", props)
	corner(button, 12)
	border(button, 3)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		Parent = button,
	})
	local scale = create("UIScale", { Parent = button })
	local quick = TweenInfo.new(0.08)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, quick, { Scale = 0.92 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, quick, { Scale = 1 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, quick, { Scale = 1 }):Play()
	end)
	button.Activated:Connect(function()
		Effects.playSound("Click", 0.25, 1.4)
		onClick()
	end)
	return button
end

local function makeBar(parent: Instance, position: UDim2, size: UDim2, color: Color3)
	local background = create("Frame", {
		Position = position,
		Size = size,
		BackgroundColor3 = Color3.fromRGB(70, 45, 25),
		Parent = parent,
	})
	corner(background, 10)
	border(background, 3)
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color,
		Parent = background,
	})
	corner(fill, 10)
	create("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200)),
		Rotation = 90,
		Parent = fill,
	})
	local label = text({
		Size = UDim2.new(1, -12, 1, -6),
		Position = UDim2.fromOffset(6, 3),
		Text = "",
		ZIndex = 3,
		Parent = background,
	})
	return background, fill, label
end

local function makeScroll(parent: Instance, position: UDim2, size: UDim2): ScrollingFrame
	local scroll = create("ScrollingFrame", {
		Position = position,
		Size = size,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = THEME.Border,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 3),
		PaddingTop = UDim.new(0, 3),
		PaddingRight = UDim.new(0, 14),
		PaddingBottom = UDim.new(0, 6),
		Parent = scroll,
	})
	return scroll
end

local function makeRow(parent: Instance, order: number, icon: string, title: string, description: string): Frame
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 76),
		BackgroundColor3 = THEME.PanelDark,
		LayoutOrder = order,
		Parent = parent,
	})
	corner(row, 12)
	border(row, 2)
	text({
		Text = icon,
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.fromOffset(10, 10),
		Stroke = false,
		Parent = row,
	})
	text({
		Text = title,
		Size = UDim2.new(1, -270, 0, 32),
		Position = UDim2.fromOffset(76, 7),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Text,
		Stroke = false,
		Parent = row,
	})
	text({
		Text = description,
		Size = UDim2.new(1, -270, 0, 28),
		Position = UDim2.fromOffset(76, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.SubText,
		Font = Enum.Font.GothamMedium,
		Stroke = false,
		Parent = row,
	})
	return row
end

local function rowButton(row: Frame, onClick: () -> ()): TextButton
	return makeButton({
		Text = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(170, 52),
		BackgroundColor3 = THEME.Green,
		Parent = row,
	}, onClick)
end

local function sectionHeader(parent: Instance, order: number, title: string)
	text({
		Text = title,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = order,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Text,
		Stroke = false,
		Parent = parent,
	})
end

local function formatMultiplier(value: number): string
	local textValue = string.format("%.2f", value)
	textValue = textValue:gsub("0+$", ""):gsub("%.$", "")
	return "x" .. textValue
end

---------------------------------------------------------------------
-- Okna
---------------------------------------------------------------------

local function newWindow(name: string, title: string, color: Color3, size: Vector2?): Frame
	local windowSize = size or Vector2.new(700, 470)
	local frame = create("Frame", {
		Name = name .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 12),
		Size = UDim2.fromOffset(windowSize.X, windowSize.Y),
		BackgroundColor3 = THEME.Panel,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	corner(frame, 18)
	border(frame, 4)
	local scale = create("UIScale", { Parent = frame })

	local header = create("Frame", {
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = color,
		Parent = frame,
	})
	corner(header, 18)
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = header,
	})
	text({
		Text = title,
		Size = UDim2.new(1, -120, 1, -14),
		Position = UDim2.fromOffset(20, 7),
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 3,
		ZIndex = 2,
		Parent = header,
	})
	makeButton({
		Text = "X",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = THEME.Red,
		ZIndex = 2,
		Parent = header,
	}, function()
		UI.close()
	end)

	local content = create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 70),
		Size = UDim2.new(1, -32, 1, -84),
		Parent = frame,
	})
	windows[name] = { Frame = frame, Scale = scale }
	return content
end

function UI.close()
	if openName and windows[openName] then
		windows[openName].Frame.Visible = false
	end
	openName = nil
end

function UI.open(name: string)
	if openName == name then
		UI.close()
		return
	end
	UI.close()
	local window = windows[name]
	if not window then
		return
	end
	openName = name
	window.Frame.Visible = true
	window.Scale.Scale = 0.85
	TweenService
		:Create(window.Scale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
	if state and refreshers[name] then
		refreshers[name]()
	end
end

---------------------------------------------------------------------
-- Notifikace
---------------------------------------------------------------------

local toastContainer: Frame
local toastCounter = 0

function UI.toast(message: string, kind: string?)
	kind = kind or "info"
	local color = KIND_COLORS.info
	if string.sub(kind :: string, 1, 7) == "rarity:" then
		local rarity = Config.Rarities[string.sub(kind :: string, 8)]
		color = if rarity then rarity.Color else THEME.Gold
	elseif KIND_COLORS[kind :: string] then
		color = KIND_COLORS[kind :: string]
	end

	toastCounter += 1
	local toast = create("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = color,
		LayoutOrder = toastCounter,
		Parent = toastContainer,
	})
	corner(toast, 12)
	border(toast, 3)
	local scale = create("UIScale", { Scale = 0.5, Parent = toast })
	text({
		Text = message,
		Size = UDim2.new(1, -24, 1, -10),
		Position = UDim2.fromOffset(12, 5),
		Stroke = 2,
		Parent = toast,
	})
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()

	-- max 4 notifikace najednou
	local toasts = {}
	for _, child in toastContainer:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #toasts - 4 do
			toasts[i]:Destroy()
		end
	end

	task.delay(4, function()
		if toast.Parent then
			local tween = TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 })
			tween:Play()
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
end

-- Velký nápis uprostřed obrazovky (např. po prodeji)
function UI.bigPopup(message: string, color: Color3)
	local label = text({
		Text = message,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(520, 80),
		TextColor3 = color,
		Stroke = 4,
		ZIndex = 30,
		Parent = gui,
	})
	local labelStroke = label:FindFirstChildOfClass("UIStroke")
	local scale = create("UIScale", { Scale = 0.4, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
	task.delay(0.8, function()
		local info = TweenInfo.new(0.6)
		TweenService:Create(label, info, { Position = UDim2.fromScale(0.5, 0.35), TextTransparency = 1 }):Play()
		if labelStroke then
			TweenService:Create(labelStroke, info, { Transparency = 1 }):Play()
		end
		task.wait(0.65)
		label:Destroy()
	end)
end

