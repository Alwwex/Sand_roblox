			<Item class="ModuleScript" referent="RBX00000003">
				<Properties>
					<string name="Name">Remotes</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Remotes – komunikace mezi serverem a klientem.
	Server je vytvoří, klient na ně počká.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DEFINITIONS = {
	-- klient -> server
	Dig = "RemoteEvent",
	TeleportCamp = "RemoteEvent",
	BuyItem = "RemoteFunction",
	EquipItem = "RemoteFunction",
	Rebirth = "RemoteFunction",
	RedeemCode = "RemoteFunction",
	GetData = "RemoteFunction",
	-- server -> klient
	DataSync = "RemoteEvent",
	DigResult = "RemoteEvent",
	Notify = "RemoteEvent",
	Sold = "RemoteEvent",
	ChestOpened = "RemoteEvent",
	OpenWindow = "RemoteEvent",
}

local Remotes = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for name, className in DEFINITIONS do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for name in DEFINITIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000004">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Util – drobné pomocné funkce sdílené serverem i klientem.
]]

local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1234 -> "1,234" ; 1520000 -> "1.52M"
function Util.formatNumber(value: number): string
	value = math.floor(value or 0)
	if math.abs(value) < 100000 then
		local text = tostring(value)
		local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		if formatted:sub(1, 1) == "," then
			formatted = formatted:sub(2)
		end
		return (formatted:gsub("^%-,", "-"))
	end
	local index = 1
	local scaled = value
	while math.abs(scaled) >= 1000 and index < #SUFFIXES do
		scaled /= 1000
		index += 1
	end
	local decimals = if math.abs(scaled) >= 100 then 0 elseif math.abs(scaled) >= 10 then 1 else 2
	local text = string.format("%." .. decimals .. "f", scaled)
	if decimals > 0 then
		text = text:gsub("0+$", ""):gsub("%.$", "")
	end
	return text .. SUFFIXES[index]
end

-- 125 -> "2:05"
function Util.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds or 0))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Util.formatPercent(fraction: number): string
	return string.format("%d%%", math.floor((fraction or 0) * 100 + 0.5))
end

return Util
]]></ProtectedString>
